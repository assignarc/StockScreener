{% extends 'base.html.twig' %}

{% block title %}Executive Financial Dashboard — MoonShot Portfolio{% endblock %}

{% block body %}
<div id="app">
    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined">dashboard</span> Executive <span>Dashboard</span>',
        headerBadge: 'Capital Flywheel Command Center'
    } %}
    {% include 'screener/partials/_nav.html.twig' %}


    <!-- FLYWHEEL CONFIGURABLE RISK BANNER -->
    <div class="fw-banner" id="riskBanner">
        <div style="display:flex;align-items:center;gap:10px">
            <span class="material-symbols-outlined" style="font-size:24px; color:var(--blue);">settings</span>
            <div>
                <div style="font-weight:700;font-size:13px;color:var(--text)">Flywheel Monthly Risk Guardrail: <span id="fwRiskCapText" style="color:var(--blue);cursor:pointer;font-weight:800;" onclick="changeRiskConfig()" title="Click to adjust monthly risk cap">$10,000</span> <span style="font-size:10px;color:var(--muted);">(Click to change)</span></div>
                <div style="font-size:11px;color:var(--muted)">Enforces 100% Covered & Cash-Collateralized Option Trades (Zero Margin Traps)</div>
            </div>
        </div>
        <div class="fw-risk-box">
            <div class="fw-risk-lbl">
                <span>Existing Open Risk: <strong id="fwUsedRiskText" style="color:var(--yellow)">$2,500</strong></span>
                <span>Staged Today: <strong id="fwStagedRiskText" style="color:var(--blue)">$3,800</strong></span>
                <span>Available Remaining: <strong id="fwFreeRiskText" style="color:var(--green)">$3,700</strong></span>
            </div>
            <div class="fw-progress-bg">
                <div id="fwBarUsed" class="fw-bar-used" style="width:25%" title="Existing Open Risk"></div>
                <div id="fwBarStaged" class="fw-bar-staged" style="width:38%" title="Staged Today Risk"></div>
                <div id="fwBarFree" class="fw-bar-free" style="width:37%" title="Available Risk Remaining"></div>
            </div>
        </div>
        <button class="hbtn hbtn-fw" style="padding:6px 14px;font-size:12px; display:inline-flex; align-items:center; justify-content:center;" onclick="openFlywheelPlanner()"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">wb_twilight</span> View Morning Trade Package</button>
    </div>


    <!-- DASHBOARD CONTENT -->
    <div class="dash-container">
        <!-- COMMAND CENTER STAT CARDS WITH DIRECT DRILL-DOWN LINKS -->
        <div class="dash-grid" id="dashStats">
            <a href="/portfolio" class="dash-card clickable" title="Drill down into full Net Liquidation Value & Portfolio Accounts">
                <div>
                    <div class="lbl">Net Liquidation Value</div>
                    <div class="val g">${% if portfolio.netLiquidationValue is defined %}{{ portfolio.netLiquidationValue|number_format(2) }}{% else %}0.00{% endif %}</div>
                </div>
                <div class="drill-link">
                    <span>Portfolio Breakdown</span> <span class="material-symbols-outlined" style="font-size:12px;">arrow_forward</span>
                </div>
            </a>
            <a href="/portfolio" class="dash-card clickable" title="Drill down into Cash Balances & Collateral Breakdown">
                <div>
                    <div class="lbl">Total / Unencumbered Cash</div>
                    <div class="val y">
                        <span style="color:var(--text-muted); font-size:0.8em;">${% if portfolio.cashBalance is defined %}{{ portfolio.cashBalance|number_format(2) }}{% else %}0.00{% endif %}</span> / 
                        <span style="color:var(--neon-green);">${% if portfolio.availableCash is defined %}{{ portfolio.availableCash|number_format(2) }}{% elseif portfolio.cashBalance is defined %}{{ portfolio.cashBalance|number_format(2) }}{% else %}0.00{% endif %}</span>
                    </div>
                </div>
                <div class="drill-link">
                    <span>Cash Liquidity</span> <span class="material-symbols-outlined" style="font-size:12px;">arrow_forward</span>
                </div>
            </a>
            <a href="/portfolio/tax" class="dash-card clickable" title="Drill down into Tax Center & Realized Gains / Loss Netting">
                <div>
                    <div class="lbl">Est. Tax Liability ({{ currentTaxYear|default('2026') }})</div>
                    <div class="val r" style="color:var(--red);">
                        ${% if taxLiability.totalEstimatedTaxLiability is defined %}{{ taxLiability.totalEstimatedTaxLiability|number_format(2) }}{% else %}0.00{% endif %}
                    </div>
                </div>
                <div class="drill-link" style="color:var(--red);">
                    <span>Tax Center & Schedule D</span> <span class="material-symbols-outlined" style="font-size:12px;">arrow_forward</span>
                </div>
            </a>
            <a href="/portfolio" class="dash-card clickable" title="Drill down into Connected Broker Accounts & Position Holdings">
                <div>
                    <div class="lbl">Connected Accounts / Holdings</div>
                    <div class="val" style="color:var(--blue);">
                        {% if portfolio.accounts is defined %}{{ portfolio.accounts|length }}{% else %}0{% endif %} Accounts / 
                        {% if portfolio.aggregatedEquities is defined %}{{ portfolio.aggregatedEquities|length }}{% else %}0{% endif %} Equities
                    </div>
                </div>
                <div class="drill-link">
                    <span>Holdings Matrix</span> <span class="material-symbols-outlined" style="font-size:12px;">arrow_forward</span>
                </div>
            </a>
            <a href="/screener" class="dash-card clickable" title="Drill down into Capital Flywheel Stock Screener & Quantitative Signals">
                <div>
                    <div class="lbl">Tracked Screener Candidates</div>
                    <div class="val" style="color:var(--purple);">{{ totalStocks }} Candidates</div>
                </div>
                <div class="drill-link" style="color:var(--purple);">
                    <span>Stock Screener</span> <span class="material-symbols-outlined" style="font-size:12px;">arrow_forward</span>
                </div>
            </a>
        </div>

        <!-- CAPITAL FLYWHEEL ENGINE ALLOCATOR WIDGET -->
        {% set cashVal = portfolio.cashBalance is defined ? portfolio.cashBalance : 25143.09 %}
        <div class="fw-panel">
            <div>
                <div class="fw-title">
                    <span class="fw-icon"><span class="material-symbols-outlined">settings</span> CAPITAL FLYWHEEL ALLOCATOR</span>
                    <span>Live Cash Allocation (${{ cashVal|number_format(0) }})</span>
                </div>
                <div style="font-size:12px; color:var(--muted); margin-top:4px;">
                    Allocating your available Schwab cash into Option Level 1 Basic Covered strategies.
                </div>
            </div>
            <div class="fw-stats">
                <a href="/planner" style="text-decoration:none;" title="Drill down to Daily Trade Package">
                    <div class="fw-pill fw-pill-call" style="cursor:pointer;">
                        <span><span class="material-symbols-outlined" style="font-size:14px; margin-right:2px;">arrow_circle_up</span> CALLs (60%):</span>
                        <span>${{ (cashVal * 0.60)|number_format(0) }}</span>
                    </div>
                </a>
                <a href="/screener" style="text-decoration:none;" title="Drill down to Cash-Secured Wheel Screener">
                    <div class="fw-pill fw-pill-wheel" style="cursor:pointer;">
                        <span><span class="material-symbols-outlined" style="font-size:14px; margin-right:2px;">autorenew</span> WHEEL (25%):</span>
                        <span>${{ (cashVal * 0.25)|number_format(0) }}</span>
                    </div>
                </a>
                <a href="/discover" style="text-decoration:none;" title="Drill down to AI Put Hedges & Market Discoveries">
                    <div class="fw-pill fw-pill-put" style="cursor:pointer;">
                        <span><span class="material-symbols-outlined" style="font-size:14px; margin-right:2px;">arrow_circle_down</span> PUTs (15%):</span>
                        <span>${{ (cashVal * 0.15)|number_format(0) }}</span>
                    </div>
                </a>
            </div>
        </div>

        <!-- PORTFOLIO COVERED CALL TRADE ASSISTANT PLAYBOOK (COLLAPSIBLE ACCORDION WITH RATIONALE) -->
        <details class="dash-widget-green" id="dashSuggestions" open style="border:1px solid rgba(0,230,118,0.3); border-radius:12px; padding:16px; margin-bottom:20px;">
            <summary style="cursor:pointer; list-style:none; outline:none;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                    <div>
                        <h3 style="font-family:'Outfit',sans-serif; font-size:16px; margin:0 0 4px 0; color:var(--green); display:flex; align-items:center; gap:8px;">
                            <span class="material-symbols-outlined">auto_awesome</span> Actionable Covered Call Trades
                            <span class="hbadge" style="background:rgba(21,128,61,0.15); color:var(--green); border-color:rgba(21,128,61,0.3);">Rationale: Unencumbered 100-Share Blocks Scanned</span>
                        </h3>
                        <div style="font-size:12px; color:var(--muted);">
                            Executing these suggested Covered Calls generates <strong class="g" id="playbookTotalIncome">+$2,482.00 Instant Cash Premium Income</strong>!
                        </div>
                    </div>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <span style="font-size:11px; color:var(--text-muted);">Click header to collapse/expand</span>
                        <a href="/portfolio" class="hbtn hbtn-green" onclick="event.stopPropagation();" title="Drill down into full portfolio positions & orders"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">work</span> Portfolio & Accounts →</a>
                    </div>
                </div>
            </summary>

            <div id="coveredCallTradeCards" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px; margin-top:16px;">
                <div style="grid-column:1/-1;">
                    <div class="ui-loading-box">
                        <span class="material-symbols-outlined spinner-icon">progress_activity</span>
                        <span>Scanning unencumbered stock positions for Covered Calls...</span>
                    </div>
                </div>
            </div>
            
            <div id="coveredCallToggleContainer" style="display:none; text-align:center; margin-top:16px; padding-top:12px; border-top:1px dashed rgba(0,230,118,0.2);">
                <button type="button" id="btnToggleCoveredCalls" class="hbtn hbtn-green" style="font-size:12px; padding:6px 18px; display:inline-flex; align-items:center; gap:6px;" onclick="toggleCoveredCallsVisibility()">
                    <span class="material-symbols-outlined" id="toggleCoveredCallsIcon" style="font-size:16px;">expand_more</span>
                    <span id="toggleCoveredCallsText">Show More Actionable Trades</span>
                </button>
            </div>
        </details>


        <!-- GEMINI AI PORTFOLIO ASSISTANT WIDGET -->
        <div class="dash-widget-purple" id="dashAiIdeas" style="margin-bottom:24px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:14px;">
                <div>
                    <h3 style="font-family:'Outfit',sans-serif; font-size:16px; margin:0 0 4px 0; color:var(--purple); display:flex; align-items:center; gap:8px;">
                        <span><span class="material-symbols-outlined">smart_toy</span> Gemini AI Capital Flywheel Assistant</span>
                        <span class="hbadge" id="geminiSourceBadge">Google Gemini 1.5 Flash</span>
                    </h3>
                    <div style="font-size:12px; color:var(--muted);">
                        AI-driven options trade analysis evaluating your ${% if portfolio.cashBalance is defined %}{{ portfolio.cashBalance|number_format(2) }}{% else %}0.00{% endif %} total / ${% if portfolio.availableCash is defined %}{{ portfolio.availableCash|number_format(2) }}{% elseif portfolio.cashBalance is defined %}{{ portfolio.cashBalance|number_format(2) }}{% else %}0.00{% endif %} unencumbered cash reserves, unencumbered stocks, and market volatility.
                    </div>
                </div>
                <div style="display:flex; gap:10px; align-items:center;">
                    <a href="/discover" class="hbtn" style="background:var(--bg3); border:1px solid var(--border); color:var(--purple); font-size:12px; display:inline-flex; align-items:center; gap:4px;" title="Drill down into full AI Market Ideas & Discoveries">
                        <span class="material-symbols-outlined" style="font-size:14px;">explore</span> View Discover Hub →
                    </a>
                    <button class="hbtn hbtn-purple" onclick="loadGeminiAiIdeas(true)">
                        <span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">auto_awesome</span> Refresh AI Analysis
                    </button>
                </div>
            </div>

            <div id="geminiAiCardsGrid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:14px;">
                <div style="grid-column:1/-1;">
                    <div class="ui-loading-box">
                        <span class="material-symbols-outlined spinner-icon">progress_activity</span>
                        <span>Querying Gemini AI for portfolio trade ideas...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2-COLUMN SIDE-BY-SIDE: CASH & COLLATERAL STATUS + TOP PORTFOLIO HOLDINGS -->
        <div class="dash-2col">

            <!-- 1. ACCOUNT-LEVEL CASH & COLLATERAL STATUS -->
            <div style="background:var(--bg2); border:1px solid var(--border); border-radius:12px; padding:20px; display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:14px;">
                        <h4 style="font-size:13px; color:var(--text); font-weight:700; text-transform:uppercase; letter-spacing:.5px; margin:0; display:flex; align-items:center; gap:6px;">
                            <span class="material-symbols-outlined" style="font-size:18px; color:var(--blue);">account_balance</span> Account-Level Cash & Collateral Status
                        </h4>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <a href="/portfolio" class="hbtn" style="background:var(--bg3); font-size:11px; padding:5px 12px; display:inline-flex; align-items:center; gap:4px; color:var(--text);" title="Drill down into Portfolio Accounts">
                                <span class="material-symbols-outlined" style="font-size:14px; color:var(--blue);">work</span> All Accounts
                            </a>
                            <a href="/portfolio/tax" class="hbtn" style="background:var(--bg3); font-size:11px; padding:5px 12px; display:inline-flex; align-items:center; gap:4px; color:var(--text);" title="Drill down into Tax Center">
                                <span class="material-symbols-outlined" style="font-size:14px; color:var(--yellow);">account_balance_wallet</span> Tax Center
                            </a>
                        </div>
                    </div>
                    <div style="border:1px solid var(--border); border-radius:8px; overflow-x:auto;">
                        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:12.5px;">
                            <thead>
                                <tr style="background:var(--bg3); border-bottom:1px solid var(--border);">
                                    <th style="padding:10px;">Account Nickname</th>
                                    <th style="text-align:right; padding:10px;">Net Liq</th>
                                    <th style="text-align:right; padding:10px;">Idle Cash</th>
                                    <th style="text-align:right; padding:10px;">Positions</th>
                                    <th style="text-align:right; padding:10px;">Status</th>
                                    <th style="text-align:center; padding:10px;">Drill Down</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if portfolio.accounts is defined and portfolio.accounts|length > 0 %}
                                    {% for acc in portfolio.accounts %}
                                         {% set isRetire = (acc.nickname|default('') ~ ' ' ~ acc.type|default(''))|upper matches '/(IRA|ROTH|SEP|PCRA|401K)/' %}
                                         {% set accIdStr = acc.id|default(acc.accountNumber|default(loop.index)) %}
                                         <tr style="border-bottom:1px solid var(--border);">
                                             <td style="padding:10px;">
                                                 <a href="/portfolio?tab=holdings&account={{ accIdStr }}#account_card_{{ accIdStr }}" style="color:var(--text); text-decoration:none; font-weight:700;" class="hover-blue" title="Drill down to this account in Portfolio">
                                                     {{ acc.nickname|default('Account') }}
                                                 </a>
                                                 <div style="font-size:10px; color:var(--muted);">
                                                     {{ acc.accountNumber ?? acc.id ?? 'N/A' }} ({{ (acc.type|default('N/A'))|upper }})
                                                 </div>
                                             </td>
                                             <td style="text-align:right; padding:10px;">${{ (acc.liquidationValue|default(0))|number_format(2) }}</td>
                                             <td style="text-align:right; padding:10px;"><strong class="g">${{ (acc.cashAvailable|default(0))|number_format(2) }}</strong></td>
                                             <td style="text-align:right; padding:10px;">
                                                 <a href="/portfolio?tab=holdings&account={{ accIdStr }}#account_card_{{ accIdStr }}" style="color:var(--blue); text-decoration:underline; font-weight:600;" title="View positions in Portfolio">
                                                     {{ acc.positionsCount|default(0) }}
                                                 </a>
                                             </td>
                                             <td style="text-align:right; padding:10px;">
                                                 {% if acc.authorized|default(false) %}
                                                     <span class="badge bg-green"><span class="material-symbols-outlined" style="font-size:12px;vertical-align:middle;">check_circle</span> ACTIVE</span>
                                                 {% else %}
                                                     <span class="badge bg-red"><span class="material-symbols-outlined" style="font-size:12px;vertical-align:middle;">error</span> {{ acc.status|default('UNAUTHORIZED') }}</span>
                                                 {% endif %}
                                             </td>
                                             <td style="text-align:center; padding:10px;">
                                                 <div style="display:inline-flex; gap:4px; align-items:center;">
                                                     <a href="/portfolio?tab=holdings&account={{ accIdStr }}#account_card_{{ accIdStr }}" class="slick-pill-btn" style="font-size:11px; padding:3px 7px;" title="Drill down to Portfolio Holdings for this account">
                                                         <span class="material-symbols-outlined" style="font-size:13px;">visibility</span> Holdings
                                                     </a>
                                                     {% if not isRetire %}
                                                         <a href="/portfolio/tax?account={{ acc.nickname|default(acc.accountNumber) }}" class="slick-pill-btn" style="font-size:11px; padding:3px 7px;" title="Drill down to Tax Center for this account">
                                                             <span class="material-symbols-outlined" style="font-size:13px; color:var(--yellow);">receipt_long</span> Tax
                                                         </a>
                                                     {% else %}
                                                         <span class="hbadge" style="font-size:9px; background:rgba(168,85,247,0.1); color:var(--purple); border-color:rgba(168,85,247,0.3);" title="Tax Exempt / Deferred IRA">
                                                             IRA
                                                         </span>
                                                     {% endif %}
                                                 </div>
                                             </td>
                                         </tr>
                                     {% endfor %}
                                {% else %}
                                    <tr><td colspan="6" style="text-align:center; padding:20px;" class="m">No connected accounts.</td></tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 2. TOP PORTFOLIO HOLDINGS OVERVIEW TABLE -->
            <div style="background:var(--bg2); border:1px solid var(--border); border-radius:12px; padding:20px; display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:14px;">
                        <h4 style="font-size:13px; color:var(--text); font-weight:700; text-transform:uppercase; letter-spacing:.5px; margin:0; display:flex; align-items:center; gap:6px;">
                            <span class="material-symbols-outlined" style="font-size:18px; color:var(--green);">trending_up</span> Top Portfolio Holdings (Live Brokerage Accounts)
                        </h4>
                        <a href="/portfolio?tab=holdings&view=security" class="hbtn" style="background:var(--bg3); border:1px solid var(--border); color:var(--blue); font-size:11px; padding:5px 12px; display:inline-flex; align-items:center; gap:4px;" title="Drill down to all active portfolio holdings aggregated">
                            <span>All Positions</span> <span class="material-symbols-outlined" style="font-size:14px;">arrow_forward</span>
                        </a>
                    </div>
                    <div style="border:1px solid var(--border); border-radius:8px; overflow-x:auto;">
                        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:12.5px;">
                            <thead>
                                <tr style="background:var(--bg3); border-bottom:1px solid var(--border);">
                                    <th style="padding:10px;">Ticker</th>
                                    <th style="padding:10px;">Asset Class</th>
                                    <th style="text-align:right; padding:10px;">Shares</th>
                                    <th style="text-align:right; padding:10px;">Avg Cost</th>
                                    <th style="text-align:right; padding:10px;">Market Value</th>
                                    <th style="text-align:right; padding:10px;">Unrealized P/L</th>
                                    <th style="text-align:right; padding:10px;">Weight</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if portfolio.aggregatedEquities is defined and portfolio.aggregatedEquities|length > 0 %}
                                    {% for e in portfolio.aggregatedEquities|slice(0, 5) %}
                                        <tr style="border-bottom:1px solid var(--border);">
                                            <td style="padding:10px;">
                                                <div style="display:flex; align-items:center; gap:6px;">
                                                    <a href="/portfolio?tab=holdings&symbol={{ e.symbol }}" style="color:var(--text); text-decoration:none; font-weight:700;" class="hover-blue" title="Drill down to {{ e.symbol }} in Portfolio Holdings">
                                                        {{ e.symbol }}
                                                    </a>
                                                    <a href="/screener?symbol={{ e.symbol }}" style="color:var(--blue); font-size:11px; display:inline-flex; align-items:center;" title="Inspect in Screener">
                                                        <span class="material-symbols-outlined" style="font-size:13px;">bolt</span>
                                                    </a>
                                                </div>
                                            </td>
                                            <td style="padding:10px;"><span class="m">{{ e.assetType }}</span></td>
                                            <td style="text-align:right; padding:10px;">{{ e.quantity }}</td>
                                            <td style="text-align:right; padding:10px;">${{ e.averagePrice|number_format(2) }}</td>
                                            <td style="text-align:right; padding:10px;"><strong>${{ e.marketValue|number_format(2) }}</strong></td>
                                            <td style="text-align:right; padding:10px;" class="{% if e.unrealizedPL >= 0 %}g{% else %}r{% endif %}">
                                                <strong>{% if e.unrealizedPL >= 0 %}+{% endif %}${{ e.unrealizedPL|number_format(2) }} ({{ e.unrealizedPLPct }}%)</strong>
                                            </td>
                                            <td style="text-align:right; padding:10px;"><strong style="color:var(--purple);">{{ e.allocationPct }}%</strong></td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr><td colspan="7" style="text-align:center; padding:20px;" class="m">No active positions.</td></tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{% include 'screener/partials/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/dashboard.js') }}"></script>
{% endblock %}
