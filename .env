# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=29a5785caed2c35176b39e87b012b193
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> finnhub/api-key ###
FINNHUB_API_KEY="YOUR_FINNHUB_API_KEY"
###< finnhub/api-key ###

###> schwab/developer-api ###
SCHWAB_APP_KEY="YOUR_SCHWAB_APP_KEY"
SCHWAB_APP_SECRET="YOUR_SCHWAB_APP_SECRET"
SCHWAB_REDIRECT_URI="https://127.0.0.1:8000/api/schwab/callback"
# STRICT SECURITY GUARDRAIL: Must be set to "true" to allow placing trades or mutating account state.
# Default (false) enforces strict READ-ONLY mode.
SCHWAB_TRADING_ENABLED=false
###< schwab/developer-api ###

###> google/gemini-api ###
# Google Gemini Developer API Settings (https://aistudio.google.com/)
# Models: gemini-1.5-flash (default), gemini-2.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models"
GEMINI_API_KEY=""
###< google/gemini-api ###
