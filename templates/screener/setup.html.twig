{% extends 'base.html.twig' %}

{% block title %}Initial Setup Wizard | MoonShot Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/setup.css') }}">
{% endblock %}

{% block body %}
<div class="setup-wrap">

    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined" style="vertical-align:middle; font-size:22px; color:var(--blue);">rocket_launch</span> Initial <span>Setup Wizard</span>',
        headerBadge: 'First-Run Zero-Config Onboarding'
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <!-- Hero -->
    <div class="setup-hero">
        <div class="setup-hero-inner">
            <div style="display:inline-flex; align-items:center; gap:8px; background:var(--bg3); padding:4px 14px; border-radius:20px; border:1px solid var(--border); margin-bottom:10px;">
                <span class="material-symbols-outlined" style="color:var(--blue); font-size:16px;">bolt</span>
                <span style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:1px;">First-Run Configuration Wizard</span>
            </div>
            <h1>Welcome to MoonShot Portfolio</h1>
            <p>Your zero-configuration, self-healing options screener and capital flywheel system. Complete these quick steps to connect your market data and broker integrations.</p>
        </div>
    </div>

    <!-- Main Container -->
    <div class="setup-container">

        <!-- Stepper Indicator -->
        <div class="setup-stepper-card">
            <div class="wiz-step-btn active" id="stepIndicator1" onclick="showWizardStep(1)">
                <div class="step-num">1</div>
                <div class="step-lbl">Database JIT</div>
            </div>
            <div class="step-line"></div>
            <div class="wiz-step-btn" id="stepIndicator2" onclick="showWizardStep(2)">
                <div class="step-num">2</div>
                <div class="step-lbl">Finnhub API</div>
            </div>
            <div class="step-line"></div>
            <div class="wiz-step-btn" id="stepIndicator3" onclick="showWizardStep(3)">
                <div class="step-num">3</div>
                <div class="step-lbl">Broker Selection</div>
            </div>
            <div class="step-line"></div>
            <div class="wiz-step-btn" id="stepIndicator4" onclick="showWizardStep(4)">
                <div class="step-num">4</div>
                <div class="step-lbl">AI Intelligence</div>
            </div>
            <div class="step-line"></div>
            <div class="wiz-step-btn" id="stepIndicator5" onclick="showWizardStep(5)">
                <div class="step-num">5</div>
                <div class="step-lbl">Launch</div>
            </div>
        </div>

        <!-- WIZARD STEP 1: JUST-IN-TIME DATABASE -->
        <div class="wiz-panel active" id="wizStep1">
            <div class="card" style="padding:28px; border-radius:16px;">
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
                    <div style="background:rgba(63,185,80,0.18); color:var(--green); width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center;">
                        <span class="material-symbols-outlined" style="font-size:22px;">check_circle</span>
                    </div>
                <div>
                    <h2 style="font-size:20px; margin:0 0 4px 0; color:var(--text); font-family:'Outfit',sans-serif;">Step 1: Just-In-Time Database Provisioning</h2>
                    <div style="font-size:12px; color:var(--muted);">All SQLite schema tables and seed parameters are automatically ready in <code>var/data.db</code>.</div>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:14px; margin-bottom:24px;">
                <div style="background:var(--bg3); padding:14px; border-radius:10px; border:1px solid var(--border);">
                    <div style="font-size:11px; color:var(--muted); text-transform:uppercase; font-weight:700;">Database Engine</div>
                    <div style="font-size:16px; font-weight:800; color:var(--green); margin-top:4px;">SQLite JIT Active</div>
                    <div style="font-size:11px; color:var(--muted); margin-top:2px;">var/data.db ({{ schemaStatus.databaseSizeKb|default(0) }} KB)</div>
                </div>
                <div style="background:var(--bg3); padding:14px; border-radius:10px; border:1px solid var(--border);">
                    <div style="font-size:11px; color:var(--muted); text-transform:uppercase; font-weight:700;">Config Table</div>
                    <div style="font-size:16px; font-weight:800; color:var(--blue); margin-top:4px;">{{ schemaStatus.tables.app_config|default(0) }} Parameters Seeded</div>
                    <div style="font-size:11px; color:var(--muted); margin-top:2px;">Zero code hardcoding</div>
                </div>
                <div style="background:var(--bg3); padding:14px; border-radius:10px; border:1px solid var(--border);">
                    <div style="font-size:11px; color:var(--muted); text-transform:uppercase; font-weight:700;">Screener Watchlist</div>
                    <div style="font-size:16px; font-weight:800; color:var(--purple); margin-top:4px;">{{ schemaStatus.tables.stock|default(0) }} Core Tickers</div>
                    <div style="font-size:11px; color:var(--muted); margin-top:2px;">NVDA, AAPL, MSFT, etc.</div>
                </div>
            </div>

            <div style="display:flex; justify-content:flex-end;">
                <button type="button" class="hbtn hbtn-blue" style="padding:10px 24px; font-size:13px;" onclick="showWizardStep(2)">
                    Continue to Finnhub Setup →
                </button>
            </div>
        </div>
    </div>

    <!-- WIZARD STEP 2: FINNHUB API KEY -->
    <div class="wiz-panel" id="wizStep2" style="display:none;">
        <div class="card" style="padding:28px; border-radius:16px;">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
                <div style="background:rgba(2,132,199,0.18); color:var(--blue); width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:22px;">trending_up</span>
                </div>
                <div style="flex:1;">
                    <h2 style="font-size:20px; margin:0 0 4px 0; color:var(--text); font-family:'Outfit',sans-serif;">Step 2: Connect Finnhub Market Data API</h2>
                    <div style="font-size:12px; color:var(--muted);">Finnhub powers real-time stock prices, dividend calendars, and company earnings dates.</div>
                </div>
                <a href="/help" target="_blank" class="hbtn hbtn-blue" style="font-size:12px; padding:6px 14px; text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-weight:700;">
                    <span class="material-symbols-outlined">help_center</span> View Key Guide
                </a>
            </div>

            <!-- Instructions Box -->
            <div style="background:rgba(2,132,199,0.08); border:1px solid rgba(2,132,199,0.25); border-radius:12px; padding:18px; margin-bottom:24px;">
                <h4 style="margin:0 0 8px 0; font-size:13px; color:var(--blue); font-weight:700;">How to get a Free Finnhub API Key:</h4>
                <ol style="margin:0; padding-left:20px; font-size:12px; color:var(--text); line-height:1.7;">
                    <li>Open the free registration page at <a href="https://finnhub.io/register" target="_blank" style="color:var(--blue); font-weight:700; text-decoration:underline;">https://finnhub.io/register</a>.</li>
                    <li>Sign up with your email (no credit card required).</li>
                    <li>Copy your <strong>API Key Token</strong> from the Finnhub dashboard.</li>
                    <li>Paste your key below and click <strong>Test Finnhub Key</strong> to verify live connectivity.</li>
                </ol>
            </div>

            <div style="margin-bottom:24px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px;">
                        Finnhub API Key Token
                    </label>
                    <div style="display:flex; gap:6px;">
                        <button type="button" class="slick-pill-btn" onclick="pasteToField('wizFinnhubKey')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                        <button type="button" class="slick-pill-btn" onclick="copyFromField('wizFinnhubKey', this)"><span class="material-symbols-outlined">content_copy</span> Copy</button>
                        <button type="button" class="slick-pill-btn" onclick="clearField('wizFinnhubKey')"><span class="material-symbols-outlined">cancel</span> Clear</button>
                    </div>
                </div>
                <div class="key-field-wrap">
                    <input type="text" id="wizFinnhubKey" class="large-key-input" placeholder="Paste your Finnhub token here (e.g. c123456789abcdef...)" value="{{ finnhubKey|default('') }}" spellcheck="false">
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px;">
                    <button type="button" class="hbtn hbtn-green" style="padding:8px 18px; font-size:12px; font-weight:700; display:inline-flex; align-items:center; gap:6px;" onclick="testFinnhubKey()">
                        <span class="material-symbols-outlined">bolt</span> Test Finnhub Key Live
                    </button>
                    <div id="finnhubTestResult" style="font-size:12px; font-weight:600;"></div>
                </div>
            </div>

            <div style="display:flex; justify-content:space-between;">
                <button type="button" class="hbtn" style="background:var(--bg3); padding:10px 20px;" onclick="showWizardStep(1)">← Back</button>
                <button type="button" class="hbtn hbtn-blue" style="padding:10px 24px; font-size:13px;" onclick="showWizardStep(3)">
                    Continue to Broker Setup →
                </button>
            </div>
        </div>
    </div>

    <!-- WIZARD STEP 3: DYNAMIC MULTI-BROKER INSTANCES (UP TO 5) -->
    <div class="wiz-panel" id="wizStep3" style="display:none;">
        <div class="card" style="padding:28px; border-radius:16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
                <div style="display:flex; align-items:center; gap:12px; flex:1; min-width:280px;">
                    <div style="background:rgba(188,140,255,0.18); color:var(--purple); width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center;">
                        <span class="material-symbols-outlined" style="font-size:22px;">account_balance</span>
                    </div>
                    <div>
                        <h2 style="font-size:20px; margin:0 0 4px 0; color:var(--text); font-family:'Outfit',sans-serif;">Step 3: Multi-Broker Connections & OAuth Authorization</h2>
                        <div style="font-size:12px; color:var(--muted);">Add up to 5 brokerage connections with short nicknames and direct OAuth 2.0 login integration.</div>
                    </div>
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <a href="/help" target="_blank" class="hbtn hbtn-blue" style="font-size:12px; padding:8px 16px; text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-weight:700;">
                        <span class="material-symbols-outlined">help_center</span> View API Guide
                    </a>
                    <button type="button" class="hbtn hbtn-purple" id="btnAddBrokerInstance" onclick="addBrokerInstanceCard()" style="font-size:12px; padding:8px 16px; font-weight:700; display:inline-flex; align-items:center; gap:6px;">
                        <span class="material-symbols-outlined">add</span> Add Broker Connection (Max 5)
                    </button>
                </div>
            </div>

            <!-- Dynamic Broker Instances Container -->
            <div id="brokerInstancesContainer" style="display:flex; flex-direction:column; gap:20px; margin-bottom:24px;">
                <!-- JavaScript renders cards here dynamically -->
            </div>

            <div style="display:flex; justify-content:space-between;">
                <button type="button" class="hbtn" style="background:var(--bg3); padding:10px 20px;" onclick="showWizardStep(2)">← Back</button>
                <button type="button" class="hbtn hbtn-blue" style="padding:10px 24px; font-size:13px;" onclick="showWizardStep(4)">
                    Continue to AI Setup →
                </button>
            </div>
        </div>
    </div>

    <!-- WIZARD STEP 4: AI STRATEGY ENGINE -->
    <div class="wiz-panel" id="wizStep4" style="display:none;">
        <div class="card" style="padding:28px; border-radius:16px;">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
                <div style="background:rgba(2,132,199,0.15); color:var(--blue); width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:22px;">smart_toy</span>
                </div>
                <div>
                    <h2 style="font-size:20px; margin:0 0 4px 0; color:var(--text); font-family:'Outfit',sans-serif;">Step 4: AI Strategy Engine</h2>
                    <div style="font-size:12px; color:var(--muted);">Provides generative market commentary, flywheel option trade rationales, and risk summaries.</div>
                </div>
            </div>

            <!-- Active Provider Selector -->
            <div style="margin-bottom:24px;">
                <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:8px;">
                    Select Active AI Engine
                </label>
                <select class="styled-select-input" id="wizLlmProvider" onchange="toggleWizLlmProvider()">
                    <option value="gemini" {% if config['llm.provider']|default('gemini') == 'gemini' %}selected{% endif %}>Google Gemini API</option>
                    <option value="openai" {% if config['llm.provider']|default('gemini') == 'openai' %}selected{% endif %}>OpenAI API</option>
                    <option value="claude" {% if config['llm.provider']|default('gemini') == 'claude' %}selected{% endif %}>Anthropic Claude API</option>
                    <option value="local" {% if config['llm.provider']|default('gemini') == 'local' %}selected{% endif %}>Self-Hosted / Local LLM (OpenAI-compatible)</option>
                </select>
            </div>

            <!-- GOOGLE GEMINI PANEL -->
            <div id="wizPanelGemini" class="llm-provider-subpanel" style="display:block;">
                <div style="background:rgba(210,153,34,0.08); border:1px solid rgba(210,153,34,0.25); border-radius:12px; padding:16px; margin-bottom:20px;">
                    <h4 style="margin:0 0 6px 0; font-size:13px; color:var(--yellow); font-weight:700;">Google AI Studio Key:</h4>
                    <p style="margin:0; font-size:12px; color:var(--text); line-height:1.5;">
                        Get a free API key at <a href="https://aistudio.google.com/" target="_blank" style="color:var(--yellow); font-weight:700; text-decoration:underline;">https://aistudio.google.com/</a>.
                    </p>
                </div>
                <div style="margin-bottom:20px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px;">Google Gemini API Key (Optional)</label>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="slick-pill-btn" onclick="pasteToField('wizGeminiKey')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                            <button type="button" class="slick-pill-btn" onclick="clearField('wizGeminiKey')"><span class="material-symbols-outlined">close</span> Clear</button>
                        </div>
                    </div>
                    <input type="password" id="wizGeminiKey" class="large-key-input" placeholder="AIzaSy..." value="{{ config['gemini.api_key']|default('') }}" spellcheck="false">
                </div>
                <div style="margin-bottom:20px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:8px;">Gemini Model Selection</label>
                    <select class="styled-select-input" id="wizGeminiModel">
                        <option value="auto" {% if config['gemini.model']|default('auto') == 'auto' or config['gemini.model']|default('') == '' %}selected{% endif %}>Auto (Latest Pro/Flash & Rate-Limit Fallback)</option>
                        <option value="gemini-2.5-flash" {% if config['gemini.model']|default('') == 'gemini-2.5-flash' %}selected{% endif %}>Gemini 2.5 Flash</option>
                        <option value="gemini-2.5-pro" {% if config['gemini.model']|default('') == 'gemini-2.5-pro' %}selected{% endif %}>Gemini 2.5 Pro</option>
                        <option value="gemini-2.0-flash" {% if config['gemini.model']|default('') == 'gemini-2.0-flash' %}selected{% endif %}>Gemini 2.0 Flash</option>
                        <option value="gemini-1.5-pro" {% if config['gemini.model']|default('') == 'gemini-1.5-pro' %}selected{% endif %}>Gemini 1.5 Pro</option>
                    </select>
                </div>
            </div>

            <!-- OPENAI PANEL -->
            <div id="wizPanelOpenai" class="llm-provider-subpanel" style="display:none;">
                <div style="background:rgba(2,132,199,0.08); border:1px solid rgba(2,132,199,0.25); border-radius:12px; padding:16px; margin-bottom:20px;">
                    <h4 style="margin:0 0 6px 0; font-size:13px; color:var(--blue); font-weight:700;">OpenAI API Key:</h4>
                    <p style="margin:0; font-size:12px; color:var(--text); line-height:1.5;">
                        Get an API key at <a href="https://platform.openai.com/api-keys" target="_blank" style="color:var(--blue); font-weight:700; text-decoration:underline;">https://platform.openai.com/api-keys</a>.
                    </p>
                </div>
                <div style="margin-bottom:20px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px;">OpenAI API Key (Optional)</label>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="slick-pill-btn" onclick="pasteToField('wizOpenaiKey')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                            <button type="button" class="slick-pill-btn" onclick="clearField('wizOpenaiKey')"><span class="material-symbols-outlined">close</span> Clear</button>
                        </div>
                    </div>
                    <input type="password" id="wizOpenaiKey" class="large-key-input" placeholder="sk-proj-..." value="{{ config['openai.api_key']|default('') }}" spellcheck="false">
                </div>
                <div style="margin-bottom:20px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:8px;">OpenAI Model Selection</label>
                    <select class="styled-select-input" id="wizOpenaiModel">
                        <option value="gpt-4o-mini" {% if config['openai.model']|default('gpt-4o-mini') == 'gpt-4o-mini' %}selected{% endif %}>GPT-4o mini (Fast & Affordable)</option>
                        <option value="gpt-4o" {% if config['openai.model']|default('gpt-4o-mini') == 'gpt-4o' %}selected{% endif %}>GPT-4o (Omni High Performance)</option>
                        <option value="gpt-4-turbo" {% if config['openai.model']|default('gpt-4o-mini') == 'gpt-4-turbo' %}selected{% endif %}>GPT-4 Turbo</option>
                        <option value="o1-mini" {% if config['openai.model']|default('gpt-4o-mini') == 'o1-mini' %}selected{% endif %}>o1-mini (Reasoning Model)</option>
                    </select>
                </div>
            </div>

            <!-- CLAUDE PANEL -->
            <div id="wizPanelClaude" class="llm-provider-subpanel" style="display:none;">
                <div style="background:rgba(219,104,74,0.08); border:1px solid rgba(219,104,74,0.25); border-radius:12px; padding:16px; margin-bottom:20px;">
                    <h4 style="margin:0 0 6px 0; font-size:13px; color:var(--orange); font-weight:700;">Anthropic Claude API Key:</h4>
                    <p style="margin:0; font-size:12px; color:var(--text); line-height:1.5;">
                        Get an API key at <a href="https://console.anthropic.com/" target="_blank" style="color:var(--orange); font-weight:700; text-decoration:underline;">https://console.anthropic.com/</a>.
                    </p>
                </div>
                <div style="margin-bottom:20px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px;">Claude API Key (Optional)</label>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="slick-pill-btn" onclick="pasteToField('wizClaudeKey')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                            <button type="button" class="slick-pill-btn" onclick="clearField('wizClaudeKey')"><span class="material-symbols-outlined">close</span> Clear</button>
                        </div>
                    </div>
                    <input type="password" id="wizClaudeKey" class="large-key-input" placeholder="sk-ant-..." value="{{ config['claude.api_key']|default('') }}" spellcheck="false">
                </div>
                <div style="margin-bottom:20px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:8px;">Claude Model Selection</label>
                    <select class="styled-select-input" id="wizClaudeModel">
                        <option value="claude-3-5-sonnet-latest" {% if config['claude.model']|default('claude-3-5-sonnet-latest') == 'claude-3-5-sonnet-latest' %}selected{% endif %}>Claude 3.5 Sonnet (Recommended)</option>
                        <option value="claude-3-5-haiku-latest" {% if config['claude.model']|default('claude-3-5-sonnet-latest') == 'claude-3-5-haiku-latest' %}selected{% endif %}>Claude 3.5 Haiku</option>
                        <option value="claude-3-opus-latest" {% if config['claude.model']|default('claude-3-5-sonnet-latest') == 'claude-3-opus-latest' %}selected{% endif %}>Claude 3 Opus (High Intelligence)</option>
                    </select>
                </div>
            </div>

            <!-- LOCAL PANEL -->
            <div id="wizPanelLocal" class="llm-provider-subpanel" style="display:none;">
                <div style="background:rgba(128,128,128,0.08); border:1px solid rgba(128,128,128,0.25); border-radius:12px; padding:16px; margin-bottom:20px;">
                    <h4 style="margin:0 0 6px 0; font-size:13px; color:var(--muted); font-weight:700;">Self-Hosted / Local OpenAI-compatible API:</h4>
                    <p style="margin:0; font-size:12px; color:var(--text); line-height:1.5;">
                        Configure connection to Ollama, LM Studio, vLLM, or other local providers.
                    </p>
                </div>
                <div style="margin-bottom:20px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:8px;">API Endpoint Base URL</label>
                    <input type="text" id="wizLocalLlmUrl" class="large-key-input" placeholder="http://localhost:11434/v1" value="{{ config['local_llm.url']|default('http://localhost:11434/v1') }}" spellcheck="false">
                </div>
                <div style="margin-bottom:20px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px;">API Key (Optional)</label>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="slick-pill-btn" onclick="pasteToField('wizLocalLlmKey')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                            <button type="button" class="slick-pill-btn" onclick="clearField('wizLocalLlmKey')"><span class="material-symbols-outlined">close</span> Clear</button>
                        </div>
                    </div>
                    <input type="password" id="wizLocalLlmKey" class="large-key-input" placeholder="sk-local-..." value="{{ config['local_llm.api_key']|default('') }}" spellcheck="false">
                </div>
                <div style="margin-bottom:20px;">
                    <label style="font-size:11px; font-weight:700; color:var(--text); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:8px;">Model Name</label>
                    <input type="text" id="wizLocalLlmModel" class="large-key-input" placeholder="llama3" value="{{ config['local_llm.model']|default('local-model') }}" spellcheck="false">
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; margin-top:28px;">
                <button type="button" class="hbtn" style="background:var(--bg3); padding:10px 20px;" onclick="showWizardStep(3)">← Back</button>
                <button type="button" class="hbtn hbtn-blue" style="padding:10px 24px; font-size:13px;" onclick="showWizardStep(5)">
                    Review & Complete Setup →
                </button>
            </div>
        </div>
    </div>

    <!-- WIZARD STEP 5: REVIEW & LAUNCH -->
    <div class="wiz-panel" id="wizStep5" style="display:none;">
        <div class="card" style="padding:32px; border-radius:16px; text-align:center;">
            <div style="width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg, rgba(63,185,80,0.3), rgba(2,132,199,0.3)); color:var(--green); display:flex; align-items:center; justify-content:center; margin:0 auto 16px auto; border:2px solid var(--green);">
                <span class="material-symbols-outlined" style="font-size:32px;">rocket_launch</span>
            </div>
            <h2 style="font-size:24px; font-weight:800; margin:0 0 8px 0; color:var(--text); font-family:'Outfit',sans-serif;">
                You're Ready to Launch!
            </h2>
            <p style="color:var(--muted); font-size:13px; max-width:540px; margin:0 auto 24px auto; line-height:1.6;">
                Your configurations will be saved to your local SQLite <code>var/data.db</code> database. All tables, seed parameters, and persistent cache layers are fully initialized.
            </p>

            <div style="display:inline-flex; flex-direction:column; gap:10px; max-width:400px; width:100%; margin:0 auto 28px auto; text-align:left; background:var(--bg3); border:1px solid var(--border); padding:16px; border-radius:12px;">
                <div style="display:flex; justify-content:space-between; font-size:12px;">
                    <span style="color:var(--muted);">Database Engine:</span>
                    <strong style="color:var(--green);">SQLite data.db (JIT Seeded)</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:12px;">
                    <span style="color:var(--muted);">Primary Broker:</span>
                    <strong style="color:var(--purple);" id="reviewBroker">Charles Schwab</strong>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:12px;">
                    <span style="color:var(--muted);">Persistent Caching:</span>
                    <strong style="color:var(--blue);">Active (Sanitized Non-PII)</strong>
                </div>
            </div>

            <div style="display:flex; justify-content:center; gap:12px;">
                <button type="button" class="hbtn" style="background:var(--bg3); padding:10px 24px;" onclick="showWizardStep(4)">← Back</button>
                <button type="button" class="hbtn hbtn-green" id="btnSaveAndLaunch" style="padding:12px 32px; font-size:14px; font-weight:800; display:inline-flex; align-items:center; gap:8px;" onclick="completeSetupAndLaunch()">
                    <span class="material-symbols-outlined">save</span> Save Configurations & Launch Portfolio →
                </button>
            </div>
            <div id="saveLaunchMsg" style="margin-top:14px; font-size:13px; font-weight:700;"></div>
        </div>
    </div>

        {% include 'screener/partials/_legal_disclaimer.html.twig' %}
    </div><!-- /setup-container -->

    {% include 'screener/partials/_footer.html.twig' %}
</div><!-- /setup-wrap -->
{% endblock %}

{% block javascripts %}
<script>
    window.initialBrokerInstances = {{ brokerInstances|json_encode|raw }};
</script>
<script src="{{ asset('js/setup.js') }}"></script>
{% endblock %}
