{% extends 'base.html.twig' %}

{% block title %}Brokerage Portfolio & Accounts — MoonShot Portfolio{% endblock %}

{% block body %}
<div id="app">
    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined">work</span> Brokerage <span>Portfolio</span>',
        headerBadge: 'Live Brokerage API'
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <!-- PAGE 2 CONTENT: PORTFOLIO DETAILS -->
    <div class="port-container">
        <!-- EXECUTIVE ADVISOR INTELLIGENCE NUGGETS BANNER -->
        <div class="advisor-nuggets-container" id="advisorNuggetsSection">
            <div class="advisor-nuggets-header">
                <div class="advisor-title">
                    <span class="material-symbols-outlined" style="color:var(--purple); font-size:22px;">psychology</span>
                    <span>Executive Advisor Insights & Daily Golden Nuggets</span>
                </div>
                <button type="button" class="hbtn" style="font-size:11px; padding:4px 10px;" onclick="loadAdvisorInsights()">
                    <span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">refresh</span> Refresh Insights
                </button>
            </div>
            <div class="advisor-grid" id="advisorNuggetsGrid">
                <!-- Dynamically populated via API -->
                <div style="grid-column: 1 / -1; color:var(--muted); font-size:12px; display:flex; align-items:center; gap:8px;">
                    <span class="material-symbols-outlined" style="font-size:16px;">sync</span> Analyzing portfolio holdings for tax savings, yield enhancement, and growth...
                </div>
            </div>
        </div>

        {% if portfolio.is_stale is defined and portfolio.is_stale %}
            <!-- OFFLINE / CACHED SNAPSHOT RESILIENCE BANNER -->
            <div style="background:rgba(210,153,34,0.12); border:1px solid rgba(210,153,34,0.35); border-radius:12px; padding:12px 18px; margin-bottom:16px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <span class="material-symbols-outlined" style="color:var(--yellow); font-size:22px;">cloud_off</span>
                    <div>
                        <strong style="color:var(--yellow); font-size:13px;">Broker Disconnected — Showing Last Saved Portfolio State</strong>
                        <div style="color:var(--text); font-size:11px; margin-top:2px;">
                            Your portfolio balances, positions, and option allocations are preserved from the last successful synchronization on <strong style="color:var(--yellow);">{{ portfolio.last_refreshed|default('recent snapshot') }}</strong>.
                        </div>
                    </div>
                </div>
                <a href="/settings" class="hbtn" style="background:var(--bg2); border:1px solid var(--yellow); color:var(--yellow); font-size:11px; padding:5px 12px;">
                    <span class="material-symbols-outlined" style="font-size:14px;">link</span> Reconnect Broker in Settings
                </a>
            </div>
        {% endif %}

        <!-- PORTFOLIO SUMMARY CARDS -->
        <div class="port-summary">
            <div class="port-card">
                <div class="lbl">Net Liquidation Value</div>
                <div class="val g">${% if portfolio.netLiquidationValue is defined %}{{ portfolio.netLiquidationValue|number_format(2) }}{% else %}0.00{% endif %}</div>
            </div>
            <div class="port-card">
                <div class="lbl">Total Cash Balance</div>
                <div class="val y">${% if portfolio.cashBalance is defined %}{{ portfolio.cashBalance|number_format(2) }}{% else %}0.00{% endif %}</div>
            </div>
            <div class="port-card">
                <div class="lbl">Unencumbered Cash (Available)</div>
                <div class="val g">${% if portfolio.availableCash is defined %}{{ portfolio.availableCash|number_format(2) }}{% else %}0.00{% endif %}</div>
            </div>
            <div class="port-card">
                <div class="lbl">Connected Accounts / Positions</div>
                <div class="val" style="color:var(--blue);">
                    {% if portfolio.accounts is defined %}{{ portfolio.accounts|length }}{% else %}0{% endif %} Accounts / 
                    {% if portfolio.aggregatedEquities is defined %}{{ portfolio.aggregatedEquities|length }}{% else %}0{% endif %} Equities
                </div>
            </div>
        </div>

        <!-- VIEW MODE SELECTOR SUBTABS -->
        <div class="view-subtabs">
            <button class="vtab-btn active" id="vtabAccounts" onclick="switchPortSubView('holdings')"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">work</span> Portfolio Holdings & Accounts</button>
            <button class="vtab-btn" id="vtabOptions" onclick="switchPortSubView('options')"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">auto_awesome_motion</span> Open Options Positions</button>
            <button class="vtab-btn" id="vtabCalendar" onclick="switchPortSubView('calendar')"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">calendar_month</span> Options & Equities Calendar</button>
            <button class="vtab-btn" id="vtabHistory" onclick="switchPortSubView('history')"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">history</span> Activity & Cash History</button>
            <button class="vtab-btn" id="vtabOrders" onclick="switchPortSubView('orders')"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">pending_actions</span> Working & Open Orders</button>
            <div style="margin-left:auto; display:flex; gap:8px;">
                <button type="button" class="hbtn" style="background:var(--bg3); font-size:11px; padding:6px 12px;" onclick="forceRefreshPortfolioData()" title="Bypass persistent cache and query live brokerage APIs">
                    <span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">sync</span> Refresh Live Data
                </button>
                <a href="/screener" class="hbtn hbtn-green"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">bolt</span> Load Cash into Options Allocator</a>
            </div>
        </div>

        <!-- SUBVIEW: OPEN OPTIONS POSITIONS & MONEYMAKING HEALTH -->
        {% include 'screener/partials/_portfolio_options.html.twig' %}

        <!-- SUBVIEW 1: WORKING & OPEN ORDERS -->
        {% include 'screener/partials/_portfolio_orders.html.twig' %}

        <!-- SUBVIEW 2: 30-DAY ACCOUNT ACTIVITY & REALIZED CASH HISTORY -->
        {% include 'screener/partials/_portfolio_history.html.twig' %}

        <!-- SUBVIEW 3: OPTIONS & EQUITIES FORWARD CALENDAR -->
        {% include 'screener/partials/_portfolio_calendar.html.twig' %}

        <!-- SUBVIEW 4: PORTFOLIO HOLDINGS & ACCOUNTS (DEFAULT TAB) -->
        {% include 'screener/partials/_portfolio_holdings.html.twig' %}
    </div>
</div>

<!-- EVENT EXPLANATION CARD MODAL -->
<div id="calEventModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:3000; align-items:center; justify-content:center; padding:20px; backdrop-filter:blur(4px);">
    <div class="modal-body-lg" style="width:680px; max-width:94vw; max-height:88vh; display:flex; flex-direction:column; overflow:hidden; border-radius:16px; border:1px solid var(--border); background:var(--bg2); box-shadow:0 25px 60px rgba(0,0,0,0.85);">
        <div class="modal-hdr" style="padding:16px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; background:var(--bg3); flex-shrink:0;">
            <h2 id="calModalTitle" style="font-family:'Outfit',sans-serif; font-size:17px; color:var(--blue); margin:0; display:flex; align-items:center; gap:8px;"><span class="material-symbols-outlined" style="font-size:20px;">info</span> Event Details & Explanation</h2>
            <button class="rpx" onclick="document.getElementById('calEventModal').style.display='none'" style="background:none; border:none; color:var(--text); cursor:pointer; padding:4px 8px; border-radius:6px; display:flex; align-items:center; justify-content:center;"><span class="material-symbols-outlined" style="font-size:20px;">close</span></button>
        </div>
        <div class="modal-cnt" id="calModalCnt" style="padding:20px 24px; font-size:13px; line-height:1.6; overflow-y:auto; flex:1; min-height:0;"></div>
    </div>
</div>

{% include 'screener/partials/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/portfolio.js') }}"></script>
{% endblock %}
