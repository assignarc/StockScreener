{% extends 'base.html.twig' %}

{% block title %}Schwab Connected — KHAPRE MoonShot Portfolio{% endblock %}

{% block body %}
<div id="app">
    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '🏦 Charles Schwab <span>Authorization</span>',
        headerBadge: 'Live API Link Active'
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <style>
        .callback-wrap {
            min-height: 60vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
        }
        .callback-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 48px 40px;
            text-align: center;
            max-width: 520px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
            animation: fadeIn 0.5s ease;
        }
        .callback-icon { font-size: 56px; margin-bottom: 16px; }
        .callback-card h2 { color: var(--green); font-size: 22px; margin-bottom: 10px; font-family: 'Outfit', sans-serif; font-weight: 800; }
        .callback-card p { color: var(--muted); font-size: 14px; line-height: 1.7; margin-bottom: 24px; }
        .callback-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
        .callback-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: var(--blue);
            color: #0b0e14;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
            transition: opacity 0.2s, transform 0.15s;
        }
        .callback-btn:hover { opacity: 0.9; transform: translateY(-1px); }
        .callback-btn-sec {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: var(--bg3);
            border: 1px solid var(--border);
            color: var(--text);
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s;
        }
        .callback-btn-sec:hover { border-color: var(--text); }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>

    <div class="callback-wrap">
        <div class="callback-card">
            <div class="callback-icon">✅</div>
            <h2>Charles Schwab Connected!</h2>
            <p>Your Charles Schwab account has been successfully authorized and linked to <strong>KHAPRE MoonShot Portfolio</strong>. Your live brokerage positions, cash reserves, and collateral obligations are now streaming.</p>
            <div class="callback-actions">
                <a href="/portfolio" class="callback-btn">💼 View Portfolio Details →</a>
                <a href="/" class="callback-btn-sec">📊 Open Dashboard</a>
            </div>
        </div>
    </div>

    {% include 'screener/partials/_footer.html.twig' %}
</div>
{% endblock %}
