{# templates/screener/partials/_portfolio_options.html.twig #}
<!-- SUBVIEW: OPEN OPTIONS POSITIONS & MONEYMAKING HEALTH -->
<div id="subViewOptions" class="options-view-container" style="display:none;">

    <!-- TOP HEADER & CONTROLS -->
    <div class="opt-header-bar">
        <div class="opt-header-info">
            <div class="opt-header-title-row">
                <span class="material-symbols-outlined opt-header-icon">auto_awesome_motion</span>
                <h3 class="opt-header-title">Open Options Positions</h3>
                <span class="hbadge opt-count-badge">
                    {% if portfolio.optionsSummary is defined and portfolio.optionsSummary.totalPositions is defined %}
                        {{ portfolio.optionsSummary.totalPositions }} Positions ({{ portfolio.optionsSummary.totalContracts }} Contracts)
                    {% else %}
                        0 Positions
                    {% endif %}
                </span>
            </div>
            <div class="opt-header-desc">
                Real-time tracking and simple moneymaking trajectory analysis for all open options contracts based on position side, strike price, and underlying equity trading price.
            </div>
        </div>
        <div class="opt-header-actions">
            <button type="button" class="hbtn" style="background:var(--bg3); font-size:12px; padding:6px 14px;" onclick="forceRefreshPortfolioData()" title="Refresh live brokerage quotes">
                <span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">sync</span> Refresh Live Prices
            </button>
            <a href="/screener" class="hbtn hbtn-green" style="font-size:12px; padding:6px 14px;">
                <span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">bolt</span> Sell New Options
            </a>
        </div>
    </div>

    <!-- SUMMARY KPI TILES -->
    <div class="options-kpi-grid">
        <div class="options-kpi-card">
            <div class="kpi-icon-wrap" style="color:var(--blue);">
                <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-lbl">Total Open Positions</div>
                <div class="kpi-val" style="color:var(--blue);">
                    {{ portfolio.optionsSummary.totalPositions|default(0) }} <span class="kpi-sub">({{ portfolio.optionsSummary.totalContracts|default(0) }} contracts)</span>
                </div>
            </div>
        </div>

        <div class="options-kpi-card">
            <div class="kpi-icon-wrap" style="color:var(--green);">
                <span class="material-symbols-outlined">trending_up</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-lbl">Profitable / On Track</div>
                <div class="kpi-val g">
                    {{ portfolio.optionsSummary.profitRouteCount|default(0) }} <span class="kpi-sub">Positions (Above Breakeven / OTM)</span>
                </div>
            </div>
        </div>

        <div class="options-kpi-card">
            <div class="kpi-icon-wrap" style="color:var(--red);">
                <span class="material-symbols-outlined">warning</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-lbl">Below Breakeven (At Risk)</div>
                <div class="kpi-val r">
                    {{ portfolio.optionsSummary.atRiskCount|default(0) }} <span class="kpi-sub">Positions Losing Basis</span>
                </div>
            </div>
        </div>

        <div class="options-kpi-card">
            <div class="kpi-icon-wrap" style="color:var(--yellow);">
                <span class="material-symbols-outlined">shield</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-lbl">Cash Collateral Committed</div>
                <div class="kpi-val y">
                    ${{ (portfolio.optionsSummary.totalCashCollateral|default(0))|number_format(2) }}
                </div>
            </div>
        </div>

        <div class="options-kpi-card">
            <div class="kpi-icon-wrap" style="color:var(--purple);">
                <span class="material-symbols-outlined">lock</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-lbl">Pledged Stock Shares</div>
                <div class="kpi-val" style="color:var(--purple);">
                    {{ portfolio.optionsSummary.totalPledgedShares|default(0)|number_format(0) }} <span class="kpi-sub">Covered Call Shares</span>
                </div>
            </div>
        </div>

        <div class="options-kpi-card">
            <div class="kpi-icon-wrap" style="color:var(--green);">
                <span class="material-symbols-outlined">payments</span>
            </div>
            <div class="kpi-content">
                <div class="kpi-lbl">Total Commission Received</div>
                <div class="kpi-val g">
                    +${{ portfolio.optionsSummary.totalCommissionCollectedStr|default('0.00') }}
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="opt-toolbar">
        <div style="position: relative; display: flex; align-items: center;">
            <span class="material-symbols-outlined" style="position: absolute; left: 10px; font-size: 16px; color: var(--muted); pointer-events: none;">search</span>
            <input type="text" id="optSearchInput" placeholder="Filter by symbol, strategy, or account..." onkeyup="filterOpenOptions()" class="app-filter-input" style="width: 280px;">
        </div>
        <div class="seg-track">
            <button type="button" class="seg-btn opt-pill-filter active" id="filterOptAll" onclick="setOptionsFilter('ALL')">
                <span class="material-symbols-outlined" style="font-size:13px;">apps</span> All ({{ portfolio.optionsSummary.totalPositions|default(0) }})
            </button>
            <button type="button" class="seg-btn opt-pill-filter" id="filterOptProfit" onclick="setOptionsFilter('PROFIT_ROUTE')">
                <span class="material-symbols-outlined" style="font-size:13px; color:var(--green);">trending_up</span> On Track / Profitable ({{ portfolio.optionsSummary.profitRouteCount|default(0) }})
            </button>
            <button type="button" class="seg-btn opt-pill-filter" id="filterOptRisk" onclick="setOptionsFilter('AT_RISK')">
                <span class="material-symbols-outlined" style="font-size:13px; color:var(--red);">warning</span> Below Breakeven ({{ portfolio.optionsSummary.atRiskCount|default(0) }})
            </button>
            <button type="button" class="seg-btn opt-pill-filter" id="filterOptCalls" onclick="setOptionsFilter('CALL')">
                <span class="material-symbols-outlined" style="font-size:13px; color:var(--blue);">arrow_circle_up</span> Covered Calls
            </button>
            <button type="button" class="seg-btn opt-pill-filter" id="filterOptPuts" onclick="setOptionsFilter('PUT')">
                <span class="material-symbols-outlined" style="font-size:13px; color:var(--yellow);">shield</span> Cash-Secured Puts
            </button>
        </div>
    </div>

    <!-- POSITIONS GRID -->
    <div class="options-cards-grid" id="optionsCardsList">
        {% if portfolio.openOptionPositions is defined and portfolio.openOptionPositions|length > 0 %}
            {% for opt in portfolio.openOptionPositions %}
                {% set isProfit = opt.healthStatusCode == 'PROFIT_ROUTE' or opt.healthStatusCode == 'PROFITABLE' %}
                {% set isAtRisk = opt.healthStatusCode == 'AT_RISK' %}
                <div class="opt-card" data-symbol="{{ opt.root }}" data-strategy="{{ opt.type|upper }}" data-status="{{ opt.healthStatusCode }}" data-account="{{ opt.primaryAccountNickname }}" id="opt_card_{{ loop.index }}">
                    
                    <!-- COMPACT CARD HEADER (CLEAN & UNIFORM HEIGHT) -->
                    <div class="opt-card-header">
                        <div class="opt-card-primary">
                            <div class="opt-sym-row">
                                <a href="/screener?symbol={{ opt.root }}" class="opt-sym-link hover-blue" title="Inspect {{ opt.root }} in Screener">
                                    {{ opt.root }}
                                </a>
                                <span class="opt-strategy-pill {% if opt.type == 'Call' %}opt-strat-call{% else %}opt-strat-put{% endif %}">
                                    <span class="material-symbols-outlined">{% if opt.type == 'Call' %}arrow_circle_up{% else %}shield{% endif %}</span>
                                    <span>{{ opt.strategy }}</span>
                                </span>
                            </div>
                        </div>

                        <div class="opt-card-header-right">
                            <div class="opt-health-badge {% if isProfit %}badge-profit{% elseif isAtRisk %}badge-risk{% else %}badge-caution{% endif %}">
                                <span class="material-symbols-outlined">{{ opt.healthBadgeIcon }}</span>
                                <span>{{ opt.healthBadgeLabel }}</span>
                            </div>
                        </div>
                    </div>

                    <!-- COMPACT METRICS GRID -->
                    <div class="opt-card-body">
                        <div class="opt-metrics-grid">
                            
                            <!-- 1. STRIKE VS CURRENT QUOTE -->
                            <div class="opt-metric-cell">
                                <div class="opt-m-lbl">Strike vs Stock</div>
                                <div class="opt-m-val">
                                    ${{ opt.strikeStr }} <span class="opt-quote-sub">(${{ opt.underlyingPriceStr }})</span>
                                </div>
                                <div class="opt-m-sub">
                                    <span class="opt-distance-pill-mini {% if isProfit %}dist-green{% elseif isAtRisk %}dist-red{% else %}dist-yellow{% endif %}">
                                        {{ opt.distanceStr }}
                                    </span>
                                </div>
                            </div>

                            <!-- 2. COST BASIS / ENTRY BASIS -->
                            <div class="opt-metric-cell">
                                <div class="opt-m-lbl">
                                    {% if opt.type == 'Call' %}Stock Cost Basis{% else %}Effective Entry{% endif %}
                                </div>
                                <div class="opt-m-val">
                                    {% if opt.type == 'Call' and opt.hasStockHolding %}
                                        ${{ opt.stockCostBasisStr }}
                                    {% else %}
                                        ${{ opt.netBreakevenStr }}
                                    {% endif %}
                                </div>
                                <div class="opt-m-sub">
                                    {% if opt.type == 'Call' and opt.isStrikeBelowCost %}
                                        <span class="r" style="font-weight:700;">Strike < Basis ({{ opt.strikeCostDiffStr }})</span>
                                    {% elseif opt.type == 'Call' %}
                                        <span class="g">{{ opt.pledgedShares }} Pledged Shs</span>
                                    {% else %}
                                        <span class="y">${{ opt.cashCollateralStr }} Collateral</span>
                                    {% endif %}
                                </div>
                            </div>

                            <!-- 3. NET COMMISSION & FEES -->
                            <div class="opt-metric-cell">
                                <div class="opt-m-lbl">Net Premium</div>
                                <div class="opt-m-val g">
                                    +${{ opt.netCommissionStr }}
                                </div>
                                <div class="opt-m-sub">
                                    <span class="opt-fee-text">Gross +${{ opt.grossCommissionStr }} • -${{ opt.totalOptionFeesStr }} fee</span>
                                </div>
                            </div>

                            <!-- 4. BOTTOMLINE IMPACT (CALLED AWAY / ROC) -->
                            <div class="opt-metric-cell">
                                <div class="opt-m-lbl">
                                    {% if opt.type == 'Call' %}If Called Away (Net){% else %}Max Profit (OTM Exp){% endif %}
                                </div>
                                <div class="opt-m-val {% if opt.totalBottomlineGain >= 0 %}g{% else %}r{% endif %}">
                                    {{ opt.totalBottomlineGainStr }}
                                </div>
                                <div class="opt-m-sub">
                                    {% if opt.type == 'Call' and opt.hasStockHolding %}
                                        <span class="{% if opt.bottomlineRoiPct >= 0 %}g{% else %}r{% endif %}">
                                            {{ opt.bottomlineRoiPct }}% Net ROI (Stock+Opt)
                                        </span>
                                    {% else %}
                                        <span class="g">+{{ opt.bottomlineRoiPct }}% Return on Cash</span>
                                    {% endif %}
                                </div>
                            </div>

                            <!-- 5. POSITION CONTRACTS -->
                            <div class="opt-metric-cell">
                                <div class="opt-m-lbl">Position Contracts</div>
                                <div class="opt-m-val">
                                    {{ opt.quantity }}
                                </div>
                                <div class="opt-m-sub">
                                    <span>{{ opt.sharesRepresented }} Shares</span>
                                </div>
                            </div>

                            <!-- 6. EXPIRATION & DTE -->
                            <div class="opt-metric-cell">
                                <div class="opt-m-lbl">Expiration / DTE</div>
                                <div class="opt-m-val" style="font-size:13px;">
                                    {{ opt.expiration }}
                                </div>
                                <div class="opt-m-sub">
                                    <span class="opt-dte-pill-mini">
                                        <span class="material-symbols-outlined" style="font-size:11px;">schedule</span>
                                        {{ opt.dteText }}
                                    </span>
                                </div>
                            </div>

                        </div>

                        <!-- COLLAPSIBLE ANALYSIS & RECOMMENDATION PANEL -->
                        <details class="opt-analysis-details">
                            <summary class="opt-analysis-summary">
                                <div class="opt-summary-title">
                                    <span class="material-symbols-outlined" style="font-size:15px; color:var(--blue);">analytics</span>
                                    <span>Financial Breakdown, Trajectory & Guidance</span>
                                </div>
                                <span class="material-symbols-outlined opt-summary-arrow">expand_more</span>
                            </summary>
                            
                            <div class="opt-analysis-expanded">
                                <!-- DETAILED FINANCIAL MATH STRIP -->
                                <div class="opt-math-box">
                                    <div class="opt-math-title">
                                        <span class="material-symbols-outlined" style="font-size:14px; color:var(--blue);">calculate</span>
                                        <span>
                                            {% if opt.type == 'Call' %}
                                                Covered Call Bottomline Realization Math (If Called Away)
                                            {% else %}
                                                Cash-Secured Put Economics & Assignment Protection
                                            {% endif %}
                                        </span>
                                    </div>
                                    <div class="opt-math-grid">
                                        {% if opt.type == 'Call' and opt.hasStockHolding %}
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Stock Realized Capital Gain:</span>
                                                <span class="opt-m-calc">{{ opt.sharesRepresented }} shs × (${{ opt.strikeStr }} - ${{ opt.stockCostBasisStr }}) = <strong>{{ opt.totalStockCapGainStr }}</strong></span>
                                            </div>
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Option Gross Premium:</span>
                                                <span class="opt-m-calc g">+${{ opt.grossCommissionStr }} (+${{ opt.grossCommissionPerStockStr }}/sh)</span>
                                            </div>
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Option Contract Trade Fee:</span>
                                                <span class="opt-m-calc r">-${{ opt.totalOptionFeesStr }} <span class="opt-fee-source-tag">({{ opt.feeSource }})</span></span>
                                            </div>
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Stock Exit Regulatory Fees:</span>
                                                <span class="opt-m-calc r">-${{ opt.stockExitFeesStr }} <span class="opt-fee-source-tag">(SEC + FINRA TAF on sale)</span></span>
                                            </div>
                                            <div class="opt-math-row opt-math-total {% if opt.totalBottomlineGain >= 0 %}math-total-good{% else %}math-total-bad{% endif %}">
                                                <span class="opt-m-label"><strong>Total Net Realized Bottomline:</strong></span>
                                                <span class="opt-m-calc"><strong class="{% if opt.totalBottomlineGain >= 0 %}g{% else %}r{% endif %}">{{ opt.totalBottomlineGainStr }} ({{ opt.bottomlineRoiPct }}% Net ROI)</strong></span>
                                            </div>
                                            <div class="opt-math-row opt-math-footer">
                                                <span class="opt-m-label">Downside Breakeven Protection:</span>
                                                <span class="opt-m-calc"><strong>${{ opt.netBreakevenStr }}/sh</strong> <span style="font-weight:400; color:var(--muted);">({{ opt.breakevenFormula }})</span></span>
                                            </div>
                                        {% elseif opt.type == 'Call' %}
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Option Gross Premium:</span>
                                                <span class="opt-m-calc g">+${{ opt.grossCommissionStr }}</span>
                                            </div>
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Option Contract Trade Fee:</span>
                                                <span class="opt-m-calc r">-${{ opt.totalOptionFeesStr }} <span class="opt-fee-source-tag">({{ opt.feeSource }})</span></span>
                                            </div>
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Stock Exit Regulatory Fees:</span>
                                                <span class="opt-m-calc r">-${{ opt.stockExitFeesStr }} <span class="opt-fee-source-tag">(SEC + FINRA TAF)</span></span>
                                            </div>
                                            <div class="opt-math-row opt-math-total math-total-good">
                                                <span class="opt-m-label"><strong>Net Bottomline Realization:</strong></span>
                                                <span class="opt-m-calc"><strong class="g">{{ opt.totalBottomlineGainStr }}</strong></span>
                                            </div>
                                            <div class="opt-math-row opt-math-footer">
                                                <span class="opt-m-label">Gross Exit Realization:</span>
                                                <span class="opt-m-calc"><strong>${{ opt.netBreakevenStr }}/sh</strong> <span style="font-weight:400; color:var(--muted);">(${{ opt.strikeStr }} + ${{ opt.commissionPerStockStr }}/sh)</span></span>
                                            </div>
                                        {% else %}
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Cash Collateral Committed:</span>
                                                <span class="opt-m-calc">${{ opt.cashCollateralStr }} ({{ opt.sharesRepresented }} shs × ${{ opt.strikeStr }})</span>
                                            </div>
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Option Gross Premium:</span>
                                                <span class="opt-m-calc g">+${{ opt.grossCommissionStr }}</span>
                                            </div>
                                            <div class="opt-math-row">
                                                <span class="opt-m-label">Option Contract Trade Fee:</span>
                                                <span class="opt-m-calc r">-${{ opt.totalOptionFeesStr }} <span class="opt-fee-source-tag">({{ opt.feeSource }})</span></span>
                                            </div>
                                            <div class="opt-math-row opt-math-total math-total-good">
                                                <span class="opt-m-label"><strong>Net Retained Profit (If OTM Expiry):</strong></span>
                                                <span class="opt-m-calc"><strong class="g">+${{ opt.netCommissionStr }} (+{{ opt.bottomlineRoiPct }}% ROC)</strong></span>
                                            </div>
                                            <div class="opt-math-row opt-math-footer">
                                                <span class="opt-m-label">Effective Net Entry if Assigned:</span>
                                                <span class="opt-m-calc"><strong>${{ opt.netBreakevenStr }}/sh</strong> <span style="font-weight:400; color:var(--muted);">({{ opt.breakevenFormula }})</span></span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                <!-- TRAJECTORY ANALYSIS TEXT -->
                                <div class="opt-analysis-narrative {% if isProfit %}narrative-profit{% elseif isAtRisk %}narrative-risk{% else %}narrative-caution{% endif %}">
                                    <div class="opt-narrative-hdr">
                                        <span class="material-symbols-outlined" style="font-size:14px;">
                                            {% if isProfit %}trending_up{% elseif isAtRisk %}report{% else %}help{% endif %}
                                        </span>
                                        <strong>Trajectory Analysis:</strong>
                                    </div>
                                    <div class="opt-narrative-body">
                                        {{ opt.simpleAnalysis }}
                                    </div>
                                    {% if opt.actionAdvice %}
                                        <div class="opt-action-line">
                                            <span class="material-symbols-outlined" style="font-size:13px; color:var(--blue);">tips_and_updates</span>
                                            <span><strong>Guidance:</strong> {{ opt.actionAdvice }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </details>
                    </div>

                    <!-- CARD FOOTER -->
                    <div class="opt-card-footer">
                        <div class="opt-footer-desc" title="{{ opt.symbol }}: {{ opt.description }}">
                            <span class="material-symbols-outlined opt-desc-icon">description</span>
                            <span class="opt-footer-desc-text">{{ opt.description }}</span>
                        </div>
                        <div class="opt-footer-right">
                            <span class="opt-account-tag" title="Account: {{ opt.primaryAccountNickname }} ({{ opt.primaryAccountNumber }})">
                                <span class="material-symbols-outlined">account_balance</span>
                                <span>{{ opt.primaryAccountNickname }}</span>
                            </span>

                            <!-- SCREENER ACTION BUTTON WITH POPOVER -->
                            <div class="opt-btn-popover-wrap">
                                <a href="/screener?symbol={{ opt.root }}" class="opt-foot-icon-btn" aria-label="Open Screener for {{ opt.root }}">
                                    <span class="material-symbols-outlined">bolt</span>
                                </a>
                                <div class="opt-btn-popover">
                                    <div class="opt-pop-title">
                                        <span class="material-symbols-outlined" style="font-size:13px; color:var(--blue);">bolt</span>
                                        <span>Screener Technicals</span>
                                    </div>
                                    <div class="opt-pop-desc">
                                        Analyze {{ opt.root }} technical indicators, options chain, and setup signals in Screener.
                                    </div>
                                </div>
                            </div>

                            <!-- HOLDINGS ACTION BUTTON WITH POPOVER -->
                            <div class="opt-btn-popover-wrap">
                                <a href="/portfolio?tab=holdings&symbol={{ opt.root }}" class="opt-foot-icon-btn" aria-label="View {{ opt.root }} Holdings">
                                    <span class="material-symbols-outlined">work</span>
                                </a>
                                <div class="opt-btn-popover">
                                    <div class="opt-pop-title">
                                        <span class="material-symbols-outlined" style="font-size:13px; color:var(--purple);">work</span>
                                        <span>Equity Holdings</span>
                                    </div>
                                    <div class="opt-pop-desc">
                                        View underlying {{ opt.root }} share lots, average cost basis, and pledged shares in Portfolio.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="opt-empty-box" style="grid-column: 1 / -1;">
                <span class="material-symbols-outlined opt-empty-icon">layers_clear</span>
                <h4>No Open Options Positions Found</h4>
                <p>There are currently no active Call or Put options held in your connected brokerage accounts.</p>
                <a href="/screener" class="hbtn hbtn-green" style="margin-top:10px;">
                    <span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">bolt</span> Scan Covered Calls & Cash-Secured Puts
                </a>
            </div>
        {% endif %}
    </div>
</div>
