{% extends 'base.html.twig' %}

{% block title %}Stock Screener & Options Flywheel — MoonShot Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/screener_index.css') }}">
{% endblock %}

{% block body %}
<!-- APP DASHBOARD -->
<div id="app">
    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined">bolt</span> Capital Flywheel <span>Stock Screener</span>',
        headerBadge: 'v3 Options Engine',
        showLiveLoadBtn: true
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <div class="screener-container">
        <!-- FLYWHEEL CONFIGURABLE RISK BANNER -->
        <div class="fw-banner" style="border-radius: 12px; border: 1px solid var(--border);">
            <div style="display:flex;align-items:center;gap:10px">
                <span class="material-symbols-outlined" style="font-size: 24px; color: var(--blue);">settings</span>
                <div>
                    <div style="font-weight:700;font-size:13px;color:var(--text)">Flywheel Monthly Risk Guardrail: <span id="fwRiskCapText" style="color:var(--blue);cursor:pointer;font-weight:800;" onclick="changeRiskConfig()" title="Click to adjust monthly risk cap">$10,000</span> <span style="font-size:10px;color:var(--muted);">(Click to change)</span></div>
                    <div style="font-size:11px;color:var(--muted)">Enforces 100% Covered & Cash-Collateralized Option Trades (Zero Margin Traps)</div>
                </div>
            </div>
            <div class="fw-risk-box">
                <div class="fw-risk-lbl">
                    <span>Existing Open Risk: <strong id="fwUsedRiskText" style="color:var(--yellow)">$2,500</strong></span>
                    <span>Staged Today: <strong id="fwStagedRiskText" style="color:var(--blue)">$3,800</strong></span>
                    <span>Available Remaining: <strong id="fwFreeRiskText" style="color:var(--green)">$3,700</strong></span>
                </div>
                <div class="fw-progress-bg">
                    <div id="fwBarUsed" class="fw-bar-used" style="width:25%" title="Existing Open Risk"></div>
                    <div id="fwBarStaged" class="fw-bar-staged" style="width:38%" title="Staged Today Risk"></div>
                    <div id="fwBarFree" class="fw-bar-free" style="width:37%" title="Available Risk Remaining"></div>
                </div>
            </div>
            <button class="hbtn hbtn-fw" style="padding:6px 14px;font-size:12px; display:inline-flex; align-items:center; justify-content:center;" onclick="openFlywheelPlanner()"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px;">wb_twilight</span> View Morning Trade Package</button>
        </div>

        <!-- DEDICATED STOCK SCREENER PAGE -->
        <div id="screenerView" style="display: flex; flex-direction: column; gap: 20px;">
            <!-- FLYWHEEL CAPITAL ALLOCATOR WIDGET -->
            <div class="fw-panel" id="capitalAllocator">
                <div class="fw-title">
                    <span class="fw-icon"><span class="material-symbols-outlined">settings</span> CAPITAL FLYWHEEL</span>
                    <span>Portfolio Allocation Engine</span>
                </div>
                <div class="fw-inputs">
                    <div class="fw-input-wrap">
                        <span>$</span>
                        <input id="totalCap" type="number" value="10000" step="1000" oninput="updateFlywheelAllocation()">
                    </div>
                </div>
                <div class="fw-stats">
                    <div class="fw-pill fw-pill-call">
                        <span><span class="material-symbols-outlined" style="font-size: 14px; margin-right: 2px;">arrow_circle_up</span> CALLs (60%):</span>
                        <span id="allocCallVal">$6,000</span>
                    </div>
                    <div class="fw-pill fw-pill-wheel">
                        <span><span class="material-symbols-outlined" style="font-size: 14px; margin-right: 2px;">autorenew</span> WHEEL (25%):</span>
                        <span id="allocWheelVal">$2,500</span>
                    </div>
                    <div class="fw-pill fw-pill-put">
                        <span><span class="material-symbols-outlined" style="font-size: 14px; margin-right: 2px;">arrow_circle_down</span> PUTs (15%):</span>
                        <span id="allocPutVal">$1,500</span>
                    </div>
                </div>
            </div>

            <!-- MAIN SCREENER CARD -->
            <div class="screener-card">
                <!-- OPTIONS LEVEL 1 BASIC STRATEGY BANNER -->
                <div class="screener-level1-banner">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span class="strategy-badge">
                            <span class="material-symbols-outlined" style="font-size:14px;">lock</span> OPTION LEVEL 1 BASIC (100% COVERED / RISK DEFINED)
                        </span>
                        <span style="font-size: 12px; color: var(--text);">
                            Allocating your <strong style="color:var(--green);" id="playbookCashText">{% if portfolio.availableCash is defined %}${{ portfolio.availableCash|number_format(2) }}{% else %}$0.00{% endif %} available cash</strong> into 100% Covered & Capped-Risk strategies:
                        </span>
                    </div>
                    <div class="strategy-items-list">
                        <span class="strategy-item item-call"><span class="material-symbols-outlined" style="font-size:14px;">trending_up</span> Defined-Risk Long CALLS</span>
                        <span class="strategy-item item-wheel"><span class="material-symbols-outlined" style="font-size:14px;">sync_alt</span> Cash-Secured PUTS</span>
                        <span class="strategy-item item-put"><span class="material-symbols-outlined" style="font-size:14px;">shield</span> Covered CALLS</span>
                    </div>
                </div>

                <!-- MODERN COMMAND BAR & FILTER RIBBON -->
                <div class="screener-command-bar">
                    <!-- ROW 1: SEARCH, STRATEGY SIGNAL SEGMENTED CONTROL & QUICK METRICS -->
                    <div class="cmd-row-primary">
                        <!-- INSTANT SEARCH INPUT -->
                        <div class="cmd-search-wrap">
                            <span class="material-symbols-outlined cmd-search-icon">search</span>
                            <input id="srch" class="cmd-search-input" placeholder="Search ticker, company name, sector..." oninput="onSearchInput()">
                            <button class="cmd-search-clear" onclick="document.getElementById('srch').value=''; onSearchInput();" title="Clear Search">
                                <span class="material-symbols-outlined" style="font-size:14px;">close</span>
                            </button>
                        </div>

                        <!-- STRATEGY SIGNAL SEGMENTED TRACK -->
                        <div class="cmd-segment-group">
                            <span class="cmd-label"><span class="material-symbols-outlined" style="font-size:14px; color:var(--purple);">tune</span> Signal:</span>
                            <div class="cmd-track">
                                <button class="cmd-tab sig-btn active-all" onclick="filterSignal('ALL', this)">
                                    <span class="material-symbols-outlined" style="font-size:14px;">apps</span>
                                    <span>All Signals</span>
                                </button>
                                <button class="cmd-tab sig-btn" onclick="filterSignal('CALL', this)">
                                    <span class="material-symbols-outlined" style="font-size:14px; color:var(--green);">trending_up</span>
                                    <span>CALL (Growth)</span>
                                </button>
                                <button class="cmd-tab sig-btn" onclick="filterSignal('WHEEL', this)">
                                    <span class="material-symbols-outlined" style="font-size:14px; color:var(--yellow);">sync_alt</span>
                                    <span>WHEEL (Income)</span>
                                </button>
                                <button class="cmd-tab sig-btn" onclick="filterSignal('PUT', this)">
                                    <span class="material-symbols-outlined" style="font-size:14px; color:var(--red);">shield</span>
                                    <span>PUT (Hedge)</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ROW 2: SECTOR PILL CAROUSEL & ASSET / RISK SELECTORS -->
                    <div class="cmd-row-secondary">
                        <div class="cmd-sector-ribbon">
                            <span class="cmd-label"><span class="material-symbols-outlined" style="font-size:14px; color:var(--blue);">category</span> Sector:</span>
                            <div class="cmd-chips-scroll">
                                <button class="cmd-chip fbtn active" onclick="filterSector('ALL', this)">All Sectors</button>
                                {% for sector in sectors %}
                                    <button class="cmd-chip fbtn" onclick="filterSector('{{ sector }}', this)">{{ sector }}</button>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- ASSET TYPE & RISK LEVEL SELECTORS -->
                        <div class="cmd-filter-right">
                            <div class="cmd-select-wrap">
                                <span class="material-symbols-outlined" style="font-size:14px; color:var(--muted);">account_tree</span>
                                <select class="cmd-select" onchange="filterAssetType(this.value)">
                                    <option value="ALL">All Asset Types</option>
                                    <option value="STOCK">Stocks</option>
                                    <option value="ETF">ETFs</option>
                                    <option value="BOND_ETF">Fixed Income / Bonds</option>
                                </select>
                            </div>
                            <div class="cmd-select-wrap">
                                <span class="material-symbols-outlined" style="font-size:14px; color:var(--muted);">speed</span>
                                <select class="cmd-select" onchange="filterRisk(this.value)">
                                    <option value="ALL">All Risk Levels</option>
                                    <option value="LOW">Low Risk (Conservative)</option>
                                    <option value="MED">Med Risk (Balanced)</option>
                                    <option value="HIGH">High Risk (Aggressive)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STATUS BAR -->
                <div id="statusBar">Loaded {{ totalStocks }} curated candidates from Doctrine database.</div>

                <!-- STATS OVERVIEW -->
                <div class="sbar">
                    <div class="sc"><div class="v" id="statCount">{{ totalStocks }}</div><div class="l">Tracked Stocks</div></div>
                    <div class="sc"><div class="v" id="statCallsCount">—</div><div class="l"><span class="material-symbols-outlined" style="font-size:14px; margin-right:2px;">arrow_circle_up</span> CALL Signals</div></div>
                    <div class="sc"><div class="v" id="statPutsCount">—</div><div class="l"><span class="material-symbols-outlined" style="font-size:14px; margin-right:2px;">arrow_circle_down</span> PUT Signals</div></div>
                    <div class="sc"><div class="v" id="statWheelCount">—</div><div class="l"><span class="material-symbols-outlined" style="font-size:14px; margin-right:2px;">autorenew</span> WHEEL Signals</div></div>
                </div>

                <!-- TABLE WRAPPER -->
                <div id="tw">
                    <table>
                        <thead>
                            <tr>
                                <th onclick="sortTable('symbol')">
                                    <span>Ticker</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">label</span> Stock Ticker Symbol</div>
                                            Queried from local SQLite/Doctrine database (<code>Stock::$symbol</code>), cross-referenced against Finnhub API and connected Schwab account holdings.
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('name')">
                                    <span>Company</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">business</span> Company Name</div>
                                            Fetched live from Finnhub API company profile endpoint (<code>/api/v1/stock/profile2</code>).
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('signal')">
                                    <span>Flywheel Signal</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">tune</span> Option Signal</div>
                                            Evaluated real-time by <code>FlywheelService</code>. Evaluates fundamental score (&ge;70, &lt;45), upside %, and risk to classify Level 1 Basic option strategies (CALL, WHEEL, PUT).
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('sector')">
                                    <span>Sector</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">public</span> Industry Sector</div>
                                            Retrieved from Finnhub API industry classification field (<code>finnhubIndustry</code>).
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('price')">
                                    <span>Price</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">payments</span> Current Market Price</div>
                                            Live current market quote (<code>c</code>) streamed from Finnhub API (<code>/api/v1/quote</code>) or Schwab Developer API market data.
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('targetPrice')">
                                    <span>Target</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">track_changes</span> 12M Analyst Target</div>
                                            Aggregated 12-month Wall Street consensus analyst price target from Finnhub consensus endpoint & database baseline.
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('upside')">
                                    <span>Upside</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">trending_up</span> Implied Upside %</div>
                                            Calculated dynamically in frontend JS: <code>((TargetPrice - Price) / Price) * 100</code>.
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('revGrowth')">
                                    <span>Rev Growth</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">bar_chart</span> Revenue Growth Rate</div>
                                            Pulled from quarterly SEC earnings filings & Finnhub fundamentals data (<code>revGrowth</code> field).
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('risk')">
                                    <span>Risk</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">bolt</span> Volatility Risk Level</div>
                                            Assigned based on 30-day historical beta, market capitalization tier, and price volatility range (<code>LOW</code>, <code>MED</code>, <code>HIGH</code>).
                                        </span>
                                    </span>
                                </th>
                                <th onclick="sortTable('score')">
                                    <span>Score</span>
                                    <span class="col-popover-trigger" tabindex="0"><span class="material-symbols-outlined" style="font-size: 14px; margin: 0;">info</span>
                                        <span class="col-popover">
                                            <div class="col-popover-title"><span class="material-symbols-outlined" style="font-size:14px;">grade</span> Fundamental Score (0-100)</div>
                                            Proprietary 0-100 score calculated by evaluating revenue growth rate, gross margin %, cash runway months, and analyst ratings.
                                        </span>
                                    </span>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="stockTableBody">
                            <!-- Javascript populated rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RESEARCH PANEL DRAWER -->
<div id="rp">
    <div class="rph">
        <h3 id="rpTitle">Stock Research & Analysis</h3>
        <button class="rpx" onclick="closeResearchPanel()"><span class="material-symbols-outlined" style="font-size:18px;">close</span></button>
    </div>
    <div class="rpb">
        <!-- PROGRESSIVE DISCLOSURE TIER 1: THE SAUSAGE (EXECUTIVE TRADE PLAN) -->
        <div id="rpExecutiveBanner" class="exec-plan-card">
            <div class="exec-plan-header">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="color: var(--blue); font-size: 20px;">assignment</span>
                    <div>
                        <h4 class="exec-plan-title" id="rpExecStrategyName">Defined-Risk Strategy</h4>
                        <span id="rpExecTierName" class="exec-plan-subtitle">Capital Compounder</span>
                    </div>
                </div>
                <span id="rpSignalBadge" class="badge-sig badge-CALL">CALL</span>
            </div>

            <!-- Plain English 1-Line Thesis -->
            <div class="exec-thesis-box">
                <div class="exec-thesis-label">
                    <span class="material-symbols-outlined" style="font-size: 14px;">lightbulb</span> Executive Thesis
                </div>
                <div id="rpExecThesis" class="exec-thesis-content">
                    Live Schwab Option Chain Target Evaluation
                </div>
            </div>

            <!-- Crisp 3-Column Plan -->
            <div class="exec-plan-grid">
                <div class="exec-plan-cell">
                    <div class="m" style="font-size: 10px;">Recommended Sizing</div>
                    <strong id="rpExecAllocation" style="color: var(--green); font-size: 14px;">$1,000</strong>
                    <div style="font-size: 9.5px; color: var(--muted); margin-top: 2px;">100% Cash-Collateralized</div>
                </div>
                <div class="exec-plan-cell">
                    <div class="m" style="font-size: 10px;">Entry / Buy Date</div>
                    <strong id="rpExecEntryDate" style="color: var(--blue); font-size: 14px;">Today</strong>
                    <div style="font-size: 9.5px; color: var(--muted); margin-top: 2px;">Stage in Morning Package</div>
                </div>
                <div class="exec-plan-cell">
                    <div class="m" style="font-size: 10px;">Target Exit / Sell Date</div>
                    <strong id="rpExecExitDate" style="color: var(--purple); font-size: 14px;">45 Days</strong>
                    <div id="rpExecDteNote" style="font-size: 9.5px; color: var(--muted); margin-top: 2px;">Dynamic Horizon</div>
                </div>
            </div>

            <!-- Dynamic Exit Rules -->
            <div class="exec-exit-rules-grid">
                <div class="exec-exit-rule-cell rule-profit">
                    <strong style="color: var(--green); display: flex; align-items: center; gap: 4px;"><span class="material-symbols-outlined" style="font-size: 13px;">trending_up</span> Profit Exit:</strong>
                    <span id="rpExecProfitRule" style="color: var(--text);">+80% premium gain</span>
                </div>
                <div class="exec-exit-rule-cell rule-stop">
                    <strong style="color: var(--red); display: flex; align-items: center; gap: 4px;"><span class="material-symbols-outlined" style="font-size: 13px;">shield</span> Stop Loss / Roll:</strong>
                    <span id="rpExecStopLossRule" style="color: var(--text);">Defined max loss</span>
                </div>
            </div>
        </div>

        <!-- PROGRESSIVE DISCLOSURE TIER 2 TOGGLE -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin: 16px 0 10px 0; border-top: 1px solid var(--border); padding-top: 14px;">
            <div style="display: flex; align-items: center; gap: 6px;">
                <span class="material-symbols-outlined" style="color: var(--purple); font-size: 18px;">analytics</span>
                <span style="font-size: 12px; font-weight: 700; color: var(--text);">Institutional Underwriting & Multi-API Audit</span>
            </div>
            <button id="btnToggleAudit" class="hbtn" style="padding: 4px 10px; font-size: 11px; display: inline-flex; align-items: center; gap: 4px;" onclick="toggleAuditDrawer()">
                <span class="material-symbols-outlined" style="font-size: 14px;" id="toggleAuditIcon">expand_more</span>
                <span id="toggleAuditText">Inspect Full Math & APIs</span>
            </button>
        </div>

        <div id="auditContainer" style="display: none;">
            <!-- SCHWAB LIVE OPTION CHAIN MATRIX -->
            <div class="tb" style="margin-bottom: 18px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px;">
                    <h4 style="color:var(--text); font-size: 11px;"><span class="material-symbols-outlined" style="font-size:14px; margin-right:4px; color:var(--blue);">account_balance</span> Schwab Developer API — Live Option Chain & Gemini AI Target Selection</h4>
                    <span id="schwabSourceBadge" class="rb rLOW">Schwab API Connected</span>
                </div>

                <!-- GEMINI AI STRIKE DETERMINATION BANNER -->
                <div id="geminiOptionAnalysisBox" class="gemini-analysis-box" style="display: none;">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
                        <strong style="font-size:11.5px; color:var(--purple); display:flex; align-items:center; gap:6px;">
                            <span><span class="material-symbols-outlined" style="font-size:14px;">smart_toy</span> Gemini AI Options Target Determination</span>
                        </strong>
                        <span class="rb" style="background:rgba(142, 130, 184, 0.10); color:var(--purple); border:1px solid rgba(142, 130, 184, 0.20);">Option Level 1 Basic</span>
                    </div>
                    <div id="geminiOptionTargetsGrid" style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; font-size:11px; margin-bottom:8px;">
                        <!-- Filled dynamically via JS -->
                    </div>
                    <div id="geminiOptionVerdict" class="gemini-option-verdict">
                        <!-- Filled dynamically via JS -->
                    </div>
                </div>

                <div style="overflow-x: auto;">
                    <table style="width:100%; font-size: 11px;">
                        <thead>
                            <tr style="border-bottom:1px solid var(--border);">
                                <th style="font-size:10px;">Type</th>
                                <th style="font-size:10px;">Strike ($)</th>
                                <th style="font-size:10px;">Bid ($)</th>
                                <th style="font-size:10px;">Ask ($)</th>
                                <th style="font-size:10px;">IV (%)</th>
                                <th style="font-size:10px;">Delta (Δ)</th>
                                <th style="font-size:10px;">Theta (Θ)</th>
                                <th style="font-size:10px;">Gemini Target</th>
                            </tr>
                        </thead>
                        <tbody id="schwabChainBody">
                            <tr>
                                <td colspan="8" style="text-align:center; padding: 24px 16px;">
                                    <div class="ui-loading-box">
                                        <span class="material-symbols-outlined spinner-icon">progress_activity</span>
                                        <span>Loading Schwab Option Chain...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MULTI-API AUDIT STATS GRID -->
            <div class="rpg">
                <div class="card">
                    <h4 style="display:flex; align-items:center; gap:4px;"><span class="material-symbols-outlined" style="font-size:14px; color:var(--blue);">query_stats</span> Wall St. Consensus (Finnhub API)</h4>
                    <div class="row"><span>Mean Target</span><span class="v" id="rpPriceTargetMean">-</span></div>
                    <div class="row"><span>Target Range</span><span class="v" id="rpPriceTargetRange">-</span></div>
                    <div class="row"><span>Analyst Consensus</span><span class="v" id="rpAnalystConsensusVotes">-</span></div>
                    <div class="row"><span>Current Price</span><span class="v" id="rpPrice">-</span></div>
                    <div class="row"><span>Implied Upside</span><span class="v" id="rpUpside">-</span></div>
                </div>
                <div class="card">
                    <h4 style="display:flex; align-items:center; gap:4px;"><span class="material-symbols-outlined" style="font-size:14px; color:var(--yellow);">event</span> Catalysts & Timing (Finnhub Calendar)</h4>
