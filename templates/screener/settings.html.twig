                        {{ _self.cfgSliderRow('api.timeout.broker.transactions', 'Broker History Timeout', 'Timeout in seconds for historical transaction log queries.', config['api.timeout.broker.transactions']|default(10.0), 2, 90, 0.5, 'float', 's') }}
                        {{ _self.cfgSliderRow('api.timeout.finnhub.default', 'Finnhub Default Timeout', 'Timeout in seconds for Finnhub quote and dividend API connections.', config['api.timeout.finnhub.default']|default(3.0), 1, 30, 0.5, 'float', 's') }}
                        {{ _self.cfgSliderRow('broker.option_chain.strike_count', 'Option Strike Count Limit', 'Number of option contract strike prices returned above/below the money.', config['broker.option_chain.strike_count']|default(12), 4, 50, 2, 'integer', ' strikes') }}
                    </div>
