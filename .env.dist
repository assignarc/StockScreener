# ==========================================================================
# MOONSHOT SCREENER v3 — ENVIRONMENT VARIABLES DISTRIBUTION TEMPLATE (.env.dist)
# Copy this file to .env.local and fill in your actual API keys.
# ==========================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=29a5785caed2c35176b39e87b012b193
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Database connection: SQLite for dev, or MySQL / PostgreSQL for production
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/stock_screener?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> finnhub/api-key ###
# Get API key from https://finnhub.io/
FINNHUB_API_KEY="YOUR_FINNHUB_API_KEY_HERE"
###< finnhub/api-key ###

###> schwab/developer-api ###
# Get credentials from https://developer.schwab.com/
SCHWAB_APP_KEY="YOUR_SCHWAB_APP_KEY_HERE"
SCHWAB_APP_SECRET="YOUR_SCHWAB_APP_SECRET_HERE"
SCHWAB_REDIRECT_URI="https://127.0.0.1:8000/api/schwab/callback"
# STRICT SECURITY GUARDRAIL: Set to "true" ONLY to allow placing live order mutations.
SCHWAB_TRADING_ENABLED=false
###< schwab/developer-api ###

###> google/gemini-api ###
# Google Gemini Developer API Settings (https://aistudio.google.com/)
# Models: gemini-1.5-flash (default), gemini-2.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
###< google/gemini-api ###
