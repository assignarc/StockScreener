        </div><!-- /settings-content -->

    </div><!-- /settings-container -->

    <!-- Sticky Save Bar across all settings -->
    <div class="save-bar">
        <span class="save-status" id="saveStatus">No unsaved changes.</span>
        <button class="btn-reset" onclick="resetToDefaults()" id="btnReset" style="display:inline-flex; align-items:center; gap:6px;"><span class="material-symbols-outlined" style="font-size:14px;">undo</span> Reset to Defaults</button>
