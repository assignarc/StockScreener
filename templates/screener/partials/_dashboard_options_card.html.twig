{# templates/screener/partials/_dashboard_options_card.html.twig #}
<!-- EXECUTIVE DASHBOARD OPEN OPTIONS HEALTH CARD -->
<div class="dash-options-widget" id="dashOptionsWidget">
    <div class="dash-opt-header">
        <div class="dash-opt-header-left">
            <h3 class="dash-opt-title">
                <span class="material-symbols-outlined dash-opt-icon">auto_awesome_motion</span>
                <span>Open Options Positions & Moneymaking Health</span>
                <span class="hbadge opt-count-badge">
                    {{ portfolio.optionsSummary.totalPositions|default(0) }} Positions ({{ portfolio.optionsSummary.totalContracts|default(0) }} Contracts)
                </span>
            </h3>
            <div class="dash-opt-desc">
                Real-time moneymaking trajectory analysis based on underlying equity trading prices, strike prices, and assignment risk.
            </div>
        </div>
        <div class="dash-opt-header-right">
            <a href="/portfolio?tab=options" class="hbtn hbtn-blue" style="font-size:12px; padding:6px 14px; display:inline-flex; align-items:center; gap:6px;">
                <span class="material-symbols-outlined" style="font-size:14px;">visibility</span>
                <span>View Full Options Tab →</span>
            </a>
        </div>
    </div>

    <!-- EXECUTIVE QUICK KPI STRIP -->
    <div class="dash-opt-kpi-strip">
        <div class="dash-opt-kpi-pill">
            <span class="material-symbols-outlined" style="font-size:14px; color:var(--blue);">receipt_long</span>
            <span class="dash-opt-kpi-lbl">Total Contracts:</span>
            <strong>{{ portfolio.optionsSummary.totalContracts|default(0) }}</strong>
        </div>
        <div class="dash-opt-kpi-pill">
            <span class="material-symbols-outlined" style="font-size:14px; color:var(--green);">trending_up</span>
            <span class="dash-opt-kpi-lbl">Profitable / On Track:</span>
            <strong class="g">{{ portfolio.optionsSummary.profitRouteCount|default(0) }}</strong>
        </div>
        <div class="dash-opt-kpi-pill">
            <span class="material-symbols-outlined" style="font-size:14px; color:var(--red);">warning</span>
            <span class="dash-opt-kpi-lbl">Below Breakeven:</span>
            <strong class="r">{{ portfolio.optionsSummary.atRiskCount|default(0) }}</strong>
        </div>
        <div class="dash-opt-kpi-pill">
            <span class="material-symbols-outlined" style="font-size:14px; color:var(--green);">payments</span>
            <span class="dash-opt-kpi-lbl">Total Commission:</span>
            <strong class="g">+${{ portfolio.optionsSummary.totalCommissionCollectedStr|default('0.00') }}</strong>
        </div>
        <div class="dash-opt-kpi-pill">
            <span class="material-symbols-outlined" style="font-size:14px; color:var(--yellow);">shield</span>
            <span class="dash-opt-kpi-lbl">Cash Collateral:</span>
            <strong class="y">${{ (portfolio.optionsSummary.totalCashCollateral|default(0))|number_format(0) }}</strong>
        </div>
        <div class="dash-opt-kpi-pill">
            <span class="material-symbols-outlined" style="font-size:14px; color:var(--purple);">lock</span>
            <span class="dash-opt-kpi-lbl">Pledged Shares:</span>
            <strong style="color:var(--purple);">{{ (portfolio.optionsSummary.totalPledgedShares|default(0))|number_format(0) }}</strong>
        </div>
    </div>

    <!-- POSITION CARDS GRID -->
    <div class="dash-opt-cards-grid">
        {% if portfolio.openOptionPositions is defined and portfolio.openOptionPositions|length > 0 %}
            {% for opt in portfolio.openOptionPositions %}
                {% set isProfit = opt.healthStatusCode == 'PROFIT_ROUTE' or opt.healthStatusCode == 'PROFITABLE' %}
                {% set isAtRisk = opt.healthStatusCode == 'AT_RISK' %}
                <div class="dash-opt-card">
                    <!-- CARD HEADER (CLEAN & UNIFORM HEIGHT) -->
                    <div class="dash-opt-card-top">
                        <div class="dash-opt-sym-group">
                            <a href="/screener?symbol={{ opt.root }}" class="dash-opt-sym-link hover-blue" title="Inspect {{ opt.root }} in Screener">
                                {{ opt.root }}
                            </a>
                            <span class="opt-strategy-pill {% if opt.type == 'Call' %}opt-strat-call{% else %}opt-strat-put{% endif %}">
                                <span class="material-symbols-outlined" style="font-size:11px;">{% if opt.type == 'Call' %}arrow_circle_up{% else %}shield{% endif %}</span>
                                {{ opt.strategy }}
                            </span>
                        </div>
                        <div class="dash-opt-health-pill {% if isProfit %}badge-profit{% elseif isAtRisk %}badge-risk{% else %}badge-caution{% endif %}">
                            <span class="material-symbols-outlined" style="font-size:13px;">{{ opt.healthBadgeIcon }}</span>
                            <span>{{ opt.healthBadgeLabel }}</span>
                        </div>
                    </div>

                    <!-- COMPACT 4-CELL METRICS BAR -->
                    <div class="dash-opt-metrics-grid">
                        <div class="dash-opt-m-cell">
                            <div class="dash-opt-m-lbl">Strike vs Stock</div>
                            <div class="dash-opt-m-val">${{ opt.strikeStr }} <span class="opt-quote-sub">(${{ opt.underlyingPriceStr }})</span></div>
                            <div class="dash-opt-m-sub">
                                <span class="dash-opt-dist-pill {% if isProfit %}dist-green{% elseif isAtRisk %}dist-red{% else %}dist-yellow{% endif %}">
                                    {{ opt.distanceStr }}
                                </span>
                            </div>
                        </div>

                        <div class="dash-opt-m-cell">
                            <div class="dash-opt-m-lbl">
                                {% if opt.type == 'Call' %}Stock Basis{% else %}Effective Entry{% endif %}
                            </div>
                            <div class="dash-opt-m-val">
                                {% if opt.type == 'Call' and opt.hasStockHolding %}
                                    ${{ opt.stockCostBasisStr }}
                                {% else %}
                                    ${{ opt.netBreakevenStr }}
                                {% endif %}
                            </div>
                            <div class="dash-opt-m-sub">
                                {% if opt.type == 'Call' and opt.isStrikeBelowCost %}
                                    <span class="r" style="font-weight:700;">Strike < Basis</span>
                                {% elseif opt.type == 'Call' %}
                                    <span class="g">{{ opt.pledgedShares }} Pledged</span>
                                {% else %}
                                    <span class="y">${{ opt.cashCollateralStr }} Cash</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="dash-opt-m-cell">
                            <div class="dash-opt-m-lbl">Net Premium</div>
                            <div class="dash-opt-m-val g">+${{ opt.netCommissionStr }}</div>
                            <div class="dash-opt-m-sub">
                                <span class="opt-fee-text">Gross +${{ opt.grossCommissionStr }} • -${{ opt.totalOptionFeesStr }} fee</span>
                            </div>
                        </div>

                        <div class="dash-opt-m-cell">
                            <div class="dash-opt-m-lbl">
                                {% if opt.type == 'Call' %}Called Away Net{% else %}OTM Profit{% endif %}
                            </div>
                            <div class="dash-opt-m-val {% if opt.totalBottomlineGain >= 0 %}g{% else %}r{% endif %}">
                                {{ opt.totalBottomlineGainStr }}
                            </div>
                            <div class="dash-opt-m-sub">
                                <span class="{% if opt.bottomlineRoiPct >= 0 %}g{% else %}r{% endif %}">
                                    {{ opt.bottomlineRoiPct }}% Net ROI
                                </span>
                            </div>
                        </div>

                        <div class="dash-opt-m-cell">
                            <div class="dash-opt-m-lbl">Position</div>
                            <div class="dash-opt-m-val">{{ opt.quantity }}</div>
                            <div class="dash-opt-m-sub">
                                <span>{{ opt.sharesRepresented }} Shs</span>
                            </div>
                        </div>

                        <div class="dash-opt-m-cell">
                            <div class="dash-opt-m-lbl">Expiration / DTE</div>
                            <div class="dash-opt-m-val" style="font-size:12px;">{{ opt.expiration }}</div>
                            <div class="dash-opt-m-sub">
                                <span class="dash-opt-dte-text">{{ opt.dteText }}</span>
                            </div>
                        </div>
                    </div>

                    <!-- COLLAPSIBLE ANALYSIS & RECOMMENDATION -->
                    <details class="opt-analysis-details">
                        <summary class="opt-analysis-summary">
                            <div class="opt-summary-title">
                                <span class="material-symbols-outlined" style="font-size:14px; color:var(--blue);">analytics</span>
                                <span>Financial Breakdown, Trajectory & Guidance</span>
                            </div>
                            <span class="material-symbols-outlined opt-summary-arrow" style="font-size:14px;">expand_more</span>
                        </summary>
                        
                        <div class="opt-analysis-expanded">
                            <div class="opt-math-box">
                                <div class="opt-math-title">
                                    <span class="material-symbols-outlined" style="font-size:13px; color:var(--blue);">calculate</span>
                                    <span>
                                        {% if opt.type == 'Call' %}
                                            Covered Call Bottomline Math (If Called Away)
                                        {% else %}
                                            Cash-Secured Put Economics & Assignment
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="opt-math-grid">
                                    {% if opt.type == 'Call' and opt.hasStockHolding %}
                                        <div class="opt-math-row">
                                            <span class="opt-m-label">Stock Realized Gain:</span>
                                            <span class="opt-m-calc">{{ opt.sharesRepresented }} shs × (${{ opt.strikeStr }} - ${{ opt.stockCostBasisStr }}) = <strong>{{ opt.totalStockCapGainStr }}</strong></span>
                                        </div>
                                        <div class="opt-math-row">
                                            <span class="opt-m-label">Option Gross Premium:</span>
                                            <span class="opt-m-calc g">+${{ opt.grossCommissionStr }}</span>
                                        </div>
                                        <div class="opt-math-row">
                                            <span class="opt-m-label">Option Contract Trade Fee:</span>
                                            <span class="opt-m-calc r">-${{ opt.totalOptionFeesStr }} <span class="opt-fee-source-tag">({{ opt.feeSource }})</span></span>
                                        </div>
                                        <div class="opt-math-row">
                                            <span class="opt-m-label">Stock Exit Regulatory Fees:</span>
                                            <span class="opt-m-calc r">-${{ opt.stockExitFeesStr }} <span class="opt-fee-source-tag">(SEC + FINRA)</span></span>
                                        </div>
                                        <div class="opt-math-row opt-math-total {% if opt.totalBottomlineGain >= 0 %}math-total-good{% else %}math-total-bad{% endif %}">
                                            <span class="opt-m-label"><strong>Total Net Bottomline:</strong></span>
                                            <span class="opt-m-calc"><strong class="{% if opt.totalBottomlineGain >= 0 %}g{% else %}r{% endif %}">{{ opt.totalBottomlineGainStr }} ({{ opt.bottomlineRoiPct }}% Net ROI)</strong></span>
                                        </div>
                                        <div class="opt-math-row opt-math-footer">
                                            <span class="opt-m-label">Downside Breakeven:</span>
                                            <span class="opt-m-calc"><strong>${{ opt.netBreakevenStr }}/sh</strong> <span style="font-weight:400; color:var(--muted);">({{ opt.breakevenFormula }})</span></span>
                                        </div>
                                    {% else %}
                                        <div class="opt-math-row">
                                            <span class="opt-m-label">Cash Collateral:</span>
                                            <span class="opt-m-calc">${{ opt.cashCollateralStr }}</span>
                                        </div>
                                        <div class="opt-math-row">
                                            <span class="opt-m-label">Option Gross Premium:</span>
                                            <span class="opt-m-calc g">+${{ opt.grossCommissionStr }}</span>
                                        </div>
                                        <div class="opt-math-row">
                                            <span class="opt-m-label">Option Contract Fee:</span>
                                            <span class="opt-m-calc r">-${{ opt.totalOptionFeesStr }} <span class="opt-fee-source-tag">({{ opt.feeSource }})</span></span>
                                        </div>
                                        <div class="opt-math-row opt-math-total math-total-good">
                                            <span class="opt-m-label"><strong>Net Retained Profit:</strong></span>
                                            <span class="opt-m-calc"><strong class="g">+${{ opt.netCommissionStr }} (+{{ opt.bottomlineRoiPct }}% ROC)</strong></span>
                                        </div>
                                        <div class="opt-math-row opt-math-footer">
                                            <span class="opt-m-label">Effective Net Entry if Assigned:</span>
                                            <span class="opt-m-calc"><strong>${{ opt.netBreakevenStr }}/sh</strong> <span style="font-weight:400; color:var(--muted);">({{ opt.breakevenFormula }})</span></span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="opt-analysis-narrative {% if isProfit %}narrative-profit{% elseif isAtRisk %}narrative-risk{% else %}narrative-caution{% endif %}">
                                <div class="opt-narrative-hdr">
                                    <span class="material-symbols-outlined" style="font-size:13px;">
                                        {% if isProfit %}trending_up{% elseif isAtRisk %}report{% else %}help{% endif %}
                                    </span>
                                    <strong>Trajectory Analysis:</strong>
                                </div>
                                <div class="opt-narrative-body">
                                    {{ opt.simpleAnalysis }}
                                </div>
                                {% if opt.actionAdvice %}
                                    <div class="opt-action-line">
                                        <span class="material-symbols-outlined" style="font-size:12px; color:var(--blue);">tips_and_updates</span>
                                        <span><strong>Guidance:</strong> {{ opt.actionAdvice }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </details>

                    <!-- CARD BOTTOM DESCRIPTION & METRICS -->
                    <div class="dash-opt-footer">
                        <div class="dash-opt-foot-desc" title="{{ opt.symbol }}: {{ opt.description }}">
                            <span class="material-symbols-outlined dash-desc-icon">description</span>
                            <span class="dash-opt-desc-text">{{ opt.description }}</span>
                        </div>
                        <div class="dash-opt-foot-right">
                            <span class="dash-opt-foot-acc" title="Account: {{ opt.primaryAccountNickname }}">
                                <span class="material-symbols-outlined">account_balance</span>
                                <span>{{ opt.primaryAccountNickname }}</span>
                            </span>

                            <!-- SCREENER ACTION BUTTON WITH POPOVER -->
                            <div class="opt-btn-popover-wrap">
                                <a href="/screener?symbol={{ opt.root }}" class="opt-foot-icon-btn" aria-label="Open Screener for {{ opt.root }}">
                                    <span class="material-symbols-outlined">bolt</span>
                                </a>
                                <div class="opt-btn-popover">
                                    <div class="opt-pop-title">
                                        <span class="material-symbols-outlined" style="font-size:13px; color:var(--blue);">bolt</span>
                                        <span>Screener Technicals</span>
                                    </div>
                                    <div class="opt-pop-desc">
                                        Analyze {{ opt.root }} technical indicators, options chain, and setup signals in Screener.
                                    </div>
                                </div>
                            </div>

                            <!-- HOLDINGS ACTION BUTTON WITH POPOVER -->
                            <div class="opt-btn-popover-wrap">
                                <a href="/portfolio?tab=holdings&symbol={{ opt.root }}" class="opt-foot-icon-btn" aria-label="View {{ opt.root }} Holdings">
                                    <span class="material-symbols-outlined">work</span>
                                </a>
                                <div class="opt-btn-popover">
                                    <div class="opt-pop-title">
                                        <span class="material-symbols-outlined" style="font-size:13px; color:var(--purple);">work</span>
                                        <span>Equity Holdings</span>
                                    </div>
                                    <div class="opt-pop-desc">
                                        View underlying {{ opt.root }} share lots, average cost basis, and pledged shares in Portfolio.
                                    </div>
                                </div>
                            </div>

                            <!-- OPTIONS TAB DRILLDOWN WITH POPOVER -->
                            <div class="opt-btn-popover-wrap">
                                <a href="/portfolio?tab=options#opt_card_{{ loop.index }}" class="opt-foot-icon-btn" aria-label="Inspect in Options Tab">
                                    <span class="material-symbols-outlined">open_in_new</span>
                                </a>
                                <div class="opt-btn-popover">
                                    <div class="opt-pop-title">
                                        <span class="material-symbols-outlined" style="font-size:13px; color:var(--green);">open_in_new</span>
                                        <span>Options Trajectory Analysis</span>
                                    </div>
                                    <div class="opt-pop-desc">
                                        Open full financial math breakdown, cost basis, and moneymaking trajectory in Portfolio Options Tab.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="opt-empty-box" style="grid-column: 1 / -1; padding: 24px;">
                <span class="material-symbols-outlined opt-empty-icon" style="font-size:32px;">layers_clear</span>
                <h4 style="margin: 6px 0;">No Open Options Positions</h4>
                <p style="margin: 0; font-size:12px; color:var(--muted);">All active positions are 100% in cash or unencumbered equities.</p>
            </div>
        {% endif %}
    </div>
</div>
