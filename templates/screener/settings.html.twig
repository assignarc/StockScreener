                            <div style="font-size:11px; color:var(--muted); text-transform:uppercase; font-weight:700;">Database Storage (data.db)</div>
                            <div style="font-size:20px; font-weight:800; color:var(--yellow);" id="cacheDbSize">{{ cacheStats.databaseSizeKb|default(0) }} KB</div>
