                        {{ _self.cfgDurationRow('cache.ttl.finnhub.earnings', 'Finnhub Earnings TTL', 'Cache lifespan for Finnhub earnings calendar events.', config['cache.ttl.finnhub.earnings']|default(604800)) }}
                        {{ _self.cfgDurationRow('cache.ttl.finnhub.dividends', 'Finnhub Dividends TTL', 'Cache lifespan for Finnhub stock dividend schedules.', config['cache.ttl.finnhub.dividends']|default(2592000)) }}
                        {{ _self.cfgDurationRow('cache.ttl.broker.portfolio', 'Broker Portfolio TTL', 'Cache lifespan for aggregated broker account portfolios & balances.', config['cache.ttl.broker.portfolio']|default(60)) }}
                        {{ _self.cfgDurationRow('cache.ttl.broker.history', 'Broker Account History TTL', 'Cache lifespan for broker account transaction activity log.', config['cache.ttl.broker.history']|default(604800)) }}
