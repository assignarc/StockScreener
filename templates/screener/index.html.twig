{% extends 'base.html.twig' %}

{% block title %}Stock Screener & Options Flywheel — KHAPRE MoonShot Portfolio{% endblock %}

{% block stylesheets %}
<style>
    /* MODAL & OVERLAY */
    #overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.85); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; }
    #overlay.show { display: flex; }

    /* FLYWHEEL CAPITAL ALLOCATOR WIDGET */
    .fw-panel { padding: 14px 24px; background: linear-gradient(135deg, rgba(31,38,55,0.9), rgba(22,27,38,0.95)); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .fw-title { display: flex; align-items: center; gap: 8px; font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 700; color: #e6edf3; }
    .fw-icon { background: rgba(88,166,255,0.15); color: var(--blue); padding: 4px 8px; border-radius: 6px; font-size: 12px; border: 1px solid rgba(88,166,255,0.3); }
    .fw-inputs { display: flex; align-items: center; gap: 12px; }
    .fw-input-wrap { display: flex; align-items: center; background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 4px 10px; }
    .fw-input-wrap span { font-size: 13px; color: var(--muted); margin-right: 4px; font-weight: 600; }
    .fw-input-wrap input { background: transparent; border: none; color: var(--blue); font-size: 13px; font-weight: 700; width: 90px; outline: none; }
    .fw-stats { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .fw-pill { padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 6px; }
    .fw-pill-call { background: rgba(63,185,80,0.15); color: var(--green); border: 1px solid rgba(63,185,80,0.3); }
    .fw-pill-wheel { background: rgba(210,153,34,0.15); color: var(--yellow); border: 1px solid rgba(210,153,34,0.3); }
    .fw-pill-put { background: rgba(248,81,73,0.15); color: var(--red); border: 1px solid rgba(248,81,73,0.3); }

    /* CONTROLS */
    .controls { padding: 12px 24px; display: flex; gap: 8px; flex-wrap: wrap; border-bottom: 1px solid var(--border); align-items: center; background: var(--bg); }
    .fbtn { padding: 6px 14px; border: 1px solid var(--border); border-radius: 7px; background: transparent; color: var(--muted); cursor: pointer; font-size: 12px; font-weight: 500; transition: all 0.15s; }
    .fbtn:hover { border-color: var(--muted); color: var(--text); }
    .fbtn.active { border-color: var(--blue); color: var(--blue); background: var(--accent-glow); font-weight: 600; }
    
    .sig-btn { padding: 6px 14px; border: 1px solid var(--border); border-radius: 7px; background: var(--bg3); color: var(--text); cursor: pointer; font-size: 12px; font-weight: 600; transition: all 0.15s; }
    .sig-btn.active-all { border-color: var(--blue); background: rgba(88,166,255,0.15); color: var(--blue); }
    .sig-btn.active-call { border-color: var(--green); background: rgba(63,185,80,0.15); color: var(--green); }
    .sig-btn.active-put { border-color: var(--red); background: rgba(248,81,73,0.15); color: var(--red); }
    .sig-btn.active-wheel { border-color: var(--yellow); background: rgba(210,153,34,0.15); color: var(--yellow); }

    select.fsel { padding: 6px 12px; background: var(--bg3); border: 1px solid var(--border); color: var(--text); border-radius: 7px; font-size: 12px; outline: none; }
    .sp { flex: 1; }
    #srch { padding: 6px 14px; background: var(--bg3); border: 1px solid var(--border); color: var(--text); border-radius: 7px; font-size: 12px; width: 180px; outline: none; transition: all 0.2s; }
    #srch:focus { border-color: var(--blue); box-shadow: 0 0 0 2px var(--accent-glow); }

    /* STATUS & STATS BAR */
    #statusBar { padding: 10px 24px; font-size: 12px; color: var(--muted); border-bottom: 1px solid var(--border); min-height: 38px; display: flex; align-items: center; gap: 10px; background: var(--bg2); }
    .sbar { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; border-bottom: 1px solid var(--border); background: var(--border); }
    .sc { padding: 14px 20px; background: var(--bg); text-align: center; }
    .sc .v { font-family: 'Outfit', sans-serif; font-size: 22px; font-weight: 700; color: var(--blue); }
    .sc .l { font-size: 11px; color: var(--muted); margin-top: 2px; text-transform: uppercase; letter-spacing: .5px; font-weight: 600; }

    /* TABLE */
    #tw { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    th { padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); border-bottom: 1px solid var(--border); background: var(--bg2); white-space: nowrap; cursor: pointer; user-select: none; }
    th:hover { color: var(--text); }
    td { padding: 11px 14px; border-bottom: 1px solid rgba(46,53,69,.5); vertical-align: middle; white-space: nowrap; font-size: 13px; }
    tr:hover td { background: rgba(255,255,255,.02); cursor: pointer; }
    .g { color: var(--green); font-weight: 600; }
    .r { color: var(--red); font-weight: 600; }
    .y { color: var(--yellow); }
    .m { color: var(--muted); }
    .rb { padding: 3px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; }
    .rLOW { background: rgba(63,185,80,.15); color: var(--green); }
    .rMED { background: rgba(210,153,34,.15); color: var(--yellow); }
    .rHIGH { background: rgba(248,81,73,.15); color: var(--red); }
    
    .badge-sig { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; display: inline-block; letter-spacing: 0.3px; }
    .badge-CALL { background: rgba(63,185,80,0.18); color: #3fb950; border: 1px solid rgba(63,185,80,0.4); }
    .badge-PUT { background: rgba(248,81,73,0.18); color: #f85149; border: 1px solid rgba(248,81,73,0.4); }
    .badge-WHEEL { background: rgba(210,153,34,0.18); color: #d29922; border: 1px solid rgba(210,153,34,0.4); }

    .wstar { cursor: pointer; font-size: 15px; color: var(--muted); margin-right: 6px; transition: color 0.15s; }
    .wstar.active { color: var(--yellow); }

    /* RESEARCH PANEL */
    #rp { position: fixed; bottom: 0; left: 0; right: 0; height: 0; background: var(--bg2); border-top: 2px solid var(--border); transition: height 0.3s cubic-bezier(0.16, 1, 0.3, 1); overflow: hidden; z-index: 500; box-shadow: 0 -10px 30px rgba(0,0,0,0.5); }
    #rp.open { height: 72vh; }
    .rph { display: flex; align-items: center; gap: 12px; padding: 14px 24px; border-bottom: 1px solid var(--border); background: var(--bg3); }
    .rph h3 { font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 700; }
    .rpx { margin-left: auto; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
    .rpx:hover { background: var(--border); color: var(--text); }
    .rpb { padding: 20px 24px; height: calc(100% - 58px); overflow-y: auto; }
    .rpg { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .card { background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
    .card h4 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); margin-bottom: 12px; }
    .row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid rgba(46,53,69,.5); font-size: 12px; }
    .row:last-child { border: none; }
    .row .v { font-weight: 600; }
    .tb { background: var(--bg3); border-radius: 8px; padding: 14px; margin-bottom: 12px; font-size: 12px; line-height: 1.6; border: 1px solid var(--border); }
    .tb h4 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); margin-bottom: 6px; }

    /* COLUMN POPOVER TOOLTIPS */
    th { position: relative; }
    .col-popover-trigger { display: inline-flex; align-items: center; justify-content: center; width: 15px; height: 15px; border-radius: 50%; background: rgba(88,166,255,0.15); color: var(--blue); font-size: 10px; font-weight: 700; margin-left: 4px; cursor: help; border: 1px solid rgba(88,166,255,0.3); transition: all 0.15s ease; vertical-align: middle; }
    .col-popover-trigger:hover { background: var(--blue); color: #0b0e14; }
    .col-popover { position: absolute; top: calc(100% + 6px); left: 50%; transform: translateX(-50%); width: 230px; padding: 10px 12px; background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 12px 30px rgba(0,0,0,0.8); font-size: 11px; font-weight: 400; line-height: 1.45; color: var(--text); white-space: normal; text-transform: none; letter-spacing: normal; z-index: 1000; display: none; pointer-events: none; }
    .col-popover::before { content: ''; position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); border: 5px solid transparent; border-bottom-color: var(--border); }
    .col-popover-trigger:hover .col-popover, .col-popover-trigger:focus .col-popover { display: block; }
    .col-popover-title { font-weight: 700; color: var(--blue); margin-bottom: 4px; display: flex; align-items: center; gap: 4px; font-size: 11px; }

    @media (max-width: 900px) {
        .sbar { grid-template-columns: 1fr 1fr; }
        .rpg { grid-template-columns: 1fr; }
        .fw-panel { flex-direction: column; align-items: flex-start; }
    }
</style>
{% endblock %}

{% block body %}
<!-- APP DASHBOARD -->
<div id="app">
    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '⚡ Capital Flywheel <span>Stock Screener</span>',
        headerBadge: 'v3 Options Engine',
        showLiveLoadBtn: true
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <!-- PAGE 1 CONTENT: STOCK SCREENER -->
    <div id="screenerView">
        <!-- FLYWHEEL CAPITAL ALLOCATOR WIDGET -->
        <div class="fw-panel">
            <div class="fw-title">
                <span class="fw-icon">⚙ CAPITAL FLYWHEEL</span>
                <span>Portfolio Allocation Engine</span>
            </div>
            <div class="fw-inputs">
                <div class="fw-input-wrap">
                    <span>$</span>
                    <input id="totalCap" type="number" value="10000" step="1000" oninput="updateFlywheelAllocation()">
                </div>
            </div>
            <div class="fw-stats">
                <div class="fw-pill fw-pill-call">
                    <span>🟢 CALLs (60%):</span>
                    <span id="allocCallVal">$6,000</span>
                </div>
                <div class="fw-pill fw-pill-wheel">
                    <span>🟡 WHEEL (25%):</span>
                    <span id="allocWheelVal">$2,500</span>
                </div>
                <div class="fw-pill fw-pill-put">
                    <span>🔴 PUTs (15%):</span>
                    <span id="allocPutVal">$1,500</span>
                </div>
            </div>
        </div>

        <!-- OPTIONS LEVEL 1 BASIC STRATEGY BANNER -->
        <div style="padding: 12px 24px; background: rgba(88,166,255,0.06); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="rb rLOW" style="background: rgba(88,166,255,0.2); color: var(--blue);">🔒 OPTION LEVEL 1 BASIC (100% COVERED / RISK DEFINED)</span>
                <span style="font-size: 12px; color: var(--text);">
                    Allocating your <strong style="color:var(--green);" id="playbookCashText">$25,143 available cash</strong> into 100% Covered & Capped-Risk strategies:
                </span>
            </div>
            <div style="display: flex; gap: 12px; font-size: 11px; font-weight: 600;">
                <span style="color:var(--green);">🟢 Defined-Risk Long CALLS</span>
                <span style="color:var(--yellow);">🟡 Cash-Secured PUTS</span>
                <span style="color:var(--purple);">💼 Covered CALLS</span>
            </div>
        </div>

        <!-- CONTROLS & SIGNAL FILTERS -->
        <div class="controls">
            <!-- Signal Filter Group -->
            <button class="sig-btn active-all" onclick="filterSignal('ALL', this)">All Signals</button>
            <button class="sig-btn" onclick="filterSignal('CALL', this)">🟢 CALLs (Growth)</button>
            <button class="sig-btn" onclick="filterSignal('PUT', this)">🔴 PUTs (Hedge)</button>
            <button class="sig-btn" onclick="filterSignal('WHEEL', this)">🟡 WHEEL (Income)</button>

            <span style="border-left: 1px solid var(--border); height: 20px; margin: 0 6px;"></span>

            <button class="fbtn active" onclick="filterSector('ALL', this)">All Sectors</button>
            {% for sector in sectors %}
                <button class="fbtn" onclick="filterSector('{{ sector }}', this)">{{ sector }}</button>
            {% endfor %}
            <span class="sp"></span>
            <select class="fsel" onchange="filterRisk(this.value)">
                <option value="ALL">All Risk Levels</option>
                <option value="LOW">Low Risk</option>
                <option value="MED">Med Risk</option>
                <option value="HIGH">High Risk</option>
            </select>
            <input id="srch" placeholder="Search Ticker, Name..." oninput="onSearchInput()">
        </div>

        <!-- STATUS BAR -->
        <div id="statusBar">Loaded {{ totalStocks }} curated candidates from Doctrine database.</div>

        <!-- STATS OVERVIEW -->
        <div class="sbar">
            <div class="sc"><div class="v" id="statCount">{{ totalStocks }}</div><div class="l">Tracked Stocks</div></div>
            <div class="sc"><div class="v" id="statCallsCount">—</div><div class="l">🟢 CALL Signals</div></div>
            <div class="sc"><div class="v" id="statPutsCount">—</div><div class="l">🔴 PUT Signals</div></div>
            <div class="sc"><div class="v" id="statWheelCount">—</div><div class="l">🟡 WHEEL Signals</div></div>
        </div>

        <!-- TABLE WRAPPER -->
        <div id="tw">
            <table>
                <thead>
                    <tr>
                        <th onclick="sortTable('symbol')">
                            <span>Ticker</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">📌 Stock Ticker Symbol</div>
                                    Queried from local SQLite/Doctrine database (<code>Stock::$symbol</code>), cross-referenced against Finnhub API and connected Schwab account holdings.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('name')">
                            <span>Company</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">🏢 Company Name</div>
                                    Fetched live from Finnhub API company profile endpoint (<code>/api/v1/stock/profile2</code>).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('signal')">
                            <span>Flywheel Signal</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">⚙ Option Signal</div>
                                    Evaluated real-time by <code>FlywheelService</code>. Evaluates fundamental score (&ge;70, &lt;45), upside %, and risk to classify Level 1 Basic option strategies (🟢 CALL, 🟡 WHEEL, 🔴 PUT).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('sector')">
                            <span>Sector</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">🌐 Industry Sector</div>
                                    Retrieved from Finnhub API industry classification field (<code>finnhubIndustry</code>).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('price')">
                            <span>Price</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">💲 Current Market Price</div>
                                    Live current market quote (<code>c</code>) streamed from Finnhub API (<code>/api/v1/quote</code>) or Schwab Developer API market data.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('targetPrice')">
                            <span>Target</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">🎯 12M Analyst Target</div>
                                    Aggregated 12-month Wall Street consensus analyst price target from Finnhub consensus endpoint & database baseline.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('upside')">
                            <span>Upside</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">📈 Implied Upside %</div>
                                    Calculated dynamically in frontend JS: <code>((TargetPrice - Price) / Price) * 100</code>.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('revGrowth')">
                            <span>Rev Growth</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">📊 Revenue Growth Rate</div>
                                    Pulled from quarterly SEC earnings filings & Finnhub fundamentals data (<code>revGrowth</code> field).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('risk')">
                            <span>Risk</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">⚡ Volatility Risk Level</div>
                                    Assigned based on 30-day historical beta, market capitalization tier, and price volatility range (<code>LOW</code>, <code>MED</code>, <code>HIGH</code>).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('score')">
                            <span>Score</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title">⭐ Fundamental Score (0-100)</div>
                                    Proprietary 0-100 score calculated by evaluating revenue growth rate, gross margin %, cash runway months, and analyst ratings.
                                </span>
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody id="stockTableBody">
                    <!-- Javascript populated rows -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- RESEARCH PANEL DRAWER -->
<div id="rp">
    <div class="rph">
        <h3 id="rpTitle">Stock Research & Analysis</h3>
        <button class="rpx" onclick="closeResearchPanel()">✕</button>
    </div>
    <div class="rpb">
        <!-- FLYWHEEL OPTIONS MATRIX CARD -->
        <div class="tb" style="background: linear-gradient(135deg, rgba(31,38,55,0.95), rgba(22,27,38,0.98)); border-color: rgba(88,166,255,0.4); margin-bottom: 18px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px;">
                <h4 style="color:var(--blue); font-size: 12px;">⚙ Capital Flywheel Options Recommendation</h4>
                <span id="rpSignalBadge" class="badge-sig badge-CALL">🟢 CALL</span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; font-size: 12px;">
                <div><span class="m">Strategy: </span><strong id="rpStrategy" style="color:#e6edf3;">-</strong></div>
                <div><span class="m">Target Strike: </span><strong id="rpStrike" class="g">-</strong></div>
                <div><span class="m">Horizon (DTE): </span><strong id="rpHorizon" style="color:var(--purple);">-</strong></div>
                <div><span class="m">Risk / Reward Ratio: </span><strong id="rpRiskReward" class="y">-</strong></div>
                <div style="grid-column: 1 / -1;"><span class="m">Flywheel Role: </span><strong id="rpFlywheelRole" style="color:var(--blue);">-</strong></div>
            </div>
        </div>

        <!-- SCHWAB LIVE OPTION CHAIN MATRIX -->
        <div class="tb" style="background: var(--bg3); border-color: var(--border); margin-bottom: 18px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px;">
                <h4 style="color:var(--purple); font-size: 11px;">🏦 Schwab Developer API — Live Option Chain</h4>
                <span id="schwabSourceBadge" class="rb rLOW">Schwab API Connected</span>
            </div>
            <div style="overflow-x: auto;">
                <table style="width:100%; font-size: 11px;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--border);">
                            <th style="font-size:10px;">Type</th>
                            <th style="font-size:10px;">Strike ($)</th>
                            <th style="font-size:10px;">Bid ($)</th>
                            <th style="font-size:10px;">Ask ($)</th>
                            <th style="font-size:10px;">IV (%)</th>
                            <th style="font-size:10px;">Delta (Δ)</th>
                            <th style="font-size:10px;">Theta (Θ)</th>
                        </tr>
                    </thead>
                    <tbody id="schwabChainBody">
                        <tr><td colspan="7" style="text-align:center;" class="m">Loading Schwab Option Chain...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="rpg">
            <div class="card">
                <h4>Valuation & Target</h4>
                <div class="row"><span>Current Price</span><span class="v" id="rpPrice">-</span></div>
                <div class="row"><span>Target Price</span><span class="v" id="rpTarget">-</span></div>
                <div class="row"><span>Implied Upside</span><span class="v" id="rpUpside">-</span></div>
                <div class="row"><span>Market Cap</span><span class="v" id="rpMarketCap">-</span></div>
                <div class="row"><span>Analyst Rating</span><span class="v" id="rpRating">-</span></div>
            </div>
            <div class="card">
                <h4>Financial Health</h4>
                <div class="row"><span>Revenue Growth</span><span class="v" id="rpRevGrowth">-</span></div>
                <div class="row"><span>Gross Margin</span><span class="v" id="rpGrossMargin">-</span></div>
                <div class="row"><span>Cash Runway</span><span class="v" id="rpCashRunway">-</span></div>
                <div class="row"><span>Short Interest</span><span class="v" id="rpShortInt">-</span></div>
                <div class="row"><span>Score</span><span class="v" id="rpScore">-</span></div>
            </div>
            <div class="card">
                <h4>Price vs Target Visualization</h4>
                <div style="position:relative;height:160px;">
                    <canvas id="rpChart"></canvas>
                </div>
            </div>
        </div>

        <div style="margin-top:16px;">
            <div class="tb">
                <h4>Investment Thesis</h4>
                <p id="rpThesis">-</p>
            </div>
            <div class="tb">
                <h4>Key Catalysts</h4>
                <p id="rpCatalysts">-</p>
            </div>
            <div class="tb">
                <h4>Risk Factors</h4>
                <p id="rpRisks">-</p>
            </div>
        </div>
    </div>
