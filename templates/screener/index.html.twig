{% extends 'base.html.twig' %}

{% block title %}Stock Screener & Options Flywheel — MoonShot Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/screener_index.css') }}">
{% endblock %}

{% block body %}
<!-- APP DASHBOARD -->
<div id="app">
    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined" style="vertical-align:middle; font-size:22px; color:var(--yellow);">bolt</span> Capital Flywheel <span>Stock Screener</span>',
        headerBadge: 'v3 Options Engine',
        showLiveLoadBtn: true
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <!-- PAGE 1 CONTENT: STOCK SCREENER -->
    <div id="screenerView">
        <!-- FLYWHEEL CAPITAL ALLOCATOR WIDGET -->
        <div class="fw-panel">
            <div class="fw-title">
                <span class="fw-icon"><span class="material-symbols-outlined" style="font-size:18px; vertical-align:middle; color:var(--blue);">tune</span> CAPITAL FLYWHEEL</span>
                <span>Portfolio Allocation Engine</span>
            </div>
            <div class="fw-inputs">
                <div class="fw-input-wrap">
                    <span>$</span>
                    <input id="totalCap" type="number" value="10000" step="1000" oninput="updateFlywheelAllocation()">
                </div>
            </div>
            <div class="fw-stats">
                <div class="fw-pill fw-pill-call">
                    <span>CALLs (60%):</span>
                    <span id="allocCallVal">$6,000</span>
                </div>
                <div class="fw-pill fw-pill-wheel">
                    <span>WHEEL (25%):</span>
                    <span id="allocWheelVal">$2,500</span>
                </div>
                <div class="fw-pill fw-pill-put">
                    <span>PUTs (15%):</span>
                    <span id="allocPutVal">$1,500</span>
                </div>
            </div>
        </div>

        <!-- OPTIONS LEVEL 1 BASIC STRATEGY BANNER -->
        <div class="screener-level1-banner">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="strategy-badge">
                    <span class="material-symbols-outlined" style="font-size:14px;">lock</span> OPTION LEVEL 1 BASIC (100% COVERED / RISK DEFINED)
                </span>
                <span style="font-size: 12px; color: var(--text);">
                    Allocating your <strong style="color:var(--green);" id="playbookCashText">{% if portfolio.availableCash is defined %}${{ portfolio.availableCash|number_format(2) }}{% else %}$0.00{% endif %} available cash</strong> into 100% Covered & Capped-Risk strategies:
                </span>
            </div>
            <div class="strategy-items-list">
                <span class="strategy-item item-call"><span class="material-symbols-outlined" style="font-size:14px;">trending_up</span> Defined-Risk Long CALLS</span>
                <span class="strategy-item item-wheel"><span class="material-symbols-outlined" style="font-size:14px;">sync_alt</span> Cash-Secured PUTS</span>
                <span class="strategy-item item-put"><span class="material-symbols-outlined" style="font-size:14px;">shield</span> Covered CALLS</span>
            </div>
        </div>

        <!-- MODERN COMMAND BAR & FILTER RIBBON -->
        <div class="screener-command-bar">
            <!-- ROW 1: SEARCH, STRATEGY SIGNAL SEGMENTED CONTROL & QUICK METRICS -->
            <div class="cmd-row-primary">
                <!-- INSTANT SEARCH INPUT -->
                <div class="cmd-search-wrap">
                    <span class="material-symbols-outlined cmd-search-icon">search</span>
                    <input id="srch" class="cmd-search-input" placeholder="Search ticker, company name, sector..." oninput="onSearchInput()">
                    <button class="cmd-search-clear" onclick="document.getElementById('srch').value=''; onSearchInput();" title="Clear Search">
                        <span class="material-symbols-outlined" style="font-size:14px;">close</span>
                    </button>
                </div>

                <!-- STRATEGY SIGNAL SEGMENTED TRACK -->
                <div class="cmd-segment-group">
                    <span class="cmd-label"><span class="material-symbols-outlined" style="font-size:14px; color:var(--purple);">tune</span> Signal:</span>
                    <div class="cmd-track">
                        <button class="cmd-tab sig-btn active-all" onclick="filterSignal('ALL', this)">
                            <span class="material-symbols-outlined" style="font-size:14px;">apps</span>
                            <span>All Signals</span>
                        </button>
                        <button class="cmd-tab sig-btn" onclick="filterSignal('CALL', this)">
                            <span class="material-symbols-outlined" style="font-size:14px; color:var(--green);">trending_up</span>
                            <span>CALL (Growth)</span>
                        </button>
                        <button class="cmd-tab sig-btn" onclick="filterSignal('WHEEL', this)">
                            <span class="material-symbols-outlined" style="font-size:14px; color:var(--yellow);">sync_alt</span>
                            <span>WHEEL (Income)</span>
                        </button>
                        <button class="cmd-tab sig-btn" onclick="filterSignal('PUT', this)">
                            <span class="material-symbols-outlined" style="font-size:14px; color:var(--red);">shield</span>
                            <span>PUT (Hedge)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ROW 2: SECTOR PILL CAROUSEL & RISK FILTER DROPDOWN -->
            <div class="cmd-row-secondary">
                <div class="cmd-sector-ribbon">
                    <span class="cmd-label"><span class="material-symbols-outlined" style="font-size:14px; color:var(--blue);">category</span> Sector:</span>
                    <div class="cmd-chips-scroll">
                        <button class="cmd-chip fbtn active" onclick="filterSector('ALL', this)">All Sectors</button>
                        {% for sector in sectors %}
                            <button class="cmd-chip fbtn" onclick="filterSector('{{ sector }}', this)">{{ sector }}</button>
                        {% endfor %}
                    </div>
                </div>

                <!-- RISK LEVEL FILTER SELECTOR -->
                <div class="cmd-filter-right">
                    <div class="cmd-select-wrap">
                        <span class="material-symbols-outlined" style="font-size:14px; color:var(--muted);">speed</span>
                        <select class="cmd-select" onchange="filterRisk(this.value)">
                            <option value="ALL">All Volatility / Risk Levels</option>
                            <option value="LOW">Low Volatility (Conservative)</option>
                            <option value="MED">Medium Risk (Balanced)</option>
                            <option value="HIGH">High Volatility (Aggressive)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- STATUS BAR -->
        <div id="statusBar">Loaded {{ totalStocks }} curated candidates from Doctrine database.</div>

        <!-- STATS OVERVIEW -->
        <div class="sbar">
            <div class="sc"><div class="v" id="statCount">{{ totalStocks }}</div><div class="l">Tracked Stocks</div></div>
            <div class="sc"><div class="v" id="statCallsCount">—</div><div class="l">CALL Signals</div></div>
            <div class="sc"><div class="v" id="statPutsCount">—</div><div class="l">PUT Signals</div></div>
            <div class="sc"><div class="v" id="statWheelCount">—</div><div class="l">WHEEL Signals</div></div>
        </div>

        <!-- TABLE WRAPPER -->
        <div id="tw">
            <table>
                <thead>
                    <tr>
                        <th onclick="sortTable('symbol')">
                            <span>Ticker</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">pin</span> Stock Ticker Symbol</div>
                                    Queried from local SQLite/Doctrine database (<code>Stock::$symbol</code>), cross-referenced against Finnhub API and connected Schwab account holdings.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('name')">
                            <span>Company</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">business</span> Company Name</div>
                                    Fetched live from Finnhub API company profile endpoint (<code>/api/v1/stock/profile2</code>).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('signal')">
                            <span>Flywheel Signal</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">settings</span> Option Signal</div>
                                    Evaluated real-time by <code>FlywheelService</code>. Evaluates fundamental score (&ge;70, &lt;45), upside %, and risk to classify Level 1 Basic option strategies (<span class="material-symbols-outlined" style="font-size:12px;vertical-align:middle;color:var(--green);">check_circle</span> CALL, <span class="material-symbols-outlined" style="font-size:12px;vertical-align:middle;color:var(--yellow);">warning</span> WHEEL, <span class="material-symbols-outlined" style="font-size:12px;vertical-align:middle;color:var(--red);">error</span> PUT).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('sector')">
                            <span>Sector</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">public</span> Industry Sector</div>
                                    Retrieved from Finnhub API industry classification field (<code>finnhubIndustry</code>).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('price')">
                            <span>Price</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">attach_money</span> Current Market Price</div>
                                    Live current market quote (<code>c</code>) streamed from Finnhub API (<code>/api/v1/quote</code>) or Schwab Developer API market data.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('targetPrice')">
                            <span>Target</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">my_location</span> 12M Analyst Target</div>
                                    Aggregated 12-month Wall Street consensus analyst price target from Finnhub consensus endpoint & database baseline.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('upside')">
                            <span>Upside</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">trending_up</span> Implied Upside %</div>
                                    Calculated dynamically in frontend JS: <code>((TargetPrice - Price) / Price) * 100</code>.
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('revGrowth')">
                            <span>Rev Growth</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">bar_chart</span> Revenue Growth Rate</div>
                                    Pulled from quarterly SEC earnings filings & Finnhub fundamentals data (<code>revGrowth</code> field).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('risk')">
                            <span>Risk</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">bolt</span> Volatility Risk Level</div>
                                    Assigned based on 30-day historical beta, market capitalization tier, and price volatility range (<code>LOW</code>, <code>MED</code>, <code>HIGH</code>).
                                </span>
                            </span>
                        </th>
                        <th onclick="sortTable('score')">
                            <span>Score</span>
                            <span class="col-popover-trigger" tabindex="0">ℹ
                                <span class="col-popover">
                                    <div class="col-popover-title" style="display:flex;align-items:center;gap:4px;"><span class="material-symbols-outlined" style="font-size:14px;">star</span> Fundamental Score (0-100)</div>
                                    Proprietary 0-100 score calculated by evaluating revenue growth rate, gross margin %, cash runway months, and analyst ratings.
                                </span>
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody id="stockTableBody">
                    <!-- Javascript populated rows -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- RESEARCH PANEL DRAWER -->
<div id="rp">
    <div class="rph">
        <h3 id="rpTitle">Stock Research & Analysis</h3>
        <button class="rpx" onclick="closeResearchPanel()"><span class="material-symbols-outlined" style="font-size:18px;">close</span></button>
    </div>
    <div class="rpb">
        <!-- FLYWHEEL OPTIONS MATRIX CARD -->
        <div class="fw-rec-card">
            <div class="fw-rec-header">
                <h4 class="fw-rec-title"><span class="material-symbols-outlined" style="font-size:16px;">settings</span> Capital Flywheel Options Recommendation</h4>
                <span id="rpSignalBadge" class="badge-sig badge-CALL">CALL</span>
            </div>
            <div class="fw-rec-grid">
                <div><span class="m">Strategy: </span><strong id="rpStrategy">-</strong></div>
                <div><span class="m">Target Strike: </span><strong id="rpStrike" class="g">-</strong></div>
                <div><span class="m">Horizon (DTE): </span><strong id="rpHorizon" style="color:var(--purple);">-</strong></div>
                <div><span class="m">Risk / Reward Ratio: </span><strong id="rpRiskReward" class="y">-</strong></div>
                <div class="fw-rec-full"><span class="m">Flywheel Role: </span><strong id="rpFlywheelRole" style="color:var(--blue);">-</strong></div>
            </div>
        </div>

        <!-- LIVE OPTION CHAIN MATRIX -->
        <div class="tb" style="background: var(--bg3); border-color: var(--border); margin-bottom: 18px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px;">
                <h4 style="color:var(--purple); font-size: 11px; display:flex; align-items:center; gap:6px;"><span class="material-symbols-outlined" style="font-size:16px;">account_balance</span> Broker API — Live Option Chain</h4>
                <span id="schwabSourceBadge" class="rb rLOW">Broker API Connected</span>
            </div>
            <div style="overflow-x: auto;">
                <table style="width:100%; font-size: 11px;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--border);">
                            <th style="font-size:10px;">Type</th>
                            <th style="font-size:10px;">Strike ($)</th>
                            <th style="font-size:10px;">Bid ($)</th>
                            <th style="font-size:10px;">Ask ($)</th>
                            <th style="font-size:10px;">IV (%)</th>
                            <th style="font-size:10px;">Delta (Δ)</th>
                            <th style="font-size:10px;">Theta (Θ)</th>
                        </tr>
                    </thead>
                    <tbody id="schwabChainBody">
                        <tr>
                            <td colspan="7" style="text-align:center; padding: 24px 16px;">
                                <div class="ui-loading-box">
                                    <span class="material-symbols-outlined spinner-icon">progress_activity</span>
                                    <span>Loading Schwab Option Chain...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="rpg">
            <div class="card">
                <h4>Valuation & Target</h4>
                <div class="row"><span>Current Price</span><span class="v" id="rpPrice">-</span></div>
                <div class="row"><span>Target Price</span><span class="v" id="rpTarget">-</span></div>
                <div class="row"><span>Implied Upside</span><span class="v" id="rpUpside">-</span></div>
                <div class="row"><span>Market Cap</span><span class="v" id="rpMarketCap">-</span></div>
                <div class="row"><span>Analyst Rating</span><span class="v" id="rpRating">-</span></div>
            </div>
            <div class="card">
                <h4>Financial Health</h4>
                <div class="row"><span>Revenue Growth</span><span class="v" id="rpRevGrowth">-</span></div>
                <div class="row"><span>Gross Margin</span><span class="v" id="rpGrossMargin">-</span></div>
                <div class="row"><span>Cash Runway</span><span class="v" id="rpCashRunway">-</span></div>
                <div class="row"><span>Short Interest</span><span class="v" id="rpShortInt">-</span></div>
                <div class="row"><span>Score</span><span class="v" id="rpScore">-</span></div>
            </div>
            <div class="card">
                <h4>Price vs Target Visualization</h4>
                <div style="position:relative;height:160px;">
                    <canvas id="rpChart"></canvas>
                </div>
            </div>
        </div>

        <div style="margin-top:16px;">
            <div class="tb">
                <h4>Investment Thesis</h4>
                <p id="rpThesis">-</p>
            </div>
            <div class="tb">
                <h4>Key Catalysts</h4>
                <p id="rpCatalysts">-</p>
            </div>
            <div class="tb">
                <h4>Risk Factors</h4>
                <p id="rpRisks">-</p>
            </div>
        </div>
    </div>
</div>

{% include 'screener/partials/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/screener.js') }}"></script>
{% endblock %}
