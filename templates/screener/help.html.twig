{% extends 'base.html.twig' %}

{% block title %}API Keys, Broker Integrations & Strategy Guide — MoonShot Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/help.css') }}">
{% endblock %}

{% block body %}
<div id="app">
    <!-- BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined" style="color:var(--blue); font-size:24px;">menu_book</span> API & Broker <span>Setup Guide</span>',
        headerBadge: 'Knowledge Hub'
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <div class="help-container">
        
        <!-- EXPLANATORY HERO BANNER -->
        <div class="help-hero">
            <div class="help-hero-left">
                <h1 class="help-hero-title">
                    <span class="material-symbols-outlined" style="color: var(--blue); font-size: 28px;">school</span>
                    API Keys, Broker Integrations & Strategy Guide
                </h1>
                <p class="help-hero-subtitle">
                    Comprehensive setup instructions for multi-broker authentication (Schwab, Tastytrade, IBKR, Alpaca), market data feeds (Finnhub), LLM intelligence routers (Google Gemini, Anthropic, OpenAI), and Flywheel capital allocation formulas.
                </p>
            </div>
            <div class="help-hero-actions">
                <a href="/setup" class="hbtn" style="background: var(--bg1); border: 1px solid var(--border); color: var(--text);">
                    <span class="material-symbols-outlined">auto_fix_high</span>
                    Setup Wizard
                </a>
                <a href="/settings" class="hbtn" style="background: linear-gradient(135deg, var(--blue), var(--purple)); color: #fff;">
                    <span class="material-symbols-outlined">tune</span>
                    Config & Signals
                </a>
            </div>
        </div>

        <!-- FILTER PILLS -->
        <div class="help-nav-pills">
            <button class="help-pill-btn active" onclick="filterHelpCategory('all')">
                <span class="material-symbols-outlined">dashboard</span> All Guides
            </button>
            <button class="help-pill-btn" onclick="filterHelpCategory('broker')">
                <span class="material-symbols-outlined">account_balance</span> Broker Integrations
            </button>
            <button class="help-pill-btn" onclick="filterHelpCategory('market-data')">
                <span class="material-symbols-outlined">database</span> Market Data
            </button>
            <button class="help-pill-btn" onclick="filterHelpCategory('ai')">
                <span class="material-symbols-outlined">smart_toy</span> AI Providers
            </button>
            <button class="help-pill-btn" onclick="filterHelpCategory('strategy')">
                <span class="material-symbols-outlined">bolt</span> Flywheel Strategy
            </button>
        </div>

        <!-- HELP GRID -->
        <div class="help-grid">
            
            <!-- SECTION 1: BROKER CONNECTIONS -->
            <div class="help-card" data-category="broker">
                <div class="help-card-header">
                    <h2 class="help-card-title">
                        <span class="material-symbols-outlined" style="color: var(--blue);">account_balance</span>
                        Brokerage Integrations
                    </h2>
                    <span class="hbadge badge-blue">Multi-Node API</span>
                </div>
                
                <div class="help-card-body">
                    <!-- Schwab -->
                    <div class="help-guide-block border-blue">
                        <div class="help-guide-header">
                            <span class="help-guide-title">
                                <span class="material-symbols-outlined" style="color: var(--blue);">lock</span>
                                Charles Schwab Developer API
                            </span>
                            <span class="hbadge badge-blue">OAuth 2.0</span>
                        </div>
                        <p class="help-guide-desc">Secure token authentication with Charles Schwab for balances, positions, orders, and options chains.</p>
                        <ol class="help-steps-list">
                            <li>Register at the <a href="https://developer.schwab.com/" target="_blank" rel="noopener">Schwab Developer Portal</a>.</li>
                            <li>Create a new application inside the "Apps" dashboard.</li>
                            <li>Set the Callback / Redirect URI to: <code>https://127.0.0.1:8000/api/broker/b1/callback</code> (or your specific slot ID).</li>
                            <li>Once approved by Schwab, copy the <strong>App Key</strong> (Client ID) and <strong>App Secret</strong> into the <a href="/setup">Setup Wizard</a> or <a href="/settings">Settings</a>.</li>
                            <li>Click <strong>OAuth Connect</strong> to authorize and link your account.</li>
                        </ol>
                    </div>

                    <!-- Tastytrade -->
                    <div class="help-guide-block border-purple">
                        <div class="help-guide-header">
                            <span class="help-guide-title">
                                <span class="material-symbols-outlined" style="color: var(--purple);">swap_horiz</span>
                                Tastytrade API
                            </span>
                            <span class="hbadge" style="background: rgba(188,140,255,0.15); color: var(--purple); border-color: rgba(188,140,255,0.3);">Session Token</span>
                        </div>
                        <p class="help-guide-desc">Dedicated retail API tokens for live equity and options trading.</p>
                        <ol class="help-steps-list">
                            <li>Log in to your account via the <a href="https://tastytrade.com/" target="_blank" rel="noopener">Tastytrade Portal</a>.</li>
                            <li>Enable API access in your account settings.</li>
                            <li>Generate API credentials and save them in the Setup Wizard.</li>
                        </ol>
                    </div>

                    <!-- IBKR -->
                    <div class="help-guide-block border-blue">
                        <div class="help-guide-header">
                            <span class="help-guide-title">
                                <span class="material-symbols-outlined" style="color: var(--blue);">router</span>
                                Interactive Brokers (IBKR)
                            </span>
                            <span class="hbadge badge-blue">Local Gateway</span>
                        </div>
                        <p class="help-guide-desc">Syncs through the official IBKR Client Portal API Gateway running locally.</p>
                        <ol class="help-steps-list">
                            <li>Download the <a href="https://www.interactivebrokers.com/en/trading/ib-api.php" target="_blank" rel="noopener">IBKR Client Portal Gateway</a>.</li>
                            <li>Launch the Gateway locally on port <code>5000</code>.</li>
                            <li>Authenticate with your Interactive Brokers credentials at <code>https://localhost:5000</code>.</li>
                            <li>MoonShot Portfolio will automatically synchronize through the local gateway bridge.</li>
                        </ol>
                    </div>

                    <!-- Alpaca -->
                    <div class="help-guide-block border-green">
                        <div class="help-guide-header">
                            <span class="help-guide-title">
                                <span class="material-symbols-outlined" style="color: var(--green);">savings</span>
                                Alpaca Markets
                            </span>
                            <span class="hbadge badge-green">Paper / Live</span>
                        </div>
                        <p class="help-guide-desc">Commission-free developer-first brokerage with instant sandbox keys.</p>
                        <ol class="help-steps-list">
                            <li>Log into the <a href="https://alpaca.markets/" target="_blank" rel="noopener">Alpaca Dashboard</a>.</li>
                            <li>Click <strong>Generate Key</strong> on your dashboard.</li>
                            <li>Copy both the <strong>API Key ID</strong> and <strong>Secret Key</strong> into Setup.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: MARKET DATA & AI INTELLIGENCE -->
            <div class="help-card" data-category="market-data ai">
                <div class="help-card-header">
                    <h2 class="help-card-title">
                        <span class="material-symbols-outlined" style="color: var(--green);">database</span>
                        Market Data & AI Intelligence
                    </h2>
                    <span class="hbadge badge-green">Data Feeds</span>
                </div>
                
                <div class="help-card-body">
                    <!-- Finnhub -->
                    <div class="help-guide-block border-green">
                        <div class="help-guide-header">
                            <span class="help-guide-title">
                                <span class="material-symbols-outlined" style="color: var(--green);">show_chart</span>
                                Finnhub Stock API
                            </span>
                            <span class="hbadge badge-green">Free Tier Available</span>
                        </div>
                        <p class="help-guide-desc">Supplies real-time equity quotes, company profiles, earnings dates, dividends, and market news.</p>
                        <ol class="help-steps-list">
                            <li>Go to the <a href="https://finnhub.io/register" target="_blank" rel="noopener">Finnhub Registration Page</a>.</li>
                            <li>Create a free account and confirm your email.</li>
                            <li>Copy the generated <strong>API Key</strong> from your dashboard.</li>
                            <li>Save in the Setup Wizard under Market Data Keys.</li>
                        </ol>
                    </div>

                    <!-- Google Gemini -->
                    <div class="help-guide-block border-yellow">
                        <div class="help-guide-header">
                            <span class="help-guide-title">
                                <span class="material-symbols-outlined" style="color: var(--yellow);">psychology</span>
                                Google Gemini AI
                            </span>
                            <span class="hbadge" style="background: rgba(210, 153, 34, 0.15); color: var(--yellow); border-color: rgba(210, 153, 34, 0.3);">Default LLM</span>
                        </div>
                        <p class="help-guide-desc">Powers Neuromorphic early exit evals, trade sanity checks, macro synthesis, and idea matrix generation.</p>
                        <ol class="help-steps-list">
                            <li>Visit <a href="https://aistudio.google.com/" target="_blank" rel="noopener">Google AI Studio</a>.</li>
                            <li>Click <strong>"Get API key"</strong> on the left navigation panel.</li>
                            <li>Create a key in a new or existing Google Cloud project.</li>
                            <li>Paste the key into the Setup Wizard or Settings panel.</li>
                        </ol>
                    </div>

                    <!-- OpenAI & Anthropic -->
                    <div class="help-guide-block border-purple">
                        <div class="help-guide-header">
                            <span class="help-guide-title">
                                <span class="material-symbols-outlined" style="color: var(--purple);">alt_route</span>
                                Anthropic & OpenAI Routers
                            </span>
                            <span class="hbadge" style="background: rgba(188,140,255,0.15); color: var(--purple); border-color: rgba(188,140,255,0.3);">Multi-Provider</span>
                        </div>
                        <p class="help-guide-desc">Fallback providers for high-availability inference across Claude 3.5 Sonnet and GPT-4o.</p>
                        <ol class="help-steps-list">
                            <li>Obtain keys from <a href="https://console.anthropic.com/" target="_blank" rel="noopener">Anthropic Console</a> or <a href="https://platform.openai.com/" target="_blank" rel="noopener">OpenAI Platform</a>.</li>
                            <li>Configure active router preference under <a href="/settings">Settings &gt; AI Engine</a>.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: FLYWHEEL STRATEGY ARCHITECTURE -->
            <div class="help-card" data-category="strategy" style="grid-column: 1 / -1;">
                <div class="help-card-header">
                    <h2 class="help-card-title">
                        <span class="material-symbols-outlined" style="color: var(--yellow);">bolt</span>
                        Capital Flywheel Allocation & Rules
                    </h2>
                    <span class="hbadge" style="background: rgba(210, 153, 34, 0.15); color: var(--yellow); border-color: rgba(210, 153, 34, 0.3);">Rule Engine</span>
                </div>
                
                <div class="help-card-body">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">
                        
                        <div class="help-faq-item">
                            <div class="help-faq-q">
                                <span class="material-symbols-outlined" style="color: var(--blue);">pie_chart</span>
                                60 / 25 / 15 Capital Allocation Split
                            </div>
                            <p class="help-faq-a">
                                <strong>60% Covered Calls (CALL):</strong> Monetizes existing 100-share blocks via Out-of-the-Money calls.<br>
                                <strong>25% Cash-Secured Puts (WHEEL):</strong> Collects upfront option premium while targeting discounted stock entry points.<br>
                                <strong>15% Protective / Opportunistic (PUT):</strong> Defensive buffer and tail-risk hedging allocations.
                            </p>
                        </div>

                        <div class="help-faq-item">
                            <div class="help-faq-q">
                                <span class="material-symbols-outlined" style="color: var(--green);">fast_forward</span>
                                50% Profit Target Early Exit (BTC)
                            </div>
                            <p class="help-faq-a">
                                When open short options capture &ge; 50% of maximum theoretical credit prior to expiration, the engine signals a **Buy-to-Close (BTC)** order to free collateral and eliminate tail risk early.
                            </p>
                        </div>

                        <div class="help-faq-item">
                            <div class="help-faq-q">
                                <span class="material-symbols-outlined" style="color: var(--yellow);">shield</span>
                                Pre-Trade AI Sanity Check
                            </div>
                            <p class="help-faq-a">
                                Verifies that no earnings reports occur inside the contract expiration window, confirms underlying volatility metrics, and checks capital risk guardrails before staging orders.
                            </p>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        {% include 'screener/partials/_footer.html.twig' %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/help.js') }}"></script>
{% endblock %}
