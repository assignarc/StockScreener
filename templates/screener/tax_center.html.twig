{% extends 'base.html.twig' %}

{% block title %}Tax Center & Realizations — MoonShot Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/tax_center.css') }}">
{% endblock %}

{% block body %}
<div id="app">

    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined" style="color:var(--blue); font-size:24px;">account_balance_wallet</span> Tax Center <span>& Realizations</span>',
        headerBadge: 'IRS Schedule D & 1099-B Engine'
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <div class="port-container">
        
        <!-- EXPLANATORY HERO BANNER -->
        <div style="background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(168, 85, 247, 0.03)); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 16px; padding: 20px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 16px;">
            <span class="material-symbols-outlined" style="font-size: 32px; color: var(--blue); margin-top: 4px;">account_balance</span>
            <div>
                <h3 style="margin: 0 0 6px 0; font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 700; color: var(--text);">Statutory Tax Accounting & IRS Netting Rules</h3>
                <p style="margin: 0; font-size: 12px; color: var(--muted); line-height: 1.6;">
                    This tax center implements statutory **IRS Schedule D (Form 8949)** capital gains netting across isolated account queues. 
                    Short-Term gains (&le; 365 days) are estimated at ordinary rates (**20%**), while Long-Term gains (&gt; 365 days) receive preferential rates (**15%**). 
                    Option expirations and two-sided long/short contracts are accounted for under **IRC § 1234**, dividend income under **1099-DIV**, and wash sales are monitored under **IRC § 1091**.
                </p>
            </div>
        </div>

        <!-- WASH SALE & TAX LOSS HARVESTING ALERT BANNER -->
        <div id="washSaleAlertBanner" style="background: rgba(234, 179, 8, 0.08); border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 14px; padding: 14px 18px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <span class="material-symbols-outlined" style="font-size: 26px; color: var(--yellow);">shield</span>
                <div>
                    <div style="font-weight: 800; font-size: 13px; color: var(--text); display: flex; align-items: center; gap: 8px;">
                        <span>IRC § 1091 Wash Sale Guardrail:</span>
                        <span id="washSaleBadge" class="hbadge" style="background: rgba(234, 179, 8, 0.2); color: var(--yellow); font-size: 10px;">Monitoring 61-Day Window</span>
                    </div>
                    <div id="washSaleSubtext" style="font-size: 11px; color: var(--muted); margin-top: 2px;">
                        Positions sold at a loss where replacement shares were bought within &plusmn;30 days have deferred loss deductions added to cost basis.
                    </div>
                </div>
            </div>
            <div style="font-size: 12px; font-weight: 700; color: var(--text); background: var(--bg1); border: 1px solid var(--border); padding: 6px 12px; border-radius: 8px;">
                Disallowed Wash Losses: <span id="bannerWashAmount" style="color: var(--yellow); font-family: 'SFMono-Regular',Consolas,monospace;">$0.00</span>
            </div>
        </div>

        <!-- TOP EXECUTIVE TAX STATS -->
        <div class="port-summary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <!-- CARD 1: Taxable Net Capital Gains -->
            <div class="port-card" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; position: relative; overflow: hidden;">
                <div class="lbl" style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Taxable Net Gains</div>
                <div class="val" id="statTaxableGains" style="font-family: 'Outfit', sans-serif; font-size: 24px; font-weight: 900;">$0.00</div>
                <div id="statTaxableBreakdown" style="font-size: 10px; color: var(--muted); margin-top: 6px;">ST: $0.00 | LT: $0.00</div>
                <div style="position: absolute; right: 12px; bottom: 12px; opacity: 0.04; font-size: 56px;" class="material-symbols-outlined">payments</div>
            </div>

            <!-- CARD 2: Est. Tax Liability -->
            <div class="port-card" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; position: relative; overflow: hidden;">
                <div class="lbl" style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Est. Tax Liability</div>
                <div class="val r" style="color: var(--red); font-family: 'Outfit', sans-serif; font-size: 24px; font-weight: 900;" id="statEstTax">$0.00</div>
                <div id="statTaxBreakdown" style="font-size: 10px; color: var(--muted); margin-top: 6px;">Netted ST (20%) + LT (15%) + Div/Int</div>
                <div style="position: absolute; right: 12px; bottom: 12px; opacity: 0.04; font-size: 56px;" class="material-symbols-outlined">gavel</div>
            </div>

            <!-- CARD 3: Dividend & Interest Income -->
            <div class="port-card" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; position: relative; overflow: hidden;">
                <div class="lbl" style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Dividends & Interest</div>
                <div class="val" id="statDividendIncome" style="font-family: 'Outfit', sans-serif; font-size: 24px; font-weight: 900; color: var(--blue);">$0.00</div>
                <div id="statDivBreakdown" style="font-size: 10px; color: var(--muted); margin-top: 6px;">Qualified: $0.00 | Ordinary/Int: $0.00</div>
                <div style="position: absolute; right: 12px; bottom: 12px; opacity: 0.04; font-size: 56px;" class="material-symbols-outlined">savings</div>
            </div>

            <!-- CARD 4: Prior-Year Loss Shield -->
            <div class="port-card" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; position: relative; overflow: hidden;">
                <div class="lbl" style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Prior Loss Shield</div>
                <div class="val" id="statCarryforward" style="font-family: 'Outfit', sans-serif; font-size: 24px; font-weight: 900; color: var(--yellow);">$0.00</div>
                <div id="statCarryBreakdown" style="font-size: 10px; color: var(--muted); margin-top: 6px;">IRC § 1212 Loss Carryforward</div>
                <div style="position: absolute; right: 12px; bottom: 12px; opacity: 0.04; font-size: 56px;" class="material-symbols-outlined">history</div>
            </div>

            <!-- CARD 5: Retirement Portfolio Performance -->
            <div class="port-card" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; position: relative; overflow: hidden;">
                <div class="lbl" style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Retirement (IRAs / PCRA)</div>
                <div class="val" id="statRetirementGains" style="font-family: 'Outfit', sans-serif; font-size: 24px; font-weight: 900;">$0.00</div>
                <div style="font-size: 10px; color: var(--green); margin-top: 6px; font-weight: 700;">Tax-Exempt / Deferred ($0.00 Tax)</div>
                <div style="position: absolute; right: 12px; bottom: 12px; opacity: 0.04; font-size: 56px;" class="material-symbols-outlined">verified_user</div>
            </div>
        </div>

        <!-- VIEW TAB SWITCHER -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 8px; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <button class="vtab active" id="tabRealizedGains" onclick="switchTaxView('realized')">
                    <span class="material-symbols-outlined" style="font-size: 16px;">candlestick_chart</span>
                    Realized Capital Gains (1099-B View)
                    <div class="indicator"></div>
                </button>
                <button class="vtab" id="tabDividends" onclick="switchTaxView('dividends')">
                    <span class="material-symbols-outlined" style="font-size: 16px;">savings</span>
                    Dividends & Interest (1099-DIV / INT)
                    <div class="indicator"></div>
                </button>
                <button class="vtab" id="tabAllTransactions" onclick="switchTaxView('all_tx')">
                    <span class="material-symbols-outlined" style="font-size: 16px;">receipt_long</span>
                    All Transactions (Audit Log)
                    <div class="indicator"></div>
                </button>
            </div>
            <div style="font-size: 12px; color: var(--muted); background: var(--bg2); border: 1px solid var(--border); padding: 4px 10px; border-radius: 20px;" id="activeCountsText">
                Showing 0 realizations
            </div>
        </div>

        <!-- FILTER BAR -->
        <div style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;">
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; flex: 1;">
                
                <!-- Search Box -->
                <div style="position: relative; min-width: 160px;">
                    <span class="material-symbols-outlined" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 16px; color: var(--muted);">search</span>
                    <input id="filterSearch" type="text" placeholder="Search Ticker..." oninput="applyTaxFilters()" class="tax-filter-input">
                </div>

                <!-- Timeframe Selector -->
                <div class="tax-seg-track">
                    <button class="fbtn" onclick="setFilterTimeframe('30d', this)">30 Days</button>
                    <button class="fbtn" onclick="setFilterTimeframe('60d', this)">60 Days</button>
                    <button class="fbtn" onclick="setFilterTimeframe('90d', this)">90 Days</button>
                    <button class="fbtn active" onclick="setFilterTimeframe('this_year', this)">This Year</button>
                    <button class="fbtn" onclick="setFilterTimeframe('last_year', this)">Last Year</button>
                    <button class="fbtn" onclick="setFilterTimeframe('all', this)">All</button>
                </div>

                <!-- Account Category Filter (Taxable vs Retirement) -->
                <input type="hidden" id="filterAccountCategory" value="ALL">
                <div class="tax-seg-track">
                    <button class="cat-fbtn active" data-cat="ALL" onclick="setAccountCategory('ALL', this)">All Accounts</button>
                    <button class="cat-fbtn" data-cat="TAXABLE" onclick="setAccountCategory('TAXABLE', this)">Taxable Only</button>
                    <button class="cat-fbtn" data-cat="RETIREMENT" onclick="setAccountCategory('RETIREMENT', this)">Retirement (IRAs) Only</button>
                </div>

                <!-- Specific Account Dropdown Filter -->
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase;">Account:</span>
                    <select id="filterAccount" onchange="applyTaxFilters()" class="tax-filter-select">
                        <option value="ALL">All Accounts</option>
                        {% set uniqueAccounts = [] %}
                        {% for acc in portfolio.accounts|default([]) %}
                            {% set accName = acc.nickname|default(acc.accountNumber|default(acc.id|default(''))) %}
                            {% if accName and accName not in uniqueAccounts %}
                                {% set uniqueAccounts = uniqueAccounts|merge([accName]) %}
                                {% set isRetire = acc.isRetirement|default((accName ~ ' ' ~ acc.type|default(''))|upper matches '/(IRA|ROTH|SEP|PCRA|401K)/') %}
                                {% set accType = acc.type|default('MARGIN') %}
                                <option value="{{ accName }}" data-number="{{ acc.accountNumber|default('') }}" data-id="{{ acc.id|default('') }}">{{ accName }} ({{ isRetire ? 'Retirement' : 'Taxable' }} • {{ accType }})</option>
                            {% endif %}
                        {% endfor %}
                        {% for r in realizations %}
                            {% if r.account and r.account not in uniqueAccounts %}
                                {% set uniqueAccounts = uniqueAccounts|merge([r.account]) %}
                                {% set isRetire = (r.taxStatus == 'RETIREMENT_IRA') %}
                                <option value="{{ r.account }}">{{ r.account }} ({{ isRetire ? 'Retirement' : 'Taxable' }})</option>
                            {% endif %}
                        {% endfor %}
                        {% for inc in incomeRecords|default([]) %}
                            {% if inc.account and inc.account not in uniqueAccounts %}
                                {% set uniqueAccounts = uniqueAccounts|merge([inc.account]) %}
                                {% set isRetire = (inc.taxStatus == 'RETIREMENT_IRA') %}
                                <option value="{{ inc.account }}">{{ inc.account }} ({{ isRetire ? 'Retirement' : 'Taxable' }})</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                <!-- Asset Filter Segment -->
                <input type="hidden" id="filterAssetType" value="ALL">
                <div class="tax-seg-track">
                    <button class="asset-fbtn active" data-asset="ALL" onclick="setAssetFilter('ALL', this)">All Assets</button>
                    <button class="asset-fbtn" data-asset="EQUITY" onclick="setAssetFilter('EQUITY', this)">Stocks</button>
                    <button class="asset-fbtn" data-asset="OPTION" onclick="setAssetFilter('OPTION', this)">Options</button>
                </div>

                <!-- Group By Selector -->
                <div id="groupSelectorContainer" style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase;">Group By:</span>
                    <select id="filterGroupBy" onchange="applyTaxFilters()" class="tax-filter-select">
                        <option value="NONE">None (Chronological)</option>
                        <option value="TICKER">Security Ticker</option>
                        <option value="ACCOUNT">Account Nickname</option>
                        <option value="MONTH">Month / Year</option>
                    </select>
                </div>
            </div>

            <!-- Collapse/Expand All Buttons -->
            <div id="expandCollapseAllActions" style="display: flex; gap: 8px;">
                <button class="tax-action-btn" onclick="toggleAllGroups(true)">
                    <span class="material-symbols-outlined" style="font-size: 14px;">unfold_more</span> Expand All
                </button>
                <button class="tax-action-btn" onclick="toggleAllGroups(false)">
                    <span class="material-symbols-outlined" style="font-size: 14px;">unfold_less</span> Collapse All
                </button>
            </div>
        </div>

        <!-- VIEW 1: REALIZED CAPITAL GAINS LEDGER (FORM 8949) -->
        <div id="viewRealized" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--card-shadow); width: 100%; position: relative; overflow: hidden;">
            <!-- Top Table Totals Banner -->
            <div id="realizedSummaryBanner" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; background: var(--bg3); border-bottom: 1px solid var(--border); padding: 12px 18px; border-top-left-radius: 12px; border-top-right-radius: 12px; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: var(--blue);">calculate</span>
                    <span style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 800; color: var(--text); text-transform: uppercase; letter-spacing: 0.5px;">Schedule D Netted Totals</span>
                    <span id="realizedFilteredBadge" style="font-size: 11px; background: rgba(56,189,248,0.15); color: var(--blue); padding: 2px 8px; border-radius: 12px; font-weight: 700;">0 Realizations</span>
                    <span id="optionReconcileBadge" style="display: none; align-items: center; gap: 4px; font-size: 11px; background: rgba(56,189,248,0.12); border: 1px solid rgba(56,189,248,0.3); color: var(--blue); padding: 2px 10px; border-radius: 12px; font-weight: 600;">
                        <span class="material-symbols-outlined" style="font-size: 14px;">info</span>
                        <span id="optionReconcileText"></span>
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Cost Basis: </span>
                        <span id="tblTotalBasis" style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 800; color: var(--text);">$0.00</span>
                    </div>
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Proceeds: </span>
                        <span id="tblTotalProceeds" style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 800; color: var(--text);">$0.00</span>
                    </div>
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Net Realized: </span>
                        <span id="tblTotalGain" style="font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 900; color: var(--green);">$0.00</span>
                    </div>
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Netted Tax Liability: </span>
                        <span id="tblTotalTax" style="font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 900; color: var(--red);">$0.00</span>
                    </div>
                </div>
            </div>

            <div style="width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; table-layout: fixed; min-width: 820px;">
                    <thead>
                        <tr style="background: var(--bg3); border-bottom: 1px solid var(--border); color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .5px; user-select: none;">
                            <th style="width: 17%; min-width: 145px; padding: 10px 12px; white-space: nowrap;">
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <span onclick="sortTableBy('sellDate')" style="cursor: pointer;" title="Sort by Sold Date">Sold <span id="sort_sellDate">▼</span></span>
                                    <span style="opacity: 0.3;">/</span>
                                    <span onclick="sortTableBy('buyDate')" style="cursor: pointer;" title="Sort by Acquired Date">Acq <span id="sort_buyDate">↕</span></span>
                                </div>
                            </th>
                            <th style="width: 20%; min-width: 165px; padding: 10px 12px; white-space: nowrap;">
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <span onclick="sortTableBy('symbol')" style="cursor: pointer;" title="Sort by Ticker">Ticker <span id="sort_symbol">↕</span></span>
                                    <span style="opacity: 0.3;">/</span>
                                    <span onclick="sortTableBy('account')" style="cursor: pointer;" title="Sort by Account">Account <span id="sort_account">↕</span></span>
                                </div>
                            </th>
                            <th onclick="sortTableBy('qty')" style="width: 9%; min-width: 70px; padding: 10px 12px; text-align: right; cursor: pointer; white-space: nowrap;">
                                Qty <span id="sort_qty">↕</span>
                            </th>
                            <th style="width: 18%; min-width: 150px; padding: 10px 12px; text-align: right; white-space: nowrap;">
                                <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                                    <span onclick="sortTableBy('proceeds')" style="cursor: pointer;" title="Sort by Proceeds">Proceeds <span id="sort_proceeds">↕</span></span>
                                    <span style="opacity: 0.3;">/</span>
                                    <span onclick="sortTableBy('costBasis')" style="cursor: pointer;" title="Sort by Cost Basis">Basis <span id="sort_costBasis">↕</span></span>
                                </div>
                            </th>
                            <th onclick="sortTableBy('realizedGain')" style="width: 18%; min-width: 140px; padding: 10px 12px; text-align: right; cursor: pointer; white-space: nowrap;">
                                Realized P&L <span id="sort_realizedGain">↕</span>
                            </th>
                            <th onclick="sortTableBy('estTax')" style="width: 18%; min-width: 135px; padding: 10px 12px; text-align: right; cursor: pointer; white-space: nowrap;">
                                Est. Tax <span id="sort_estTax">↕</span>
                            </th>
                        </tr>
                        <!-- Top Summary Total Row inside Table Head -->
                        <tr id="realizedTableTopRow" style="background: rgba(56, 189, 248, 0.05); border-bottom: 2px solid var(--border); font-size: 12px;">
                            <td style="padding: 10px 12px; color: var(--blue); white-space: nowrap;">
                                <div style="font-weight: 800; font-size: 13px; display: flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 15px;">functions</span> NET TOTALS
                                </div>
                                <div id="topRowPeriod" style="color: var(--muted); font-size: 11px; margin-top: 2px;">All Terms</div>
                            </td>
                            <td style="padding: 10px 12px;">
                                <div id="topRowSymbol" style="font-weight: 700; font-size: 13px; color: var(--text);">All Tickers</div>
                                <div id="topRowAccount" style="color: var(--muted); font-size: 11px; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">All Accounts</div>
                            </td>
                            <td id="topRowQty" style="padding: 10px 12px; text-align: right; font-family: 'SFMono-Regular',Consolas,monospace;">
                                <div style="font-weight: 700; font-size: 13px; color: var(--text);">--</div>
                                <div style="font-size: 11px; color: var(--muted); margin-top: 2px;">Trades</div>
                            </td>
                            <td id="topRowCostBasis" style="padding: 10px 12px; text-align: right; font-family: 'SFMono-Regular',Consolas,monospace;">
                                <div style="color: var(--text); font-weight: 800; font-size: 13px;">$0.00</div>
                                <div style="font-size: 12px; font-weight: 600; color: var(--muted); margin-top: 2px;">Cost: $0.00</div>
                            </td>
                            <td id="topRowRealizedGain" style="padding: 10px 12px; text-align: right; font-family: 'SFMono-Regular',Consolas,monospace;">
                                <div style="font-weight: 900; font-size: 14px; color: var(--green);">$0.00</div>
                                <div style="font-size: 11px; color: var(--muted); margin-top: 2px;">Taxable Gains</div>
                            </td>
                            <td id="topRowEstTax" style="padding: 10px 12px; text-align: right; font-family: 'SFMono-Regular',Consolas,monospace;">
                                <div style="font-weight: 800; font-size: 13px; color: var(--red);">$0.00</div>
                                <div style="font-size: 11px; color: var(--muted); margin-top: 2px;">Liability</div>
                            </td>
                        </tr>
                    </thead>
                    <tbody id="taxRealizationBody">
                        <!-- Loaded dynamically via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- VIEW 2: DIVIDENDS & INTEREST INCOME LEDGER (1099-DIV / INT) -->
        <div id="viewDividends" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--card-shadow); display: none; width: 100%; position: relative; overflow: hidden;">
            <div id="divSummaryBanner" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; background: var(--bg3); border-bottom: 1px solid var(--border); padding: 12px 18px; border-top-left-radius: 12px; border-top-right-radius: 12px; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: var(--blue);">savings</span>
                    <span style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 800; color: var(--text); text-transform: uppercase; letter-spacing: 0.5px;">1099-DIV & 1099-INT Income Summary</span>
                    <span id="divFilteredBadge" style="font-size: 11px; background: rgba(56,189,248,0.15); color: var(--blue); padding: 2px 8px; border-radius: 12px; font-weight: 700;">0 Records</span>
                </div>
                <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Qualified: </span>
                        <span id="tblDivQualified" style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 800; color: var(--green);">$0.00</span>
                    </div>
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Ordinary & Interest: </span>
                        <span id="tblDivOrdinary" style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 800; color: var(--text);">$0.00</span>
                    </div>
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Est. Tax: </span>
                        <span id="tblDivTax" style="font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 900; color: var(--red);">$0.00</span>
                    </div>
                </div>
            </div>

            <div style="width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; table-layout: auto; min-width: 750px;">
                    <thead>
                        <tr style="background: var(--bg3); border-bottom: 1px solid var(--border); color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .5px;">
                            <th style="padding: 10px 12px; white-space: nowrap;">Date</th>
                            <th style="padding: 10px 12px; white-space: nowrap;">Ticker / Asset</th>
                            <th style="padding: 10px 12px; white-space: nowrap;">Account</th>
                            <th style="padding: 10px 12px; white-space: nowrap;">Income Category</th>
                            <th style="padding: 10px 12px; white-space: nowrap;">Description</th>
                            <th style="padding: 10px 12px; text-align: right; white-space: nowrap;">Amount</th>
                            <th style="padding: 10px 12px; text-align: right; white-space: nowrap;">Tax Treatment</th>
                        </tr>
                    </thead>
                    <tbody id="divIncomeBody">
                        <!-- Loaded dynamically via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- VIEW 3: ALL ACCOUNT TRANSACTIONS AUDIT LEDGER -->
        <div id="viewAllTx" style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--card-shadow); display: none; width: 100%; position: relative; overflow: hidden;">
            <div id="txTableSummaryBanner" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; background: var(--bg3); border-bottom: 1px solid var(--border); padding: 12px 18px; border-top-left-radius: 12px; border-top-right-radius: 12px; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: var(--blue);">receipt_long</span>
                    <span style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 800; color: var(--text); text-transform: uppercase; letter-spacing: 0.5px;">Audit Log Totals</span>
                    <span id="txFilteredBadge" style="font-size: 11px; background: rgba(56,189,248,0.15); color: var(--blue); padding: 2px 8px; border-radius: 12px; font-weight: 700;">0 Transactions</span>
                </div>
                <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                    <div style="background: var(--bg1); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px;">
                        <span style="font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase;">Net Cash Flow: </span>
                        <span id="tblTxNetFlow" style="font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 900; color: var(--blue);">$0.00</span>
                    </div>
                </div>
            </div>

            <div style="width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; table-layout: auto; min-width: 800px;">
                    <thead>
                        <tr style="background: var(--bg3); border-bottom: 1px solid var(--border); color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .5px; user-select: none;">
                            <th onclick="sortTxBy('date')" style="padding: 10px 12px; cursor: pointer; white-space: nowrap;">Date <span id="sort_tx_date">▼</span></th>
                            <th onclick="sortTxBy('symbol')" style="padding: 10px 12px; cursor: pointer; white-space: nowrap;">Ticker / Asset <span id="sort_tx_symbol">↕</span></th>
                            <th onclick="sortTxBy('account_nickname')" style="padding: 10px 12px; cursor: pointer; white-space: nowrap;">Account <span id="sort_tx_account">↕</span></th>
                            <th onclick="sortTxBy('type')" style="padding: 10px 12px; cursor: pointer; white-space: nowrap;">Type <span id="sort_tx_type">↕</span></th>
                            <th style="padding: 10px 12px; white-space: nowrap;">Description</th>
                            <th style="padding: 10px 12px; text-align: right; white-space: nowrap;">Price</th>
                            <th onclick="sortTxBy('amount')" style="padding: 10px 12px; text-align: right; cursor: pointer; color: var(--blue); white-space: nowrap;">Cash Flow <span id="sort_tx_amount">↕</span></th>
                        </tr>
                        <tr id="txTableTopRow" style="background: rgba(56, 189, 248, 0.05); border-bottom: 2px solid var(--border); font-size: 12px; font-weight: 800;">
                            <td style="padding: 8px 12px; color: var(--blue);">
                                <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle; margin-right: 2px;">functions</span> TOTALS
                            </td>
                            <td id="topTxRowSymbol" style="padding: 8px 12px; color: var(--muted); font-size: 11px;">All Tickers</td>
                            <td id="topTxRowAccount" style="padding: 8px 12px; color: var(--muted); font-size: 11px;">All Accounts</td>
                            <td id="topTxRowType" style="padding: 8px 12px; color: var(--muted); font-size: 11px;">All Types</td>
                            <td style="padding: 8px 12px; color: var(--muted); font-size: 11px;">Filtered Activity</td>
                            <td style="padding: 8px 12px; text-align: right; color: var(--muted); font-size: 11px;">--</td>
                            <td id="topTxRowCashFlow" style="padding: 8px 12px; text-align: right; font-family: 'Outfit', sans-serif; font-size: 13px;">$0.00</td>
                        </tr>
                    </thead>
                    <tbody id="allTxBody">
                        <!-- Loaded dynamically via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    {% include 'screener/partials/_footer.html.twig' %}
</div>
{% endblock %}

{% block javascripts %}
<script>
    window.taxCenterData = {
        realizations: {{ realizations|json_encode|raw }},
        incomeRecords: {{ (incomeRecords ?? [])|json_encode|raw }},
        carryforwards: {{ (carryforwards ?? {})|json_encode|raw }},
        taxLiability: {{ (taxLiability ?? {})|json_encode|raw }},
        history: {{ history|json_encode|raw }}
    };
</script>
<script src="{{ asset('js/tax_center.js') }}"></script>
{% endblock %}
