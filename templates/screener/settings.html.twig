{% extends 'base.html.twig' %}

{% block title %}System Settings & Rules — MoonShot Portfolio{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/settings.css') }}">
{% endblock %}

{% block body %}
<div class="settings-wrap">

    <!-- UNIFIED BRAND HEADER & NAVIGATION -->
    {% include 'screener/partials/_header.html.twig' with {
        headerTitle: '<span class="material-symbols-outlined" style="vertical-align:middle; font-size:22px; color:var(--blue);">settings</span> System <span>Settings & Rules</span>',
        headerBadge: 'SQLite data.db Config Engine'
    } %}
    {% include 'screener/partials/_nav.html.twig' %}

    <!-- Hero -->
    <div class="settings-hero">
        <div class="settings-hero-inner">
            <h2><span class="material-symbols-outlined" style="vertical-align:middle; font-size:24px; color:var(--blue); margin-right:4px;">tune</span> Quantitative Strategy Rules & Parameters</h2>
            <p>All values are persisted to <code>data.db</code> and take effect immediately across all Flywheel algorithms. Defaults are restored if a field is cleared.</p>
        </div>
    </div>

    <!-- Main Settings Container with Sidebar Navigation -->
    <div class="settings-container">

        <!-- Sticky Sidebar Navigation -->
        <div class="settings-sidebar">
            <button type="button" class="settings-tab-btn active" onclick="switchSettingsTab('tabBrokersAi', this)">
                <span class="material-symbols-outlined">hub</span>
                <span>Brokers & AI</span>
                <span class="settings-tab-badge">Active</span>
            </button>
            <button type="button" class="settings-tab-btn" onclick="switchSettingsTab('tabTradingRules', this)">
                <span class="material-symbols-outlined">analytics</span>
                <span>Signal Rules</span>
            </button>
            <button type="button" class="settings-tab-btn" onclick="switchSettingsTab('tabCoveredCalls', this)">
                <span class="material-symbols-outlined">call</span>
                <span>Covered Calls & Exits</span>
            </button>
            <button type="button" class="settings-tab-btn" onclick="switchSettingsTab('tabCacheApi', this)">
                <span class="material-symbols-outlined">tune</span>
                <span>Cache TTL & APIs</span>
            </button>
            <button type="button" class="settings-tab-btn" onclick="switchSettingsTab('tabStorage', this)">
                <span class="material-symbols-outlined">database</span>
                <span>Storage & Tools</span>
            </button>
        </div>

        <!-- Settings Tab Content Area -->
        <div class="settings-content">

            <!-- ── TAB 1: Broker & AI Connections ────────────────────────── -->
            <div class="settings-tab-pane" id="tabBrokersAi">
                <!-- Brokerage Connections — Read-only status panel -->
                <div class="cfg-section" id="cfgBrokerCredentials">
                    <div class="cfg-section-header" style="justify-content:space-between;">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <span class="material-symbols-outlined" style="font-size:22px; color:var(--blue);">account_balance</span>
                            <div>
                                <h2>Brokerage Connections</h2>
                                <p>Currently configured broker connections. To add, remove or reconfigure — use the Setup Wizard.</p>
                            </div>
                        </div>
                        <a href="/setup#step3" class="hbtn hbtn-blue" style="font-size:12px; padding:8px 16px; text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-weight:700; flex-shrink:0;">
                            <span class="material-symbols-outlined">manage_accounts</span> Manage in Setup Wizard
                        </a>
                    </div>

                    <!-- Read-only broker connection status cards -->
                    <div class="flex-col gap-sm" id="brokerReadonlyCards" style="padding:16px 24px;">
                        {% for inst in brokerInstances %}
                        <div class="broker-card">
                            <span class="material-symbols-outlined broker-card-icon">account_balance</span>
                            <div class="flex-1 min-w-0">
                                <div class="flex-align-center gap-sm flex-wrap">
                                    <span class="hbadge badge-blue">Connection {{ loop.index }}</span>
                                    <strong class="broker-card-title">{{ inst.nickname|default('Broker ' ~ loop.index) }}</strong>
                                    <span class="font-mono text-muted">
                                        {% if inst.type == 'schwab' %}Charles Schwab (OAuth 2.0)
                                        {% elseif inst.type == 'ibkr' %}Interactive Brokers (IBKR)
                                        {% elseif inst.type == 'alpaca' %}Alpaca Markets
                                        {% elseif inst.type == 'fidelity' %}Fidelity Investments
                                        {% elseif inst.type == 'etrade' %}E*TRADE / Morgan Stanley
                                        {% else %}{{ inst.type }}{% endif %}
                                    </span>
                                </div>
                                <div class="broker-card-subtitle">
                                    {% if inst.app_key is not empty %}
                                        <span class="font-mono">Key: {{ inst.app_key|slice(0,8) }}••••••••</span>
                                        &nbsp;·&nbsp;
                                        <span class="text-green">
                                            <span class="material-symbols-outlined font-sm">check_circle</span>
                                            Credentials configured
                                        </span>
                                    {% else %}
                                        <span class="text-yellow">
                                            <span class="material-symbols-outlined font-sm">warning</span>
                                            No credentials set — configure in Setup Wizard
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            {% if inst.type == 'schwab' or inst.type == 'etrade' %}
                            <a href="/api/broker/{{ inst.id }}/login" target="_blank" class="hbtn hbtn-blue">
                                <span class="material-symbols-outlined">link</span> OAuth
                            </a>
                            {% endif %}
                        </div>
                        {% else %}
                        <div style="text-align:center; padding:28px; color:var(--muted);">
                            <span class="material-symbols-outlined" style="font-size:36px; display:block; margin-bottom:10px; opacity:0.4;">account_balance</span>
                            <p style="margin:0 0 14px; font-size:13px;">No broker connections configured yet.</p>
                            <a href="/setup" class="hbtn hbtn-blue" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-size:13px;">
                                <span class="material-symbols-outlined">bolt</span> Run Setup Wizard
                            </a>
                        </div>
                        {% endfor %}
                    </div>

                    <!-- Market Data & AI API Keys — editable full-width rows -->
                    <div class="cfg-rows" style="border-top:1px solid var(--border);">
                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Active AI Engine / LLM Provider</div>
                                    <div class="cfg-desc">Choose between Gemini, OpenAI, Claude, or a self-hosted Local LLM.</div>
                                    <div class="cfg-key">llm.provider</div>
                                </div>
                            </div>
                            <select class="styled-select-input cfg-input" id="cfg_llm_provider" data-key="llm.provider" data-original="{{ config['llm.provider']|default('gemini') }}" onchange="onFieldChange(this)">
                                <option value="gemini" {% if config['llm.provider']|default('gemini') == 'gemini' %}selected{% endif %}>Google Gemini API</option>
                                <option value="openai" {% if config['llm.provider']|default('gemini') == 'openai' %}selected{% endif %}>OpenAI API</option>
                                <option value="claude" {% if config['llm.provider']|default('gemini') == 'claude' %}selected{% endif %}>Anthropic Claude API</option>
                                <option value="local" {% if config['llm.provider']|default('gemini') == 'local' %}selected{% endif %}>Self-Hosted Local LLM (OpenAI-compatible)</option>
                            </select>
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Google Gemini Model Selection</div>
                                    <div class="cfg-desc">Choose target Google Gemini model.</div>
                                    <div class="cfg-key">gemini.model</div>
                                </div>
                            </div>
                            <select class="styled-select-input cfg-input" id="cfg_gemini_model" data-key="gemini.model" data-original="{{ config['gemini.model']|default('auto') }}" onchange="onFieldChange(this)">
                                <option value="auto" {% if config['gemini.model']|default('auto') == 'auto' or config['gemini.model']|default('') == '' %}selected{% endif %}>Auto (Latest Pro/Flash & Rate-Limit Fallback)</option>
                                <option value="gemini-2.5-flash" {% if config['gemini.model']|default('') == 'gemini-2.5-flash' %}selected{% endif %}>Gemini 2.5 Flash</option>
                                <option value="gemini-2.5-pro" {% if config['gemini.model']|default('') == 'gemini-2.5-pro' %}selected{% endif %}>Gemini 2.5 Pro</option>
                                <option value="gemini-2.0-flash" {% if config['gemini.model']|default('') == 'gemini-2.0-flash' %}selected{% endif %}>Gemini 2.0 Flash</option>
                                <option value="gemini-1.5-pro" {% if config['gemini.model']|default('') == 'gemini-1.5-pro' %}selected{% endif %}>Gemini 1.5 Pro</option>
                            </select>
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Google Gemini AI Key <span style="font-size:10px; color:var(--muted); font-weight:400;">(Optional)</span></div>
                                    <div class="cfg-desc">AI strategy generation and options risk commentary. (<a href="https://aistudio.google.com/" target="_blank" style="color:var(--yellow);">Get key</a>)</div>
                                    <div class="cfg-key">gemini.api_key</div>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button type="button" class="slick-pill-btn" id="btnToggleGemini" onclick="toggleKeyVisibility('cfg_gemini_api_key', this)"><span class="material-symbols-outlined">visibility</span> Show</button>
                                    <button type="button" class="slick-pill-btn" onclick="pasteToField('cfg_gemini_api_key')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                                    <button type="button" class="slick-pill-btn" onclick="copyFromField('cfg_gemini_api_key', this)"><span class="material-symbols-outlined">content_copy</span> Copy</button>
                                </div>
                            </div>
                            <input class="large-key-input cfg-input" type="password" id="cfg_gemini_api_key" data-key="gemini.api_key" data-original="{{ config['gemini.api_key']|default('') }}" value="{{ config['gemini.api_key']|default('') }}" placeholder="AIzaSy..." oninput="onFieldChange(this)">
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">OpenAI Model Selection</div>
                                    <div class="cfg-desc">Choose target OpenAI model.</div>
                                    <div class="cfg-key">openai.model</div>
                                </div>
                            </div>
                            <select class="styled-select-input cfg-input" id="cfg_openai_model" data-key="openai.model" data-original="{{ config['openai.model']|default('gpt-4o-mini') }}" onchange="onFieldChange(this)">
                                <option value="gpt-4o-mini" {% if config['openai.model']|default('gpt-4o-mini') == 'gpt-4o-mini' %}selected{% endif %}>GPT-4o mini (Fast & Affordable)</option>
                                <option value="gpt-4o" {% if config['openai.model']|default('gpt-4o-mini') == 'gpt-4o' %}selected{% endif %}>GPT-4o (Omni High Performance)</option>
                                <option value="gpt-4-turbo" {% if config['openai.model']|default('gpt-4o-mini') == 'gpt-4-turbo' %}selected{% endif %}>GPT-4 Turbo</option>
                                <option value="o1-mini" {% if config['openai.model']|default('gpt-4o-mini') == 'o1-mini' %}selected{% endif %}>o1-mini (Reasoning Model)</option>
                            </select>
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">OpenAI API Key <span style="font-size:10px; color:var(--muted); font-weight:400;">(Optional)</span></div>
                                    <div class="cfg-desc">Required if using OpenAI engine. (<a href="https://platform.openai.com/api-keys" target="_blank" style="color:var(--blue);">Get key</a>)</div>
                                    <div class="cfg-key">openai.api_key</div>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button type="button" class="slick-pill-btn" id="btnToggleOpenAi" onclick="toggleKeyVisibility('cfg_openai_api_key', this)"><span class="material-symbols-outlined">visibility</span> Show</button>
                                    <button type="button" class="slick-pill-btn" onclick="pasteToField('cfg_openai_api_key')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                                    <button type="button" class="slick-pill-btn" onclick="copyFromField('cfg_openai_api_key', this)"><span class="material-symbols-outlined">content_copy</span> Copy</button>
                                </div>
                            </div>
                            <input class="large-key-input cfg-input" type="password" id="cfg_openai_api_key" data-key="openai.api_key" data-original="{{ config['openai.api_key']|default('') }}" value="{{ config['openai.api_key']|default('') }}" placeholder="sk-proj-..." oninput="onFieldChange(this)">
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Anthropic Claude Model Selection</div>
                                    <div class="cfg-desc">Choose target Anthropic Claude model.</div>
                                    <div class="cfg-key">claude.model</div>
                                </div>
                            </div>
                            <select class="styled-select-input cfg-input" id="cfg_claude_model" data-key="claude.model" data-original="{{ config['claude.model']|default('claude-3-5-sonnet-latest') }}" onchange="onFieldChange(this)">
                                <option value="claude-3-5-sonnet-latest" {% if config['claude.model']|default('claude-3-5-sonnet-latest') == 'claude-3-5-sonnet-latest' %}selected{% endif %}>Claude 3.5 Sonnet (Recommended)</option>
                                <option value="claude-3-5-haiku-latest" {% if config['claude.model']|default('claude-3-5-sonnet-latest') == 'claude-3-5-haiku-latest' %}selected{% endif %}>Claude 3.5 Haiku</option>
                                <option value="claude-3-opus-latest" {% if config['claude.model']|default('claude-3-5-sonnet-latest') == 'claude-3-opus-latest' %}selected{% endif %}>Claude 3 Opus (High Intelligence)</option>
                            </select>
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Anthropic Claude API Key <span style="font-size:10px; color:var(--muted); font-weight:400;">(Optional)</span></div>
                                    <div class="cfg-desc">Required if using Claude engine. (<a href="https://console.anthropic.com/" target="_blank" style="color:var(--orange);">Get key</a>)</div>
                                    <div class="cfg-key">claude.api_key</div>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button type="button" class="slick-pill-btn" id="btnToggleClaude" onclick="toggleKeyVisibility('cfg_claude_api_key', this)"><span class="material-symbols-outlined">visibility</span> Show</button>
                                    <button type="button" class="slick-pill-btn" onclick="pasteToField('cfg_claude_api_key')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                                    <button type="button" class="slick-pill-btn" onclick="copyFromField('cfg_claude_api_key', this)"><span class="material-symbols-outlined">content_copy</span> Copy</button>
                                </div>
                            </div>
                            <input class="large-key-input cfg-input" type="password" id="cfg_claude_api_key" data-key="claude.api_key" data-original="{{ config['claude.api_key']|default('') }}" value="{{ config['claude.api_key']|default('') }}" placeholder="sk-ant-..." oninput="onFieldChange(this)">
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Self-Hosted Local LLM URL</div>
                                    <div class="cfg-desc">API endpoint base URL for Ollama, LM Studio, vLLM, etc.</div>
                                    <div class="cfg-key">local_llm.url</div>
                                </div>
                            </div>
                            <input class="large-key-input cfg-input" type="text" id="cfg_local_llm_url" data-key="local_llm.url" data-original="{{ config['local_llm.url']|default('http://localhost:11434/v1') }}" value="{{ config['local_llm.url']|default('http://localhost:11434/v1') }}" placeholder="http://localhost:11434/v1" oninput="onFieldChange(this)">
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Self-Hosted Local LLM API Key <span style="font-size:10px; color:var(--muted); font-weight:400;">(Optional)</span></div>
                                    <div class="cfg-desc">API key if required by local hosting gateway.</div>
                                    <div class="cfg-key">local_llm.api_key</div>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button type="button" class="slick-pill-btn" id="btnToggleLocalLlmKey" onclick="toggleKeyVisibility('cfg_local_llm_api_key', this)"><span class="material-symbols-outlined">visibility</span> Show</button>
                                    <button type="button" class="slick-pill-btn" onclick="pasteToField('cfg_local_llm_api_key')"><span class="material-symbols-outlined">content_paste</span> Paste</button>
                                    <button type="button" class="slick-pill-btn" onclick="copyFromField('cfg_local_llm_api_key', this)"><span class="material-symbols-outlined">content_copy</span> Copy</button>
                                </div>
                            </div>
                            <input class="large-key-input cfg-input" type="password" id="cfg_local_llm_api_key" data-key="local_llm.api_key" data-original="{{ config['local_llm.api_key']|default('') }}" value="{{ config['local_llm.api_key']|default('') }}" placeholder="sk-local-..." oninput="onFieldChange(this)">
                        </div>

                        <div class="cfg-row-wide">
                            <div class="cfg-row-wide-header">
                                <div>
                                    <div class="cfg-label">Self-Hosted Local LLM Model Name</div>
                                    <div class="cfg-desc">Enter target model name configured locally (e.g. llama3).</div>
                                    <div class="cfg-key">local_llm.model</div>
                                </div>
                            </div>
                            <input class="large-key-input cfg-input" type="text" id="cfg_local_llm_model" data-key="local_llm.model" data-original="{{ config['local_llm.model']|default('llama3') }}" value="{{ config['local_llm.model']|default('llama3') }}" placeholder="llama3" oninput="onFieldChange(this)">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── TAB 2: Quantitative Trading & Allocation Rules ────────── -->
            <div class="settings-tab-pane" id="tabTradingRules" style="display:none;">
                <!-- Flywheel Signal Thresholds -->
                <div class="cfg-section" id="cfgThresholds">
                    <div class="cfg-section-header">
                        <span class="material-symbols-outlined" style="font-size:22px; color:var(--blue);">analytics</span>
                        <div>
                            <h2>Flywheel Signal Thresholds</h2>
                            <p>Controls when stocks are classified as CALL / PUT / WHEEL signals</p>
                        </div>
                    </div>
                    <div class="cfg-rows">
                        {{ _self.cfgSliderRow('flywheel.signal.call_score_threshold', 'CALL Score Threshold', 'Minimum screener score (0–100) required to generate a bullish CALL signal.', config['flywheel.signal.call_score_threshold']|default(70), 0, 100, 1, 'integer', '') }}
                        {{ _self.cfgSliderRow('flywheel.signal.call_upside_threshold', 'CALL Upside Threshold (%)', 'Minimum % upside to target price required to trigger a CALL signal.', config['flywheel.signal.call_upside_threshold']|default(15.0), 0, 100, 0.5, 'float', '%') }}
                        {{ _self.cfgSliderRow('flywheel.signal.put_score_threshold', 'PUT Score Threshold', 'Stocks scoring below this get a bearish PUT / protective hedge signal.', config['flywheel.signal.put_score_threshold']|default(45), 0, 100, 1, 'integer', '') }}
                        {{ _self.cfgPercentRow('flywheel.signal.call_otm_pct', 'CALL OTM % (Long Call Strike)', 'Out-of-the-money % for the long call strike suggestion.', config['flywheel.signal.call_otm_pct']|default(0.05), 0, 50, 0.5) }}
                        {{ _self.cfgPercentRow('flywheel.signal.put_hedge_otm_pct', 'PUT Hedge OTM %', 'OTM % for protective put hedge strike.', config['flywheel.signal.put_hedge_otm_pct']|default(0.05), 0, 50, 0.5) }}
                        {{ _self.cfgPercentRow('flywheel.signal.csp_discount_pct', 'Cash-Secured Put Discount %', 'How far below current price to place the CSP strike.', config['flywheel.signal.csp_discount_pct']|default(0.08), 0, 50, 0.5) }}
                    </div>
                </div>

                <!-- Capital Allocation Weights -->
                <div class="cfg-section" id="cfgAllocation">
                    <div class="cfg-section-header">
                        <span class="material-symbols-outlined" style="font-size:22px; color:var(--purple);">balance</span>
                        <div>
                            <h2>Capital Allocation Weights</h2>
                            <p>How available risk capital is split between CALL / WHEEL / PUT strategies. Must sum to 1.0 (100%).</p>
                        </div>
                    </div>
                    <div class="cfg-rows">
                        {{ _self.cfgPercentRow('flywheel.allocation.call_weight', 'CALL Weight', 'Fraction of risk capital allocated to long call trades (default: 60%).', config['flywheel.allocation.call_weight']|default(0.60), 0, 100, 1) }}
                        {{ _self.cfgPercentRow('flywheel.allocation.wheel_weight', 'WHEEL (Income) Weight', 'Fraction allocated to cash-secured puts / covered calls (default: 25%).', config['flywheel.allocation.wheel_weight']|default(0.25), 0, 100, 1) }}
                        {{ _self.cfgPercentRow('flywheel.allocation.put_weight', 'PUT (Hedge) Weight', 'Fraction allocated to protective put hedges (default: 15%).', config['flywheel.allocation.put_weight']|default(0.15), 0, 100, 1) }}
                        {{ _self.cfgSliderRow('flywheel.default_risk_cap', 'Default Risk Cap ($)', 'Default total capital to allocate in the flywheel allocator when none is specified.', config['flywheel.default_risk_cap']|default(10000.0), 1000, 200000, 1000, 'float', '$') }}
                    </div>
                </div>
            </div>

            <!-- ── TAB 3: Covered Calls & Exits ──────────────────────────── -->
            <div class="settings-tab-pane" id="tabCoveredCalls" style="display:none;">
                <!-- Covered Call Parameters -->
                <div class="cfg-section" id="cfgCoveredCall">
                    <div class="cfg-section-header">
                        <span class="material-symbols-outlined" style="font-size:22px; color:var(--green);">call</span>
                        <div>
                            <h2>Covered Call Parameters</h2>
                            <p>Strike selection, premium estimation, and DTE target for covered call suggestions</p>
                        </div>
                    </div>
                    <div class="cfg-rows">
                        {{ _self.cfgSliderRow('flywheel.covered_call.min_shares', 'Minimum Unencumbered Shares', 'Minimum number of unencumbered shares required to be eligible for a covered call suggestion (usually 100 per contract).', config['flywheel.covered_call.min_shares']|default(100), 100, 1000, 100, 'integer', ' shares') }}
                        {{ _self.cfgPercentRow('flywheel.covered_call.otm_pct', 'Strike OTM %', 'How far OTM the covered call strike is placed from current price.', config['flywheel.covered_call.otm_pct']|default(0.06), 0, 50, 0.5) }}
                        {{ _self.cfgSliderRow('flywheel.covered_call.cost_basis_buffer', 'Cost Basis Safety Buffer (Multiplier)', 'Strike must be ≥ cost_basis × this multiplier to prevent capital loss on assignment (e.g. 1.02 = 2% above cost basis).', config['flywheel.covered_call.cost_basis_buffer']|default(1.02), 1.0, 1.5, 0.01, 'float', 'x') }}
                        {{ _self.cfgSliderRow('flywheel.covered_call.dte_target', 'DTE Target (Days to Expiry)', 'Target days-to-expiry for covered call suggestions. 30–45 DTE captures optimal theta decay.', config['flywheel.covered_call.dte_target']|default(35), 7, 180, 1, 'integer', ' days') }}
                        {{ _self.cfgPercentRow('flywheel.covered_call.est_premium_pct', 'Estimated Premium %', 'Estimated premium as a % of stock price for the DTE target (e.g. 2.8%).', config['flywheel.covered_call.est_premium_pct']|default(0.028), 0, 20, 0.1) }}
                    </div>
                </div>

                <!-- Early Exit Parameters -->
                <div class="cfg-section" id="cfgEarlyExit">
                    <div class="cfg-section-header">
                        <span class="material-symbols-outlined" style="font-size:22px; color:var(--yellow);">directions_run</span>
                        <div>
                            <h2>Early Exit / Buy-To-Close</h2>
                            <p>When to suggest closing a position early to lock in premium decay profits</p>
                        </div>
                    </div>
                    <div class="cfg-rows">
