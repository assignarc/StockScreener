<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark light">
    <title>{% block title %}Moonshot Screener v3{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <link rel="stylesheet" href="{{ asset('css/screener.css') }}">
    
    <!-- FOUC Theme Prevention Script -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('color-scheme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}

    <script>
        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', nextTheme);
            localStorage.setItem('color-scheme', nextTheme);
            updateThemeToggleButtons(nextTheme);
        }

        function updateThemeToggleButtons(theme) {
            const btns = document.querySelectorAll('.theme-toggle-btn');
            btns.forEach(btn => {
                btn.innerHTML = theme === 'dark' ? '☀️ Light Mode' : '🌙 Dark Mode';
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            updateThemeToggleButtons(currentTheme);
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
