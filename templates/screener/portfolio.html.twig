                        <span class="material-symbols-outlined" style="font-size:18px; color:${badgeFg};">${iconName}</span>
                        <strong style="font-size:15px; font-family:'Outfit',sans-serif; color:var(--text);">${ev.title}</strong>
                        ${(ev.accountBreakdown || []).map(a => `
