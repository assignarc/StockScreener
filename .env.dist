# ==========================================================================
# MOONSHOT SCREENER — ENVIRONMENT VARIABLES DISTRIBUTION TEMPLATE (.env.dist)
#
# This file documents every required env var. Copy to .env.local and fill in
# your values. API credentials (Schwab, Finnhub, Gemini) are managed via the
# Setup Wizard UI and stored in var/data.db — do NOT put them here.
# ==========================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Database connection: SQLite for dev, or MySQL / PostgreSQL for production
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/stock_screener?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> brokerage/security ###
# ══════════════════════════════════════════════════════════════════════════════
# TRADING KILL SWITCH — UNIVERSAL, ENV-ONLY, CANNOT BE OVERRIDDEN BY ANY CODE,
# DATABASE ENTRY, OR AI AGENT. This system is strictly guidance and advice —
# NOT execution. Changing this to true requires a deliberate human action in
# this file. No automated process or API call may change this value.
# ══════════════════════════════════════════════════════════════════════════════
TRADING_ENABLED=false
###< brokerage/security ###

###> schwab/developer-api ###
# OAuth callback URL — must match exactly what is registered in Schwab Developer portal
# https://developer.schwab.com/
SCHWAB_REDIRECT_URI="https://127.0.0.1:8000/api/schwab/callback"
###< schwab/developer-api ###

###> google/gemini-api ###
# Google Gemini Developer API Settings (https://aistudio.google.com/)
# Models: gemini-1.5-flash (default), gemini-2.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models"
###< google/gemini-api ###
